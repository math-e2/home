                <text x="86" y="76" font-size="15" font-weight="bold" fill="#0f2942">O</text>
              </svg>
            </div>

            <!-- B: Hai kim không đối diện nhau -->
            <div class="s1-option-card" id="s1-opt-B" onclick="selectSlide1Option('B')">
