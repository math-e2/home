       + Âm thanh phản hồi (Web Audio API): âm thanh cảnh báo khi sai, âm thanh chúc mừng khi đúng + hiện nút "CÂU TIẾP THEO ▶".
   ============================================================================ */
(function () {
  const SUPABASE_CONFIG = {
    url: 'https://bpnsyvkdotnspwydztpv.supabase.co',
    anonKey: 'sb_publishable_uIF7OUjgvpUOeGC8SUb9WA_EowE6n2l'
