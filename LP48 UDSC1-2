<div id="viewport-wrapper">
  <div id="stage-16-9">

    <!-- ==================== KHUNG NỘI DUNG BẢNG LỚP HỌC ==================== -->
    
    <!-- THANH LUYỆN TẬP CÁ NHÂN CỦA HỌC SINH (CHỈ HIỆN KHI VÀO BẰNG LINK ?room=...) -->
