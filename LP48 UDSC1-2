  /* Điều khiển bằng bàn phím theo đúng yêu cầu:
     - ArrowLeft: Slide trước
     - ArrowRight: Slide tiếp
     - Space: Thực hiện bước tiếp theo của hoạt động
  */
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      changeSlide(-1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      changeSlide(1);
    } else if (e.key === ' ' || e.code === 'Space') {
      e.preventDefault();
      if (currentSlide === 0) {
        handleSlide1MainButton();
      } else if (currentSlide === 1) {
        handleSlide2MainButton();
      } else if (currentSlide === 2) {
        advanceSlide3Step();
      } else if (currentSlide === 3) {
        changeSlide4Step(1);
      } else if (currentSlide >= 4 && currentSlide <= 8) {
        handlePracticeSlideSpace(currentSlide);
      }
    } else if (e.key === 'PageDown') {
      e.preventDefault();
      changeSlide(1);
    } else if (e.key === 'PageUp') {
      e.preventDefault();
      changeSlide(-1);
    }
  });

  /* ==========================================================================
     8. LOGIC HOẠT ĐỘNG CÁ NHÂN – LUYỆN TẬP VỀ TÂM ĐỐI XỨNG (SLIDE 5 ĐẾN SLIDE 9)
     ========================================================================== */

  // -------------------- SLIDE 5 (CÂU 1: 7 HÌNH) --------------------
  const S5_IS_SYM = [true, false, true, true, false, true, true];
  const S5_NAMES  = [
    'a) Hình tròn',
    'b) Chong chóng 3 cánh',
    'c) Chong chóng 4 cánh',
    'Hình 1 (4 cánh)',
    'Hình 2 (5 cánh)',
    'Hình 3 (6 cánh)',
    'Hình 4 (8 cánh)'
  ];
  let s5Selected = [false, false, false, false, false, false, false];
  let s5Checked  = false;
  let s5Rotated  = false;

  function toggleS5Item(idx) {
    s5Selected[idx] = !s5Selected[idx];
    s5Checked = false;
    renderSlide5();
  }

  function rotateS5Shapes() {
    s5Rotated = !s5Rotated;
    slideSteps[4] = Math.max(slideSteps[4], 1);
    renderSlide5();
    const fb = document.getElementById('s5-feedback');
    if (fb) {
