      <section class="slide-view active" id="slide-0">
        <!-- 1. Phần trên: Đề bài đơn giản, chữ lớn -->
        <div class="s1-minimal-header">
          <span class="s1-minimal-tag">NHIỆM VỤ 1</span>
          <span class="s1-minimal-title">"Cho hình sau, đâu là hình đúng khi quay 180° quanh điểm O?"</span>
        </div>

        <!-- 2. Phần giữa: 2 cột cân đối (Trái: Hình ban đầu, Phải: 4 phương án A, B, C, D) -->
        <div class="s1-minimal-middle">
          <!-- Cột Trái: Hình ban đầu -->
          <div class="s1-left-figure-box">
            <svg width="295" height="295" viewBox="0 0 300 300">
              <!-- Hình tròn lớn màu vàng nhạt -->
              <circle cx="150" cy="150" r="118" fill="#fff3b0" stroke="#d97706" stroke-width="4.5" />

              <!-- Mũi tên cong nhỏ biểu thị phép quay 180° -->
              <path d="M 102 68 A 95 95 0 0 1 198 68" fill="none" stroke="#0f2942" stroke-width="3" stroke-dasharray="6,4" opacity="0.75" />
              <polygon points="203,73 199,59 189,68" fill="#0f2942" opacity="0.85" />
              <text x="150" y="50" text-anchor="middle" font-size="15" font-weight="bold" fill="#0f2942">180°</text>

              <!-- Bóng nét đứt vị trí ban đầu để thấy rõ sự chồng khít sau khi quay -->
              <line x1="48" y1="150" x2="252" y2="150" stroke="#991b1b" stroke-width="10" stroke-dasharray="6,5" opacity="0.25" stroke-linecap="round" />

              <!-- Hai kim màu đỏ nằm ngang, hướng về hai phía đối diện, quay quanh O(150, 150) -->
              <g id="s1-rotating-needles">
                <!-- Kim trái -->
                <line x1="150" y1="150" x2="48" y2="150" stroke="#dc2626" stroke-width="10" stroke-linecap="round" />
                <polygon points="36,150 56,139 56,161" fill="#dc2626" />
                <!-- Kim phải -->
                <line x1="150" y1="150" x2="252" y2="150" stroke="#dc2626" stroke-width="10" stroke-linecap="round" />
                <polygon points="264,150 244,139 244,161" fill="#dc2626" />
              </g>

              <!-- Tâm O nằm chính giữa, màu xanh đậm rõ ràng (luôn giữ nguyên vị trí) -->
              <circle cx="150" cy="150" r="9.5" fill="#0f2942" stroke="#ffffff" stroke-width="3" />
              <text x="150" y="182" text-anchor="middle" font-size="22" font-weight="bold" fill="#0f2942">O</text>
            </svg>
            <div id="s1-figure-status" class="s1-figure-status-tag">
              ✓ Điểm O giữ nguyên • Hai kim đổi chỗ & chồng khít vị trí ban đầu
            </div>
          </div>

          <!-- Cột Phải: 4 phương án A, B, C, D theo lưới 2 × 2 -->
          <div class="s1-right-options-box">
