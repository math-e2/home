  /* --------------------------------------------------------------------------
     SLIDE 12 / 13 (NHIỆM VỤ 2 – B): THỰC HÀNH DỰNG ĐIỂM ĐỐI XỨNG
     - Điểm O: cột 4, hàng 3 -> (258, 181)
     - Điểm P: cột 2, hàng 1 -> (154, 77) => Điểm đối xứng Q: cột 6, hàng 5 -> (362, 285)
     - Điểm P': cột 7, hàng 1 -> (414, 77) => Điểm đối xứng Q': cột 1, hàng 5 -> (102, 285)
     -------------------------------------------------------------------------- */
  let s12FoundQ = false;
  let s12FoundQp = false;
  let s12PendingCandidates = []; // Lưu tối đa 2 giao điểm học sinh đang chọn trước khi bấm KIỂM TRA
  let s12GuideStep = 0;
  let s12RafPOQ = null;
  let s12RafPOPQp = null;
  let s12SeqTimer = null;

  // Hiệu ứng vẽ đường nét đứt P(154,77) -> O(258,181) -> Q(362,285) mượt mà xuyên qua tâm O
  function animateS12DashedLinePOQ(animate) {
    const line = document.getElementById('s12-line-poq');
    const ticks = document.getElementById('s12-ticks-poq');
    if (s12RafPOQ) cancelAnimationFrame(s12RafPOQ);
    if (!line) return;

    if (!s12FoundQ && s12GuideStep < 2) {
      line.style.opacity = '0';
      line.setAttribute('x2', '154');
      line.setAttribute('y2', '77');
      if (ticks) ticks.style.opacity = '0';
      return;
    }

    if (!animate) {
      line.style.opacity = '1';
      line.setAttribute('x2', '362');
      line.setAttribute('y2', '285');
      if (ticks) ticks.style.opacity = '1';
      return;
    }

    line.style.opacity = '1';
    line.setAttribute('x2', '154');
    line.setAttribute('y2', '77');
    if (ticks) ticks.style.opacity = '0';

    const startX = 154, startY = 77;
    const endX = 362, endY = 285;
    const duration = 750;
    const startTime = performance.now();

    function stepFrame(now) {
      const t = Math.min(1, (now - startTime) / duration);
      const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      const curX = startX + (endX - startX) * ease;
      const curY = startY + (endY - startY) * ease;
      line.setAttribute('x2', curX.toFixed(1));
      line.setAttribute('y2', curY.toFixed(1));
      if (t < 1) {
        s12RafPOQ = requestAnimationFrame(stepFrame);
      } else {
        if (ticks && (s12FoundQ || s12GuideStep >= 2)) {
          ticks.style.opacity = '1';
        }
      }
    }
    s12RafPOQ = requestAnimationFrame(stepFrame);
  }

  // Hiệu ứng vẽ đường nét đứt P'(414,77) -> O(258,181) -> Q'(102,285) mượt mà xuyên qua tâm O
  function animateS12DashedLinePOPQp(animate) {
    const line = document.getElementById('s12-line-popqp');
    const ticks = document.getElementById('s12-ticks-popqp');
    if (s12RafPOPQp) cancelAnimationFrame(s12RafPOPQp);
    if (!line) return;

    if (!s12FoundQp && s12GuideStep < 3) {
      line.style.opacity = '0';
      line.setAttribute('x2', '414');
      line.setAttribute('y2', '77');
      if (ticks) ticks.style.opacity = '0';
      return;
    }

    if (!animate) {
      line.style.opacity = '1';
      line.setAttribute('x2', '102');
      line.setAttribute('y2', '285');
      if (ticks) ticks.style.opacity = '1';
      return;
    }

    line.style.opacity = '1';
    line.setAttribute('x2', '414');
    line.setAttribute('y2', '77');
    if (ticks) ticks.style.opacity = '0';

    const startX = 414, startY = 77;
    const endX = 102, endY = 285;
    const duration = 800;
    const startTime = performance.now();

    function stepFrame(now) {
      const t = Math.min(1, (now - startTime) / duration);
      const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      const curX = startX + (endX - startX) * ease;
      const curY = startY + (endY - startY) * ease;
      line.setAttribute('x2', curX.toFixed(1));
      line.setAttribute('y2', curY.toFixed(1));
      if (t < 1) {
        s12RafPOPQp = requestAnimationFrame(stepFrame);
      } else {
        if (ticks && (s12FoundQp || s12GuideStep >= 3)) {
          ticks.style.opacity = '1';
        }
      }
    }
    s12RafPOPQp = requestAnimationFrame(stepFrame);
  }

  function updateS12CandidateMarkers() {
    const m1 = document.getElementById('s12-candidate-marker');
    const m2 = document.getElementById('s12-candidate-marker-2');
    if (m1) {
      if (s12PendingCandidates.length >= 1) {
        const pt1 = s12PendingCandidates[0];
        const x1 = 50 + pt1.c * 52;
        const y1 = 25 + pt1.r * 52;
        m1.style.display = 'block';
        document.getElementById('s12-cand-pulse')?.setAttribute('cx', x1);
        document.getElementById('s12-cand-pulse')?.setAttribute('cy', y1);
        document.getElementById('s12-cand-dot')?.setAttribute('cx', x1);
        document.getElementById('s12-cand-dot')?.setAttribute('cy', y1);
        const l1 = document.getElementById('s12-cand-label');
        if (l1) {
          l1.setAttribute('x', x1);
          l1.setAttribute('y', y1 - 16);
          l1.textContent = (!s12FoundQ && !s12FoundQp && s12PendingCandidates.length > 1) ? 'Điểm chọn 1' : 'Điểm chọn';
        }
      } else {
        m1.style.display = 'none';
      }
    }
    if (m2) {
      if (s12PendingCandidates.length >= 2) {
        const pt2 = s12PendingCandidates[1];
        const x2 = 50 + pt2.c * 52;
        const y2 = 25 + pt2.r * 52;
        m2.style.display = 'block';
        document.getElementById('s12-cand2-pulse')?.setAttribute('cx', x2);
        document.getElementById('s12-cand2-pulse')?.setAttribute('cy', y2);
        document.getElementById('s12-cand2-dot')?.setAttribute('cx', x2);
        document.getElementById('s12-cand2-dot')?.setAttribute('cy', y2);
        const l2 = document.getElementById('s12-cand2-label');
        if (l2) {
          l2.setAttribute('x', x2);
          l2.setAttribute('y', y2 - 16);
          l2.textContent = 'Điểm chọn 2';
        }
      } else {
        m2.style.display = 'none';
      }
    }
  }

  function handleS12GridClick(c, r) {
    if (s12FoundQ && s12FoundQp) return;
    // Bỏ qua nếu nhấp lại đúng điểm Q hoặc Q' đã được xác nhận
    if (s12FoundQ && c === 6 && r === 5) return;
    if (s12FoundQp && c === 1 && r === 5) return;

    const existingIdx = s12PendingCandidates.findIndex(p => p.c === c && p.r === r);
    const maxNeeded = (s12FoundQ || s12FoundQp) ? 1 : 2;

    if (existingIdx !== -1) {
      // Nhấp lại vào điểm đang chọn để bỏ chọn
      s12PendingCandidates.splice(existingIdx, 1);
    } else {
      if (s12PendingCandidates.length >= maxNeeded) {
        s12PendingCandidates.shift();
      }
      s12PendingCandidates.push({ c, r });
    }

    updateS12CandidateMarkers();

    const fb = document.getElementById('s12-feedback-box');
    if (fb) {
      if (s12PendingCandidates.length > 0) {
        fb.className = 'nv2-feedback-banner shown fb-hint';
        fb.innerHTML = `📍 Đã chọn ${s12PendingCandidates.length} giao điểm trên lưới. Hãy nhấn nút <b>KIỂM TRA</b> để xác nhận kết quả và vẽ đường đối xứng qua tâm O!`;
      } else {
        fb.className = 'nv2-feedback-banner';
        fb.textContent = '';
      }
    }
  }

  function checkS12Candidate() {
    const fb = document.getElementById('s12-feedback-box');
    clearTimeout(s12SeqTimer);

    // Nếu cả 2 điểm Q và Q' đã hoàn thành, nhấn KIỂM TRA sẽ chạy lại hiệu ứng vẽ lần lượt 2 đường nét đứt P–O–Q và P'–O–Q'
    if (s12FoundQ && s12FoundQp) {
      animateS12DashedLinePOQ(true);
      const line2 = document.getElementById('s12-line-popqp');
      const ticks2 = document.getElementById('s12-ticks-popqp');
      if (line2) line2.style.opacity = '0';
      if (ticks2) ticks2.style.opacity = '0';
      s12SeqTimer = setTimeout(() => {
        animateS12DashedLinePOPQp(true);
      }, 820);
      if (fb) {
        fb.className = 'nv2-feedback-banner shown fb-ok';
        fb.textContent = '✓ Chính xác! Hai đường nét đứt P–O–Q và P’–O–Q’ đi xuyên qua tâm O (OP = OQ và OP’ = OQ’).';
      }
      return;
    }

    if (s12PendingCandidates.length === 0) {
      if (fb) {
        fb.className = 'nv2-feedback-banner shown fb-hint';
        fb.innerHTML = '⚠️ Em hãy nhấp chọn giao điểm trên lưới ô vuông trước khi nhấn <b>KIỂM TRA</b>!';
      }
      return;
    }

    let hitQ = false;
    let hitQp = false;
    let remainingWrong = [];

    s12PendingCandidates.forEach(pt => {
      if (!s12FoundQ && pt.c === 6 && pt.r === 5) {
        hitQ = true;
      } else if (!s12FoundQp && pt.c === 1 && pt.r === 5) {
        hitQp = true;
      } else {
        remainingWrong.push(pt);
      }
    });

    if (hitQ && hitQp) {
      // Học sinh chọn đúng cả 2 điểm Q và Q' cùng lúc -> Lần lượt vẽ đường nét đứt P–O–Q rồi đến P'–O–Q'
      s12FoundQ = true;
      s12FoundQp = true;
      s12PendingCandidates = [];
      updateS12CandidateMarkers();
      renderS12();

      animateS12DashedLinePOQ(true);
      const line2 = document.getElementById('s12-line-popqp');
      const ticks2 = document.getElementById('s12-ticks-popqp');
      if (line2) line2.style.opacity = '0';
      if (ticks2) ticks2.style.opacity = '0';

      s12SeqTimer = setTimeout(() => {
        animateS12DashedLinePOPQp(true);
      }, 820);

      if (fb) {
        fb.className = 'nv2-feedback-banner shown fb-ok';
        fb.textContent = '“Chính xác! P, O, Q thẳng hàng (OP = OQ) và P’, O, Q’ thẳng hàng (OP’ = OQ’).”';
      }
    } else if (hitQ) {
      s12FoundQ = true;
      s12PendingCandidates = [];
      updateS12CandidateMarkers();
      renderS12();
      animateS12DashedLinePOQ(true);
      if (fb) {
        fb.className = 'nv2-feedback-banner shown fb-ok';
        fb.textContent = s12FoundQp
          ? '“Chính xác! P, O, Q thẳng hàng (OP = OQ) và P’, O, Q’ thẳng hàng (OP’ = OQ’).”'
          : '“Chính xác! P, O, Q thẳng hàng và OP = OQ.” Hãy tiếp tục chọn điểm đối xứng Q’ của P’ rồi nhấn KIỂM TRA!';
      }
    } else if (hitQp) {
      s12FoundQp = true;
      s12PendingCandidates = [];
      updateS12CandidateMarkers();
      renderS12();
      animateS12DashedLinePOPQp(true);
      if (fb) {
        fb.className = 'nv2-feedback-banner shown fb-ok';
        fb.textContent = s12FoundQ
          ? '“Chính xác! P, O, Q thẳng hàng (OP = OQ) và P’, O, Q’ thẳng hàng (OP’ = OQ’).”'
          : '“Chính xác! P’, O, Q’ thẳng hàng và OP’ = OQ’.” Hãy tiếp tục chọn điểm đối xứng Q của P rồi nhấn KIỂM TRA!';
      }
    } else {
      // Chọn sai: Không vẽ đường nét đứt, không lộ đáp án đúng, cho phép học sinh nhấp chọn lại
      if (fb) {
        fb.className = 'nv2-feedback-banner shown fb-err';
        fb.textContent = '“Chưa chính xác! Em hãy kiểm tra lại hướng và khoảng cách từ O.”';
      }
    }
  }

  function advanceS12GuideStep() {
    clearTimeout(s12SeqTimer);
    if (s12GuideStep < 4) {
      s12GuideStep++;
      if (s12GuideStep === 2 && !s12FoundQ) {
        renderS12();
        animateS12DashedLinePOQ(true);
        return;
      }
      if (s12GuideStep === 3 && !s12FoundQp) {
        renderS12();
        animateS12DashedLinePOPQp(true);
        return;
      }
      if (s12GuideStep === 4) {
        const needAnimQ = !s12FoundQ && s12GuideStep < 2;
        const needAnimQp = !s12FoundQp && s12GuideStep < 3;
        s12FoundQ = true;
        s12FoundQp = true;
        s12PendingCandidates = [];
        updateS12CandidateMarkers();
        renderS12();
        animateS12DashedLinePOQ(needAnimQ);
        animateS12DashedLinePOPQp(needAnimQp);
        return;
      }
      renderS12();
    }
  }

  function resetS12Slide() {
