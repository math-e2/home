      } else {
        fb.className = 'hdcn-feedback-box fb-warn';
        fb.innerHTML = '💡 <b>Kết quả kiểm chứng bằng phép quay 180°:</b> Những hình trùng khít hoàn toàn khi quay 180° quanh tâm O là <b>Hình c, Hình e, Hình g</b>. Hãy bấm <b>QUAY 180°</b> để quan sát rõ!';
