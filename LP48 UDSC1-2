    // Chèn nút "📤 NỘP CÂU N" và khung phản hồi riêng cho từng slide luyện tập ở chế độ Học sinh
    injectStudentQuestionControls() {
      const mapping = [
        { slideNum: 5, qNum: 1, pts: 1.5, secId: 'slide-4', nextSlideNum: 6 },
        { slideNum: 6, qNum: 2, pts: 2.5, secId: 'slide-5', nextSlideNum: 7 },
        { slideNum: 7, qNum: 3, pts: 2.0, secId: 'slide-6', nextSlideNum: 8 },
        { slideNum: 8, qNum: 4, pts: 1.5, secId: 'slide-7', nextSlideNum: 9 },
        { slideNum: 9, qNum: 5, pts: 2.5, secId: 'slide-8', nextSlideNum: null },
        { slideNum: 14, qNum: 1, pts: 4.0, secId: 'slide-btlt-1', nextSlideNum: 15 },
        { slideNum: 15, qNum: 2, pts: 3.0, secId: 'slide-btlt-2', nextSlideNum: 16 },
        { slideNum: 16, qNum: 3, pts: 3.0, secId: 'slide-btlt-3', nextSlideNum: null }
      ];

      mapping.forEach(item => {
        const sec = document.getElementById(item.secId);
        if (!sec) return;
        const bar = sec.querySelector('.hdcn-action-btns') || sec.querySelector('.nv2-btn-group');
        if (!bar) return;

        // Chèn nút "Nộp Câu N" vào đầu thanh nút chức năng
        const subBtn = document.createElement('button');
        subBtn.type = 'button';
        subBtn.className = 'rt-st-question-submit-btn';
        subBtn.id = `rt-q-submit-btn-${item.slideNum}`;
        subBtn.innerHTML = `📤 NỘP CÂU ${item.qNum} (${item.pts}đ)`;
        subBtn.onclick = () => this.submitCurrentQuestion(item.slideNum);
        bar.insertBefore(subBtn, bar.firstChild);

        // Chỉnh nút "CÂU TIẾP THEO ▶" để chỉ mở khóa khi câu này đã nộp đúng 100%
        const nextBtn = sec.querySelector('.hdcn-btn-next');
        if (nextBtn) {
          nextBtn.id = `rt-q-next-btn-${item.slideNum}`;
          if (item.nextSlideNum) {
            nextBtn.textContent = 'CÂU TIẾP THEO ▶';
            nextBtn.onclick = () => window.goToSlide(item.nextSlideNum - 1);
          } else {
            // Câu cuối cùng của nhóm: bấm để hoàn tất & nộp toàn bộ bài
            nextBtn.textContent = '🏁 HOÀN THÀNH BÀI';
            nextBtn.onclick = () => this.submitStudentWork(true);
          }
        }

        // Thêm khung hiển thị phản hồi Đúng / Sai ngay trên thanh điều khiển của slide
        const bottomBar = sec.querySelector('.hdcn-bottom-bar') || sec.querySelector('.nv2-footer-bar');
        if (bottomBar && !document.getElementById(`rt-q-fb-${item.slideNum}`)) {
          const fb = document.createElement('div');
          fb.id = `rt-q-fb-${item.slideNum}`;
          fb.className = 'rt-st-q-feedback';
          bottomBar.parentNode.insertBefore(fb, bottomBar);
