    if (pill) pill.textContent = s9Rotated ? 'Góc quay: 180°' : 'Góc quay: 0°';

    for (let i = 0; i < 8; i++) {
      const card = document.getElementById(`s9-card-${i}`);
      const chk = document.getElementById(`s9-chk-${i}`);
      const badge = document.getElementById(`s9-badge-${i}`);
      const rotEl = document.getElementById(`s9-rot-${i}`);
      const ghostEl = document.getElementById(`s9-ghost-${i}`);
      const oEl = document.getElementById(`s9-o-${i}`);

      if (!card) continue;
      card.classList.remove('selected-item', 'checked-sym', 'checked-nonsym');
      if (s9Selected[i]) card.classList.add('selected-item');
      if (chk) chk.textContent = s9Selected[i] ? '✓' : '';

      if (rotEl) rotEl.style.transform = s9Rotated ? 'rotate(180deg)' : 'rotate(0deg)';
      if (ghostEl) ghostEl.classList.toggle('visible', s9Rotated);

      if (s9Checked) {
        if (S9_IS_SYM[i]) {
          card.classList.add('checked-sym');
          if (badge) {
            badge.className = 'hdcn-status-badge show-sym';
            badge.textContent = '✓ Có tâm O';
          }
          if (oEl) oEl.classList.add('visible');
        } else {
          card.classList.add('checked-nonsym');
          if (badge) {
            badge.className = 'hdcn-status-badge show-nonsym';
            badge.textContent = '✗ Không có';
          }
          if (oEl) oEl.classList.remove('visible');
        }
      } else {
        if (badge) {
          badge.className = 'hdcn-status-badge';
          badge.textContent = '';
        }
        if (oEl) oEl.classList.remove('visible');
      }
    }
  }

  // Điều khiển tiến trình bằng phím Space cho các Slide 5..9:
  // Lần 1: Quay 180° kiểm chứng -> Lần 2: Kiểm tra (nếu đã chọn) hoặc Hiện đáp án -> Lần 3: Hiện đáp án đầy đủ
  function handlePracticeSlideSpace(slideIdx) {
    if (slideIdx === 4) {
      if (!s5Rotated) rotateS5Shapes();
      else if (!s5Checked && s5Selected.some(Boolean)) checkS5Answer();
      else showS5Answer();
    } else if (slideIdx === 5) {
      if (!s6Checked) checkS6Answer();
      else if (!s6Rotated) rotateS6Shapes();
      else showS6Answer();
    } else if (slideIdx === 6) {
      if (!s7Rotated) rotateS7Shapes();
      else if (!s7Checked && s7Selected.some(Boolean)) checkS7Answer();
      else showS7Answer();
    } else if (slideIdx === 7) {
      if (!s8Rotated) rotateS8Shapes();
      else if (!s8Checked && s8Selected.some(Boolean)) checkS8Answer();
      else showS8Answer();
    } else if (slideIdx === 8) {
      if (!s9Rotated) rotateS9Shapes();
      else if (!s9Checked && s9Selected.some(Boolean)) checkS9Answer();
      else showS9Answer();
    }
  }


  /* ==========================================================================
     9. KHÔI PHỤC HOÀN CHỈNH CHỨC NĂNG SLIDE 10, 11, 12, 13 (NHIỆM VỤ 2)
     ========================================================================== */

  // Mở rộng mảng quản lý bước cho đủ 13 Slide (chỉ số 0..12)
  MAX_STEPS_PER_SLIDE.splice(0, MAX_STEPS_PER_SLIDE.length, 3, 16, 13, 19, 3, 3, 3, 3, 3, 4, 4, 4, 5);
  while (slideSteps.length < 13) {
    slideSteps.push(0);
  }

  // Khởi tạo hệ lưới ô vuông SVG sắc nét cho các slide Nhiệm vụ 2 (nếu cần vẽ lại)
  function buildSvgGridsNV2() {
    document.querySelectorAll('.js-grid-8x6').forEach(g => {
      if (g.children.length > 0) return;
      let html = '';
      for (let c = 0; c <= 8; c++) {
        const x = 50 + c * 52;
        const st = (c === 4) ? 'rgba(255,255,255,0.28)' : 'rgba(255,255,255,0.18)';
        const sw = (c === 4) ? '1.8' : '1.3';
        html += `<line x1="${x}" y1="25" x2="${x}" y2="337" stroke="${st}" stroke-width="${sw}" />`;
      }
      for (let r = 0; r <= 6; r++) {
        const y = 25 + r * 52;
        const st = (r === 3) ? 'rgba(255,255,255,0.28)' : 'rgba(255,255,255,0.18)';
        const sw = (r === 3) ? '1.8' : '1.3';
        html += `<line x1="50" y1="${y}" x2="466" y2="${y}" stroke="${st}" stroke-width="${sw}" />`;
      }
      g.innerHTML = html;
    });

    const gB = document.getElementById('s12-grid-layer');
    if (gB && gB.children.length === 0) {
      let html = '';
      for (let c = 0; c <= 8; c++) {
        const x = 50 + c * 52;
        const st = (c === 4) ? 'rgba(255,255,255,0.28)' : 'rgba(255,255,255,0.18)';
        html += `<line x1="${x}" y1="25" x2="${x}" y2="337" stroke="${st}" stroke-width="1.4" />`;
      }
      for (let r = 0; r <= 6; r++) {
        const y = 25 + r * 52;
        const st = (r === 3) ? 'rgba(255,255,255,0.28)' : 'rgba(255,255,255,0.18)';
        html += `<line x1="50" y1="${y}" x2="466" y2="${y}" stroke="${st}" stroke-width="1.4" />`;
      }
      for (let c = 0; c <= 8; c++) {
        for (let r = 0; r <= 6; r++) {
          const x = 50 + c * 52;
          const y = 25 + r * 52;
          html += `<circle class="nv2-grid-node" id="nv2-b-node-${c}-${r}" cx="${x}" cy="${y}" r="5.5" onclick="handleS12GridClick(${c}, ${r})" />`;
        }
      }
      gB.innerHTML = html;
    }

    document.querySelectorAll('.js-mini-grid-8x6').forEach(g => {
      if (g.children.length > 0) return;
      let html = '';
      for (let c = 0; c <= 8; c++) {
        const x = 35 + c * 32;
        html += `<line x1="${x}" y1="14" x2="${x}" y2="206" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" />`;
      }
      for (let r = 0; r <= 6; r++) {
        const y = 14 + r * 32;
        html += `<line x1="35" y1="${y}" x2="291" y2="${y}" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" />`;
      }
      g.innerHTML = html;
    });
  }

  /* --------------------------------------------------------------------------
     SLIDE 10 / 13 (NHIỆM VỤ 2 – A): DẪN DẮT ĐỀ BÀI THEO 4 LẦN NHẤP CHUỘT
     - Bước 0 (Ban đầu): Hiển thị câu hỏi “Đề bài cho biết gì?”
     - Bước 1 (Nhấp lần 1): Ẩn câu hỏi cũ, hiện “Cho đoạn thẳng AB và điểm O như hình vẽ.” + làm nổi bật hình minh họa.
     - Bước 2 (Nhấp lần 2): Ẩn nội dung bước 1, hiện câu hỏi “Bài toán yêu cầu chúng ta làm gì?”
     - Bước 3 (Nhấp lần 3): Ẩn câu hỏi, hiện yêu cầu “Vẽ thêm phần còn lại qua tâm O sao cho O là tâm đối xứng của hình.”
     - Bước 4 (Nhấp lần 4): Ẩn toàn bộ câu hỏi và giải thích, phóng to hình lưới & đoạn AB ở chính giữa + hiện dòng chữ lớn “EM HÃY TỰ THỰC HIỆN NHÉ!”
     -------------------------------------------------------------------------- */
  let s10Step = 0; // 0..4

  function changeS10Step(delta) {
    const nextVal = Math.max(0, Math.min(4, s10Step + delta));
    if (nextVal === s10Step) return;
    s10Step = nextVal;
    slideSteps[9] = s10Step;
    renderS10();
  }

  function advanceS10Step(e) {
    if (e && e.stopPropagation) {
      e.stopPropagation();
    }
    if (s10Step < 4) {
      s10Step++;
      slideSteps[9] = s10Step;
      renderS10();
    }
  }

  function resetS10Slide(e) {
    if (e && e.stopPropagation) {
      e.stopPropagation();
    }
    s10Step = 0;
    slideSteps[9] = 0;
    renderS10();
  }

  function renderS10() {
    const stage = document.getElementById('s10-stage');
    const canvasCard = document.getElementById('s10-canvas-card');
    const qBox = document.getElementById('s10-question-box');
    const aBox = document.getElementById('s10-answer-box');
    const banner = document.getElementById('s10-action-banner');
    const nextBtn = document.getElementById('s10-btn-next');

    if (!stage || !canvasCard || !qBox || !aBox) return;

    if (banner) {
      banner.textContent = '✨ EM HÃY TỰ THỰC HIỆN NHÉ!';
    }

    // Bước 4: Ẩn toàn bộ vùng câu hỏi bên phải, phóng to mượt mà hình lưới về chính giữa
    stage.classList.toggle('zoomed-center', s10Step === 4);

    // Làm nổi bật hình minh họa từ Bước 1 trở đi
    canvasCard.classList.toggle('dimmed', s10Step === 0);
    canvasCard.classList.toggle('highlighted', s10Step >= 1 && s10Step < 4);

    // Hiển thị tuần tự đúng trình tự từng bước (không hiển thị chồng chéo câu hỏi và đáp án)
    if (s10Step === 0) {
      qBox.style.display = 'block';
      qBox.textContent = '“Đề bài cho biết gì?”';
      aBox.classList.remove('shown');
      aBox.style.display = 'none';
    } else if (s10Step === 1) {
      qBox.style.display = 'none';
      aBox.textContent = '“Cho đoạn thẳng AB và điểm O như hình vẽ.”';
      aBox.classList.add('shown');
      aBox.style.display = 'block';
    } else if (s10Step === 2) {
      qBox.style.display = 'block';
      qBox.textContent = '“Bài toán yêu cầu chúng ta làm gì?”';
      aBox.classList.remove('shown');
      aBox.style.display = 'none';
    } else if (s10Step === 3) {
      qBox.style.display = 'none';
      aBox.textContent = '“Vẽ thêm phần còn lại qua tâm O sao cho O là tâm đối xứng của hình.”';
      aBox.classList.add('shown');
      aBox.style.display = 'block';
    } else if (s10Step === 4) {
      qBox.style.display = 'none';
      aBox.classList.remove('shown');
      aBox.style.display = 'none';
    }

    if (nextBtn) {
      nextBtn.disabled = (s10Step >= 4);
      nextBtn.textContent = (s10Step >= 4) ? '✓ Đã hoàn thành dẫn dắt' : '⏭ Bước tiếp theo';
    }
  }

  /* --------------------------------------------------------------------------
     SLIDE 11 / 13 (NHIỆM VỤ 2 – A): HƯỚNG DẪN CÁCH VẼ (4 BƯỚC TUẦN TỰ)
