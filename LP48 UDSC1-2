    btlt1Timers.push(setTimeout(() => {
      document.getElementById('btlt1-conclusion')?.classList.add('shown');
      btlt1SetFeedback('Lời giải: (1,0) ↔ (3,4); (1,1) ↔ (3,3); (3,0) ↔ (1,4); (3,1) ↔ (1,3).', 'ok');
    }, 2150));
  }

