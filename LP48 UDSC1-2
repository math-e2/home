              <span class="s1-option-badge">C</span>
              <svg width="132" height="132" viewBox="0 0 140 140">
                <circle cx="70" cy="70" r="56" fill="#fff3b0" stroke="#d97706" stroke-width="3.5" />
                <line x1="22" y1="70" x2="118" y2="70" stroke="#dc2626" stroke-width="7" stroke-linecap="round" />
