  function setQABox(prefix, modeClass, badgeText, mainText) {
    const box = document.getElementById(`${prefix}-qa-box`);
    const badge = document.getElementById(`${prefix}-qa-badge`);
    const text = document.getElementById(`${prefix}-qa-text`);
    if (!box || !badge || !text) return;
    box.className = `qa-box ${modeClass}`;
    badge.textContent = badgeText;
    text.textContent = mainText;
  }

  function pauseAt90CurrentSlide() {
    if (currentSlide === 2 && !s3SummaryMode) {
      const rotEl = document.getElementById(`s3-rot-${s3CurrentAct}`);
      if (rotEl) rotEl.style.transform = 'rotate(90deg)';
      document.getElementById('s3-angle-indicator').textContent = 'Góc quay: 90° (Chưa trùng khít)';
    }
  }

