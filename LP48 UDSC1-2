  let s3PredChoice = [null, null, null, null];
  let s3SummaryMode = false;
  let s3SummaryTimers = [];

  // Quản lý timer hiệu ứng xuất hiện tuần tự cho khung Kết luận lớn ở Slide 2
  let slide2ConclusionTimers = [];
  let slide2IsTransitioningToConclusion = false;

  // Trạng thái riêng của Slide 1 (Tích hợp vào 1 nút hành động duy nhất)
  // slide1SubState:
  // 0: Giai đoạn 1 - Nút hiển thị "EM HÃY THỬ DỰ ĐOÁN NHÉ!"
  // 1: Giai đoạn 2 - Nút hiển thị "KIỂM CHỨNG: QUAY 180°"
  // 2: Đang thực hiện animation quay 180° quanh tâm O
  // 3: Giai đoạn 3 - Quay xong, hiển thị chồng khít, nút đổi thành "XEM KẾT LUẬN"
  // 4: Đã nhấp "XEM KẾT LUẬN" - Hiển thị hộp kết luận về tâm đối xứng & đánh dấu đáp án C màu xanh lá
  let slide1SelectedOption = null;
  let slide1AnimTimer = null;
  let slide1SubState = 0;

  /* --------------------------------------------------------------------------
     1. TỰ ĐỘNG CO GIÃN KHUNG 16:9 VỪA KHÍT MÀN HÌNH (ZERO OVERFLOW)
     -------------------------------------------------------------------------- */
  function fitStageToScreen() {
    const stage = document.getElementById('stage-16-9');
    if (!stage) return;
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const targetW = 1440;
    const targetH = 810;
    const scale = Math.min((vw - 16) / targetW, (vh - 16) / targetH);
    stage.style.transform = `scale(${Math.max(0.2, scale)})`;
  }
  window.addEventListener('resize', fitStageToScreen);
  window.addEventListener('load', () => {
    fitStageToScreen();
    renderAll();
  });

  /* --------------------------------------------------------------------------
     2. ĐIỀU HƯỚNG SLIDE & BƯỚC
     -------------------------------------------------------------------------- */
  function goToSlide(index) {
    if (index < 0 || index >= TOTAL_SLIDES) return;
    currentSlide = index;
    toggleHintModal(false);
    renderAll();
  }

  function changeSlide(delta) {
    goToSlide(currentSlide + delta);
  }

  function changeStep(delta) {
    if (currentSlide === 0) {
      if (delta > 0) {
        handleSlide1MainButton();
      } else if (delta < 0) {
        clearTimeout(slide1AnimTimer);
        if (slide1SubState === 4) {
          slide1SubState = 3;
          slideSteps[0] = 2;
        } else if (slide1SubState >= 2) {
          slide1SubState = 1;
          slideSteps[0] = 1;
        } else {
          slide1SubState = 0;
          slideSteps[0] = 0;
        }
        renderAll();
      }
      return;
    }

    if (currentSlide === 1) {
      const maxS = MAX_STEPS_PER_SLIDE[1];
      const nextS = slideSteps[1] + delta;
      if (nextS < 0 || nextS > maxS) return;
      if (nextS === 16 && delta > 0) {
        transitionToSlide2GrandConclusion();
        return;
      }
      clearSlide2ConclusionTimers();
      slide2IsTransitioningToConclusion = false;
      slideSteps[1] = nextS;
      renderAll();
      if (slideSteps[1] === 11 && delta > 0) {
        triggerSlide2Summary180Replay();
      }
      return;
    }

    if (currentSlide === 2) {
      if (delta > 0) {
        advanceSlide3Step();
      } else if (delta < 0) {
        stepBackSlide3();
      }
      return;
    }

    if (currentSlide === 3) {
      changeSlide4Step(delta);
      return;
    }

    if (currentSlide >= 4 && currentSlide <= 8) {
      if (delta > 0) {
        handlePracticeSlideSpace(currentSlide);
      } else if (delta < 0) {
        resetCurrentSlide();
      }
      return;
    }

    const maxS = MAX_STEPS_PER_SLIDE[currentSlide];
    const nextS = slideSteps[currentSlide] + delta;
    if (nextS < 0 || nextS > maxS) return;
    slideSteps[currentSlide] = nextS;
    toggleHintModal(false);
    renderAll();
  }

  function jumpToConclusion() {
    toggleHintModal(false);
    if (currentSlide === 0) {
      clearTimeout(slide1AnimTimer);
      slideSteps[0] = 3;
      slide1SubState = 4;
      renderAll();
      return;
    }
    if (currentSlide === 1) {
      transitionToSlide2GrandConclusion();
      return;
    }
    if (currentSlide === 2) {
      openSlide3SummaryTable();
      return;
    }
    if (currentSlide === 3) {
      slideSteps[3] = MAX_STEPS_PER_SLIDE[3];
      renderSlide4Summary();
      triggerSlide4FinalRotation();
      return;
    }
    if (currentSlide === 4) { showS5Answer(); return; }
    if (currentSlide === 5) { showS6Answer(); return; }
    if (currentSlide === 6) { showS7Answer(); return; }
    if (currentSlide === 7) { showS8Answer(); return; }
    if (currentSlide === 8) { showS9Answer(); return; }
    slideSteps[currentSlide] = MAX_STEPS_PER_SLIDE[currentSlide];
    renderAll();
  }

  function resetCurrentSlide() {
    slideSteps[currentSlide] = 0;
    toggleHintModal(false);
    if (currentSlide === 0) {
      clearTimeout(slide1AnimTimer);
      slide1SelectedOption = null;
      slide1SubState = 0;
      const needles = document.getElementById('s1-rotating-needles');
      if (needles) {
        needles.style.transition = 'none';
        needles.style.transform = 'rotate(0deg)';
        setTimeout(() => {
          needles.style.transition = 'transform 1.45s cubic-bezier(0.4, 0.0, 0.2, 1)';
        }, 40);
      }
    }
    if (currentSlide === 1) {
      resetSlide2ToInitialExplore();
      return;
    }
    if (currentSlide === 2) {
      resetAllSlide3Activities();
      return;
    }
    if (currentSlide === 3) {
      resetSlide4Summary();
      return;
    }
    if (currentSlide === 4) { resetS5Slide(); return; }
    if (currentSlide === 5) { resetS6Slide(); return; }
    if (currentSlide === 6) { resetS7Slide(); return; }
    if (currentSlide === 7) { resetS8Slide(); return; }
    if (currentSlide === 8) { resetS9Slide(); return; }
    renderAll();
  }

  /* --------------------------------------------------------------------------
     3. HÀM CẬP NHẬT GIAO DIỆN CHUNG
     -------------------------------------------------------------------------- */
  function renderAll() {
    // Hiển thị Slide đang chọn
    document.querySelectorAll('.slide-view').forEach((sec, idx) => {
      sec.classList.toggle('active', idx === currentSlide);
    });

    const step = slideSteps[currentSlide];
    const maxStep = MAX_STEPS_PER_SLIDE[currentSlide];

    // Cập nhật chỉ số Slide và trạng thái nút Slide trước / Slide tiếp
    document.getElementById('slide-indicator').textContent = `Slide ${currentSlide + 1} / ${TOTAL_SLIDES}`;
    document.getElementById('btn-prev-slide').disabled = (currentSlide === 0);
    document.getElementById('btn-next-slide').disabled = (currentSlide === TOTAL_SLIDES - 1);

    // Thanh điều hướng phía dưới gọn gàng ở cả 4 Slide
    const toolbar = document.getElementById('bottom-toolbar');
    const stepGroup = document.getElementById('step-control-group');
    const extraGroup = document.getElementById('extra-tools-group');
    const isMinimalNavSlide = (currentSlide >= 0 && currentSlide <= 16);

    toolbar.classList.toggle('slide1-minimal-nav', isMinimalNavSlide);
    stepGroup.style.display = isMinimalNavSlide ? 'none' : 'flex';
    extraGroup.style.display = isMinimalNavSlide ? 'none' : 'flex';

    // Gọi hàm render chi tiết của từng Slide
    if (currentSlide === 0) renderSlide1();
    else if (currentSlide === 1) renderSlide2(step);
    else if (currentSlide === 2) renderSlide3Explore();
    else if (currentSlide === 3) renderSlide4Summary();
    else if (currentSlide === 4) renderSlide5();
    else if (currentSlide === 5) renderSlide6();
    else if (currentSlide === 6) renderSlide7();
    else if (currentSlide === 7) renderSlide8();
    else if (currentSlide === 8) renderSlide9();
  }

  /* --------------------------------------------------------------------------
     4. LOGIC SLIDE 1: 1 NÚT HÀNH ĐỘNG DUY NHẤT THEO TIẾN TRÌNH
     -------------------------------------------------------------------------- */
  function selectSlide1Option(letter) {
    if (slide1SubState === 4) return;
    slide1SelectedOption = letter;
    renderSlide1Options();
  }

  function renderSlide1Options() {
    ['A', 'B', 'C', 'D'].forEach(opt => {
      const card = document.getElementById(`s1-opt-${opt}`);
      if (!card) return;
      card.classList.remove('selected-blue', 'correct-green', 'neutral-dim');

      if (slide1SubState === 4) {
        if (opt === 'C') {
          card.classList.add('correct-green');
        } else {
          card.classList.add('neutral-dim');
        }
      } else {
        if (slide1SelectedOption === opt) {
          card.classList.add('selected-blue');
        }
      }
    });
  }

  function handleSlide1MainButton() {
    if (slide1SubState === 0) {
      slideSteps[0] = 1;
      slide1SubState = 1;
      renderAll();
    } else if (slide1SubState === 1) {
      clearTimeout(slide1AnimTimer);
      slideSteps[0] = 2;
      slide1SubState = 2;
      renderAll();
      slide1AnimTimer = setTimeout(() => {
        slide1SubState = 3;
        renderSlide1();
      }, 1480);
    } else if (slide1SubState === 3) {
      slideSteps[0] = 3;
      slide1SubState = 4;
      renderAll();
    }
  }

  function renderSlide1() {
    const needles = document.getElementById('s1-rotating-needles');
    const figStatus = document.getElementById('s1-figure-status');
    const promptArea = document.getElementById('s1-prompt-area');
    const qLine = document.getElementById('s1-question-line');
    const mainBtn = document.getElementById('s1-main-action-btn');
    const resultBox = document.getElementById('s1-result-box');

    renderSlide1Options();
    mainBtn.classList.remove('stage-blue', 'stage-green');

    if (slide1SubState === 0) {
      needles.style.transform = 'rotate(0deg)';
      figStatus.classList.remove('visible');
      promptArea.style.display = 'flex';
      resultBox.style.display = 'none';
      qLine.textContent = 'Em hãy dự đoán: Sau khi quay 180°, hình thu được có đặc điểm gì?';
      mainBtn.disabled = false;
      mainBtn.textContent = 'EM HÃY THỬ DỰ ĐOÁN NHÉ!';
    } else if (slide1SubState === 1) {
      needles.style.transform = 'rotate(0deg)';
      figStatus.classList.remove('visible');
      promptArea.style.display = 'flex';
      resultBox.style.display = 'none';
      qLine.textContent = 'Hãy nhấp chọn một phương án A, B, C hoặc D rồi nhấn nút kiểm chứng!';
      mainBtn.disabled = false;
      mainBtn.classList.add('stage-blue');
      mainBtn.textContent = 'KIỂM CHỨNG: QUAY 180°';
    } else if (slide1SubState === 2) {
      needles.style.transform = 'rotate(180deg)';
      figStatus.classList.remove('visible');
      promptArea.style.display = 'flex';
      resultBox.style.display = 'none';
      qLine.textContent = 'Đang thực hiện phép quay 180° quanh điểm cố định O...';
      mainBtn.disabled = true;
      mainBtn.classList.add('stage-blue');
      mainBtn.textContent = 'KIỂM CHỨNG: QUAY 180°';
    } else if (slide1SubState === 3) {
      needles.style.transform = 'rotate(180deg)';
      figStatus.classList.add('visible');
      promptArea.style.display = 'flex';
      resultBox.style.display = 'none';
      qLine.textContent = 'Điểm O giữ nguyên, hai kim đã đổi vị trí cho nhau và chồng khít với hình ban đầu!';
      mainBtn.disabled = false;
      mainBtn.classList.add('stage-green');
      mainBtn.textContent = 'XEM KẾT LUẬN';
    } else if (slide1SubState === 4) {
      needles.style.transform = 'rotate(180deg)';
      figStatus.classList.add('visible');
      promptArea.style.display = 'none';
      resultBox.style.display = 'block';
    }
  }

  /* --------------------------------------------------------------------------
     5. LOGIC SLIDE 2: TIẾN TRÌNH KHÁM PHÁ & KHUNG KẾT LUẬN CHÍNH GIỮA MÀN HÌNH
     -------------------------------------------------------------------------- */
  function clearSlide2ConclusionTimers() {
    slide2ConclusionTimers.forEach(t => clearTimeout(t));
    slide2ConclusionTimers = [];
  }

  function resetSlide2GrandConclusionElements() {
    const grandBox = document.getElementById('s2-grand-conclusion-box');
    if (grandBox) grandBox.classList.remove('zoom-in');
    [
      's2-seq-title',
      's2-seq-def',
      's2-seq-formula',
      's2-seq-prop-box',
      's2-seq-prop-1',
      's2-seq-prop-2',
      's2-seq-prop-3',
      's2-restart-explore-btn'
    ].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.remove('seq-visible');
    });
  }

  /* Thực hiện chuỗi hiệu ứng khi nhấn "Hiện kết luận" ở Slide 2:
     1. Ba khung hình khám phá thu nhỏ nhẹ và fade out (0.42s).
     2. Tiêu đề câu hỏi và chú thích biến mất hoàn toàn.
     3. Khung kết luận lớn xuất hiện ở chính giữa với hiệu ứng fade-in + zoom nhẹ.
     4. Tiêu đề -> Định nghĩa -> Công thức ghi nhớ -> 3 Tính chất A, O, A' lần lượt xuất hiện (0.45s/bước).
  */
  function transitionToSlide2GrandConclusion() {
    if (slide2IsTransitioningToConclusion) return;
    clearSlide2ConclusionTimers();
    resetSlide2GrandConclusionElements();

    const slideEl = document.getElementById('slide-1');
    // Nếu đang ở trạng thái khám phá, cho 3 khung hình thu nhỏ nhẹ và fade out trước
    if (!slideEl.classList.contains('s2-conclusion-active')) {
      slide2IsTransitioningToConclusion = true;
      slideEl.classList.add('s2-fading-out');

      const fadeOutTimer = setTimeout(() => {
        slideEl.classList.remove('s2-fading-out');
        slide2IsTransitioningToConclusion = false;
        slideSteps[1] = 16;
        renderSlide2(16);
        runSlide2GrandConclusionSequence();
      }, 420);
      slide2ConclusionTimers.push(fadeOutTimer);
    } else {
      slideSteps[1] = 16;
      renderSlide2(16);
      runSlide2GrandConclusionSequence();
    }
  }

  function runSlide2GrandConclusionSequence() {
    resetSlide2GrandConclusionElements();
    const grandBox = document.getElementById('s2-grand-conclusion-box');

    // Khung lớn zoom nhẹ vào giữa màn hình
    slide2ConclusionTimers.push(setTimeout(() => {
      if (grandBox) grandBox.classList.add('zoom-in');
    }, 50));

    // Các thành phần bên trong xuất hiện tuần tự mỗi bước ~0.48s
    const sequenceIds = [
      's2-seq-title',       // 4. Tiêu đề xuất hiện trước
      's2-seq-def',         // 5. Định nghĩa xuất hiện tiếp theo
      's2-seq-formula',     // 6. Công thức ghi nhớ xuất hiện với hiệu ứng nhấn mạnh
      's2-seq-prop-box',    // Khung dẫn dắt tính chất A, A'
      's2-seq-prop-1',      // 7.1. A, O, A' thẳng hàng
      's2-seq-prop-2',      // 7.2. OA = OA'
      's2-seq-prop-3',      // 7.3. O là trung điểm của đoạn thẳng AA'
      's2-restart-explore-btn' // Nút "Khám phá lại từ đầu"
    ];

    sequenceIds.forEach((id, idx) => {
      const timer = setTimeout(() => {
        const el = document.getElementById(id);
        if (el) el.classList.add('seq-visible');
      }, 380 + idx * 460);
      slide2ConclusionTimers.push(timer);
    });
  }

  /* Khôi phục hoàn toàn giao diện khám phá ban đầu khi nhấn "Khám phá lại từ đầu" */
  function resetSlide2ToInitialExplore() {
    clearSlide2ConclusionTimers();
    slide2IsTransitioningToConclusion = false;
    resetSlide2GrandConclusionElements();

    const slideEl = document.getElementById('slide-1');
    slideEl.classList.remove('s2-fading-out', 's2-conclusion-active');

    // Reset góc quay của các hình về trạng thái chuẩn ban đầu
    const rot90 = document.getElementById('s2-rot-90');
    const rot180 = document.getElementById('s2-rot-180');
    if (rot90 && rot180) {
      rot90.style.transition = 'none';
      rot180.style.transition = 'none';
      rot90.style.transform = 'rotate(0deg)';
      rot180.style.transform = 'rotate(90deg)';
      setTimeout(() => {
        rot90.style.transition = 'transform 1.05s cubic-bezier(0.34, 1.15, 0.64, 1)';
        rot180.style.transition = 'transform 1.05s cubic-bezier(0.34, 1.15, 0.64, 1)';
      }, 40);
    }

    slideSteps[1] = 0;
    renderSlide2(0);
  }

  function triggerSlide2Summary180Replay() {
    const rot180 = document.getElementById('s2-rot-180');
    if (!rot180) return;
    rot180.style.transition = 'none';
    rot180.style.transform = 'rotate(0deg)';
    setTimeout(() => {
      rot180.style.transition = 'transform 1.05s cubic-bezier(0.34, 1.15, 0.64, 1)';
      rot180.style.transform = 'rotate(180deg)';
    }, 35);
  }

  function handleSlide2MainButton() {
    if (slide2IsTransitioningToConclusion) return;
    const currentS = slideSteps[1];
    if (currentS === 15) {
      // Nhấn nút "HIỆN KẾT LUẬN" -> Chuyển sang giao diện Khung kết luận lớn chính giữa
      transitionToSlide2GrandConclusion();
      return;
    }
    if (currentS >= 16) {
      resetSlide2ToInitialExplore();
      return;
    }
    slideSteps[1]++;
    renderSlide2(slideSteps[1]);
    if (slideSteps[1] === 11) {
      triggerSlide2Summary180Replay();
    }
  }

  function hideAllSlide2BottomPanels() {
    document.getElementById('s2-single-qa-card').style.display = 'none';
    document.getElementById('s2-part1-def-card').style.display = 'none';
    document.getElementById('s2-part2-prop-card').style.display = 'none';
  }

  function setSlide2CardContent(mode, badgeText, mainText, hintText = '') {
    hideAllSlide2BottomPanels();
    const qaCard = document.getElementById('s2-single-qa-card');
    const badge = document.getElementById('s2-qa-badge');
    const text = document.getElementById('s2-qa-text');
    const hint = document.getElementById('s2-qa-hint');

    qaCard.style.display = 'flex';
    qaCard.className = `s2-Dynamic-card ${mode}`;

    // Kích hoạt lại hiệu ứng Fade In / Slide Up nhẹ mỗi khi đổi câu hỏi hoặc đáp án
    qaCard.style.animation = 'none';
    void qaCard.offsetWidth;
    qaCard.style.animation = 's2FadeSlideUp 0.32s ease';

    badge.textContent = badgeText;
    text.textContent = mainText;

    if (hintText) {
      hint.textContent = hintText;
      hint.classList.add('visible');
    } else {
      hint.textContent = '';
      hint.classList.remove('visible');
    }
  }

  function renderSlide2(step) {
    const slideEl = document.getElementById('slide-1');

    // Nếu đang ở Bước 16 (Trạng thái Hiện kết luận chính giữa màn hình):
    // Ẩn hoàn toàn 3 khung hình, tiêu đề câu hỏi khám phá, chú thích và phần dẫn dắt cũ
    if (step === 16) {
      slideEl.classList.add('s2-conclusion-active');
      return;
    }

    // Nếu ở các bước khám phá (0 -> 15): Đảm bảo ẩn khung kết luận chính giữa và hiện lại giao diện khám phá
    slideEl.classList.remove('s2-conclusion-active', 's2-fading-out');

    const c1 = document.getElementById('s2-card-1');
    const c2 = document.getElementById('s2-card-2');
    const c3 = document.getElementById('s2-card-3');

    const lineFig1 = document.getElementById('s2-line-1o2-fig1');
    const lineFig3 = document.getElementById('s2-line-1o2-fig3');
    const segAA = document.getElementById('s2-segment-aa');
    const labelsAA = document.getElementById('s2-labels-aa');
    const rotArrow180 = document.getElementById('s2-rot-arrow-180');
    const card3Caption = document.getElementById('s2-card3-caption');

    const ptsFig1 = document.getElementById('s2-pts-fig1');
    const rot90 = document.getElementById('s2-rot-90');
    const labels90 = document.getElementById('s2-labels-90');
    const rot180 = document.getElementById('s2-rot-180');
    const labels180 = document.getElementById('s2-labels-180');
    const mainBtn = document.getElementById('s2-main-action-btn');
    const progressPill = document.getElementById('s2-progress-pill');

    // Reset các hiệu ứng động trước khi áp dụng trạng thái của step hiện tại
    ptsFig1.classList.remove('highlight-swap');
    labels180.classList.remove('highlight-swap');
    rotArrow180.classList.remove('highlight-swap');
    document.querySelectorAll('.s2-point-o').forEach(el => el.classList.remove('zoom-pulse-o'));
    document.querySelectorAll('.s2-dist-marks').forEach(el => el.style.opacity = '0');
    lineFig1.style.opacity = '0';
    lineFig3.style.opacity = '0';
    segAA.style.opacity = '0';
    labelsAA.style.opacity = '0';

    // Mặc định nhãn dưới Hình 3
    card3Caption.className = 'stage-caption';
    card3Caption.style.background = '';
    card3Caption.textContent = 'Điểm 1 và 2 đổi chỗ • Hai kim chồng khít';

    [c1, c2, c3].forEach(c => c.classList.remove('active-stage', 'hidden-stage'));
    mainBtn.classList.remove('btn-blue-phase', 'btn-green-phase');

    // Quản lý hiển thị 3 khung hình theo tiến trình
    if (step <= 2) {
      // BƯỚC 1: Chỉ hiển thị rõ Hình 1 (0°)
      c1.classList.add('active-stage');
      c2.classList.add('hidden-stage');
      c3.classList.add('hidden-stage');
      rot90.style.transform = 'rotate(0deg)';
      labels90.style.opacity = '0';
      rot180.style.transform = 'rotate(90deg)';
      labels180.style.opacity = '0';
    } else if (step <= 4) {
      // BƯỚC 2: Hiển thị Hình 1 và quay Hình 2 lên 90°
      c1.classList.remove('hidden-stage');
      c2.classList.add('active-stage');
      c3.classList.add('hidden-stage');
      rot90.style.transform = 'rotate(90deg)';
      labels90.style.opacity = '1';
      rot180.style.transform = 'rotate(90deg)';
      labels180.style.opacity = '0';
    } else {
