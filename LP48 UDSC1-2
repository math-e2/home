        gain.connect(ctx.destination);
        osc.start(now + offset);
        osc.stop(now + offset + 0.21);
      });
    } catch (_) {}
  }

  // Chặn phím tắt chuyển slide khi đang nhập liệu hoặc đang ở chế độ Học sinh (khóa chuyển slide bằng bàn phím)
  window.addEventListener('keydown', function (e) {
    const tag = (e.target && e.target.tagName) ? e.target.tagName.toUpperCase() : '';
    const isInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    const anyOverlayOpen = !!document.querySelector('.rt-overlay.open');
    const isStudent = document.body.classList.contains('rt-student-mode');
    if (isInput || anyOverlayOpen || isStudent) {
      e.stopImmediatePropagation();
    }
  }, true);

  function escapeHtml(str) {
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatTime(iso) {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  function toast(msg, type = 'ok') {
    const c = document.getElementById('rt-toast-container');
    if (!c) return;
    const el = document.createElement('div');
    el.className = 'rt-toast' + (type === 'warn' ? ' warn' : type === 'err' ? ' err' : '');
    el.textContent = msg;
    c.appendChild(el);
    setTimeout(() => { el.remove(); }, 4200);
  }

  function getEffectiveConfig() {
    let url = (SUPABASE_CONFIG.url || '').trim();
    let anonKey = (SUPABASE_CONFIG.anonKey || '').trim();
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_CFG_KEY) || 'null');
      if (saved) {
        if (!url && saved.url) url = saved.url.trim();
        if (!anonKey && saved.anonKey) anonKey = saved.anonKey.trim();
      }
    } catch (_) {}
    return { url, anonKey };
  }

  function buildShareUrl(roomCode, groupCode) {
    const base = window.location.origin + window.location.pathname;
    const params = new URLSearchParams();
    params.set('room', roomCode);
    params.set('group', groupCode);
    return `${base}?${params.toString()}`;
  }

  function generateRoomCode(groupCode) {
    const prefix = groupCode === 'GROUP_2' ? 'N2' : 'N1';
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let suffix = '';
    for (let i = 0; i < 4; i++) {
      suffix += chars[Math.floor(Math.random() * chars.length)];
    }
    return `${prefix}-${suffix}`;
  }

  // --------------------------------------------------------------------------
  // THU THẬP TRẠNG THÁI BÀI LÀM TỪ CÁC SLIDE ĐƯỢC CHỈ ĐỊNH (5-9 & 14-16)
  // --------------------------------------------------------------------------
  function captureGroupPayload(groupCode, passedSlidesMap) {
    const slideNum = (typeof currentSlide === 'number' ? currentSlide : 0) + 1;
    const passed = passedSlidesMap || {};
    if (groupCode === 'GROUP_1') {
      const s5 = {
        selected: Array.isArray(s5Selected) ? s5Selected.slice() : [false,false,false,false,false,false,false],
        checked: !!s5Checked,
        rotated: !!s5Rotated
      };
      const s6 = {
        items: Array.isArray(s6State) ? s6State.map(it => ({
          selected: !!it.selected,
          hasPoint: !!it.hasPoint,
          x: Math.round(it.x || 100),
          y: Math.round(it.y || 100)
        })) : [],
        checked: !!s6Checked,
        rotated: !!s6Rotated,
        indRotated: Array.isArray(s6IndRotated) ? s6IndRotated.slice() : [false,false,false,false,false,false]
      };
      const s7 = {
        selected: Array.isArray(s7Selected) ? s7Selected.slice() : [false,false,false,false,false,false,false],
        checked: !!s7Checked,
        rotated: !!s7Rotated
      };
      const s8 = {
        selected: Array.isArray(s8Selected) ? s8Selected.slice() : [false,false,false,false],
        checked: !!s8Checked,
        rotated: !!s8Rotated
      };
      const s9 = {
        selected: Array.isArray(s9Selected) ? s9Selected.slice() : [false,false,false,false,false,false,false,false],
        checked: !!s9Checked,
        rotated: !!s9Rotated
      };
      const slides = { 5: s5, 6: s6, 7: s7, 8: s8, 9: s9 };
      const passedCount = [5, 6, 7, 8, 9].filter(sn => !!passed[sn]).length;
      const progress = Math.round((passedCount / 5) * 100);
      return {
        group_code: 'GROUP_1',
        current_slide: Math.max(5, Math.min(9, slideNum)),
        progress,
        passed_slides: { ...passed },
        slides,
        updated_client_at: new Date().toISOString()
      };
    } else {
      const s14 = {
        placedNodes: Array.isArray(btlt1PlacedNodes) ? btlt1PlacedNodes.map(p => ({ c: p.c, r: p.r })) : [],
        userEdges: Array.isArray(btlt1UserEdges) ? btlt1UserEdges.map(e => ({ a: { c: e.a.c, r: e.a.r }, b: { c: e.b.c, r: e.b.r } })) : [],
        activeNode: btlt1ActiveNode ? { c: btlt1ActiveNode.c, r: btlt1ActiveNode.r } : null,
        completed: !!btlt1Completed,
        answerShown: !!btlt1AnswerShown
      };
      const s15 = {
        selectedCell: btlt2SelectedCell ? { c: btlt2SelectedCell.c, r: btlt2SelectedCell.r } : null,
        solved: !!btlt2Solved
      };
      const s16 = {
        candidate: btlt3Candidate ? { c: btlt3Candidate.c, r: btlt3Candidate.r } : null,
        solved: !!btlt3Solved,
        answerShown: !!btlt3AnswerShown
      };
      const slides = { 14: s14, 15: s15, 16: s16 };
      const passedCount = [14, 15, 16].filter(sn => !!passed[sn]).length;
      const progress = Math.round((passedCount / 3) * 100);
      return {
        group_code: 'GROUP_2',
        current_slide: Math.max(14, Math.min(16, slideNum)),
        progress,
        passed_slides: { ...passed },
        slides,
        updated_client_at: new Date().toISOString()
      };
    }
  }

  // Khôi phục trạng thái đã lưu cho học sinh khi tải lại trang
  function restoreGroupPayloadToStudentUI(payload) {
    if (!payload || !payload.slides) return;
    const s = payload.slides;
    if (payload.group_code === 'GROUP_1') {
      if (s[5]) {
        s5Selected = Array.isArray(s[5].selected) ? s[5].selected.slice(0, 7) : s5Selected;
        s5Checked = !!s[5].checked;
        s5Rotated = !!s[5].rotated;
        renderSlide5();
      }
      if (s[6] && Array.isArray(s[6].items)) {
        s[6].items.forEach((it, i) => {
          if (s6State[i]) {
            s6State[i].selected = !!it.selected;
            s6State[i].hasPoint = !!it.hasPoint;
            s6State[i].x = it.x || 100;
            s6State[i].y = it.y || 100;
          }
        });
        s6Checked = !!s[6].checked;
        s6Rotated = !!s[6].rotated;
        if (Array.isArray(s[6].indRotated)) s6IndRotated = s[6].indRotated.slice(0, 6);
        renderSlide6();
      }
      if (s[7]) {
        s7Selected = Array.isArray(s[7].selected) ? s[7].selected.slice(0, 7) : s7Selected;
        s7Checked = !!s[7].checked;
        s7Rotated = !!s[7].rotated;
        renderSlide7();
      }
      if (s[8]) {
        s8Selected = Array.isArray(s[8].selected) ? s[8].selected.slice(0, 4) : s8Selected;
        s8Checked = !!s[8].checked;
        s8Rotated = !!s[8].rotated;
        renderSlide8();
      }
      if (s[9]) {
        s9Selected = Array.isArray(s[9].selected) ? s[9].selected.slice(0, 8) : s9Selected;
        s9Checked = !!s[9].checked;
        s9Rotated = !!s[9].rotated;
        renderSlide9();
      }
    } else if (payload.group_code === 'GROUP_2') {
      if (s[14]) {
        btlt1PlacedNodes = Array.isArray(s[14].placedNodes) ? s[14].placedNodes.map(p => ({ c: p.c, r: p.r })) : [];
        btlt1UserEdges = Array.isArray(s[14].userEdges) ? s[14].userEdges.map(e => ({ a: { c: e.a.c, r: e.a.r }, b: { c: e.b.c, r: e.b.r } })) : [];
        btlt1ActiveNode = s[14].activeNode ? { c: s[14].activeNode.c, r: s[14].activeNode.r } : null;
        btlt1Completed = !!s[14].completed;
        btlt1AnswerShown = !!s[14].answerShown;
        renderBtlt1Candidates();
      }
      if (s[15] && s[15].selectedCell) {
        btlt2Solved = false;
        handleBtlt2CellClick(s[15].selectedCell.c, s[15].selectedCell.r);
        btlt2Solved = !!s[15].solved;
      }
      if (s[16] && s[16].candidate) {
        btlt3Solved = false;
        btlt3AnswerShown = false;
        handleBtlt3NodeClick(s[16].candidate.c, s[16].candidate.r);
        btlt3Solved = !!s[16].solved;
        btlt3AnswerShown = !!s[16].answerShown;
      }
    }
  }

  // --------------------------------------------------------------------------
  // TÍNH ĐIỂM TỰ ĐỘNG (THANG 10) + CHẤM CHÍNH XÁC TỪNG CÂU
  // Phân bổ Nhóm 1 (5 câu = 10đ):
  //   - Câu 1 (Slide 5): 1.5 điểm
  //   - Câu 2 (Slide 6): 2.5 điểm
  //   - Câu 3 (Slide 7): 2.0 điểm
  //   - Câu 4 (Slide 8): 1.5 điểm
  //   - Câu 5 (Slide 9): 2.5 điểm
  // Phân bổ Nhóm 2 (3 câu = 10đ):
  //   - Câu 1 (Slide 14): 4.0 điểm
  //   - Câu 2 (Slide 15): 3.0 điểm
  //   - Câu 3 (Slide 16): 3.0 điểm
  // --------------------------------------------------------------------------
  function evaluateSingleSlide(payload, slideNum) {
    const s = (payload && payload.slides) || {};
    const weights1 = GROUP_DEFINITIONS.GROUP_1.weights;
    const weights2 = GROUP_DEFINITIONS.GROUP_2.weights;

    const evalBoolArr = (arr, key, maxPts) => {
      if (!Array.isArray(arr) || arr.length !== key.length) {
        return { isExact: false, score: 0, max: maxPts, hasSelection: false };
      }
      const hasSelection = arr.some(Boolean);
      let correctCount = 0;
      let isExact = true;
      for (let i = 0; i < key.length; i++) {
        if (!!arr[i] === !!key[i]) correctCount++;
        else isExact = false;
      }
      const score = isExact ? maxPts : (hasSelection ? Math.round((correctCount / key.length) * maxPts * 10) / 10 : 0);
      return { isExact, score, max: maxPts, hasSelection };
    };

    if (slideNum === 5) {
      const sel = (s[5] && s[5].selected) || [];
      const r = evalBoolArr(sel, S5_IS_SYM, weights1[5]);
      return {
        ...r,
        slide: 5,
        label: `Câu 1 – Slide 5 (${weights1[5]}đ)`,
        studentText: sel.map((v, i) => v ? S5_NAMES[i] : null).filter(Boolean).join(', ') || 'Chưa chọn'
      };
    }
    if (slideNum === 6) {
      const items = (s[6] && s[6].items) || [];
      const picked = items.map(it => !!(it.selected || it.hasPoint));
      const r = evalBoolArr(picked, S6_IS_SYM, weights1[6]);
      return {
        ...r,
        slide: 6,
        label: `Câu 2 – Slide 6 (${weights1[6]}đ)`,
        studentText: picked.map((v, i) => v ? S6_TITLES[i] : null).filter(Boolean).join(', ') || 'Chưa chọn'
      };
    }
    if (slideNum === 7) {
      const sel = (s[7] && s[7].selected) || [];
      const r = evalBoolArr(sel, S7_IS_SYM_GEOM, weights1[7]);
      return {
        ...r,
        slide: 7,
        label: `Câu 3 – Slide 7 (${weights1[7]}đ)`,
        studentText: sel.map((v, i) => v ? S7_LABELS[i] : null).filter(Boolean).join(', ') || 'Chưa chọn'
      };
    }
    if (slideNum === 8) {
      const sel = (s[8] && s[8].selected) || [];
      const s8Names = ['Chữ M', 'Chữ O', 'Chữ Z', 'Chữ I'];
      const r = evalBoolArr(sel, S8_IS_SYM, weights1[8]);
      return {
        ...r,
        slide: 8,
        label: `Câu 4 – Slide 8 (${weights1[8]}đ)`,
        studentText: sel.map((v, i) => v ? s8Names[i] : null).filter(Boolean).join(', ') || 'Chưa chọn'
      };
    }
    if (slideNum === 9) {
      const sel = (s[9] && s[9].selected) || [];
      const s9Names = ['a)', 'b)', 'c)', 'd)', 'e)', 'f)', 'g)', 'h)'];
      const r = evalBoolArr(sel, S9_IS_SYM, weights1[9]);
      return {
        ...r,
        slide: 9,
        label: `Câu 5 – Slide 9 (${weights1[9]}đ)`,
        studentText: sel.map((v, i) => v ? s9Names[i] : null).filter(Boolean).join(', ') || 'Chưa chọn'
      };
    }
    if (slideNum === 14) {
      const s14 = s[14] || {};
      const nodes = Array.isArray(s14.placedNodes) ? s14.placedNodes : [];
      const edges = Array.isArray(s14.userEdges) ? s14.userEdges : [];
      const reqNodes = BTLT1_REQUIRED_TARGETS.map(t => `${t.c},${t.r}`);
      const hitNodes = reqNodes.filter(k => nodes.some(n => `${n.c},${n.r}` === k)).length;
      const reqEdges = BTLT1_REQUIRED_EDGES.map(e => [`${e[0][0]},${e[0][1]}`, `${e[1][0]},${e[1][1]}`].sort().join('|'));
      const hitEdges = reqEdges.filter(k => edges.some(e => [`${e.a.c},${e.a.r}`, `${e.b.c},${e.b.r}`].sort().join('|') === k)).length;
      const isExact = (nodes.length === 4 && hitNodes === 4 && edges.length === 3 && hitEdges === 3) || !!s14.completed;
      const score = isExact ? weights2[14] : Math.round(((hitNodes / 4) * 2 + (hitEdges / 3) * 2) * 10) / 10;
      return {
        slide: 14,
        isExact,
        hasSelection: nodes.length > 0 || edges.length > 0,
        score,
        max: weights2[14],
        label: `Câu 1 – Slide 14 (${weights2[14]}đ)`,
        studentText: `Đã đặt ${nodes.length} điểm (${hitNodes}/4 đúng), vẽ ${edges.length} đoạn (${hitEdges}/3 đúng)`
      };
    }
    if (slideNum === 15) {
      const s15 = s[15] || {};
      const cell = s15.selectedCell;
      const isExact = !!(s15.solved || (cell && cell.c === 3 && cell.r === 3));
      return {
        slide: 15,
        isExact,
        hasSelection: !!cell,
        score: isExact ? weights2[15] : 0,
        max: weights2[15],
        label: `Câu 2 – Slide 15 (${weights2[15]}đ)`,
        studentText: cell ? `Chọn ô (cột ${cell.c}, hàng ${cell.r})` + (isExact ? ' ✓ Đúng' : ' ✗ Chưa đúng') : 'Chưa chọn ô'
      };
    }
    if (slideNum === 16) {
      const s16 = s[16] || {};
      const cand = s16.candidate;
      const isExact = !!(s16.solved || (cand && cand.c === 0 && cand.r === 4));
      return {
        slide: 16,
        isExact,
        hasSelection: !!cand,
        score: isExact ? weights2[16] : 0,
        max: weights2[16],
        label: `Câu 3 – Slide 16 (${weights2[16]}đ)`,
        studentText: cand ? `Chọn giao điểm (${cand.c}, ${cand.r})` + (isExact ? ' ✓ Đúng' : ' ✗ Chưa đúng') : 'Chưa chọn điểm'
      };
    }
    return { slide: slideNum, isExact: false, hasSelection: false, score: 0, max: 0, label: `Slide ${slideNum}`, studentText: '' };
  }

  function evaluatePayload(payload) {
    if (!payload || !payload.slides) {
      return { autoScore: 0, maxScore: 10, details: [], allPassed: false };
    }
    const slideNums = payload.group_code === 'GROUP_2' ? [14, 15, 16] : [5, 6, 7, 8, 9];
    const details = slideNums.map(sn => evaluateSingleSlide(payload, sn));
    const total = details.reduce((acc, d) => acc + d.score, 0);
    const allPassed = details.every(d => d.isExact);
    return {
      autoScore: Math.min(10, Math.round(total * 10) / 10),
      maxScore: 10,
      details,
      allPassed
    };
  }

  // --------------------------------------------------------------------------
  // TÁI HIỆN TRỰC QUAN BÀI LÀM HỌC SINH BÊN TRONG KHUNG GIÁM SÁT
  // --------------------------------------------------------------------------
  function renderLiveSlidePreview(viewportEl, payload, overrideSlideNum) {
    if (!viewportEl) return;
    const slideNum = overrideSlideNum || (payload && payload.current_slide) || (payload && payload.group_code === 'GROUP_2' ? 14 : 5);
    const secId = SLIDE_SECTION_IDS[slideNum];
    const srcSec = secId ? document.getElementById(secId) : null;
    if (!srcSec) {
      viewportEl.innerHTML = '<div style="padding:20px; text-align:center; color:#475569;">Đang chờ học sinh mở bài tập...</div>';
      return;
    }

    const clone = srcSec.cloneNode(true);
    clone.removeAttribute('id');
    clone.classList.add('active');
    clone.querySelectorAll('[id]').forEach(el => {
      el.setAttribute('data-cid', el.getAttribute('id'));
      el.removeAttribute('id');
    });
    clone.querySelectorAll('[onclick]').forEach(el => el.removeAttribute('onclick'));

    const q = (cid) => clone.querySelector(`[data-cid="${cid}"]`);
    const slideData = (payload && payload.slides && payload.slides[slideNum]) ? payload.slides[slideNum] : null;

    if (slideData) {
      if ([5, 7, 8, 9].includes(slideNum)) {
        const prefix = 's' + slideNum;
        const keyArr = slideNum === 5 ? S5_IS_SYM : slideNum === 7 ? S7_IS_SYM_GEOM : slideNum === 8 ? S8_IS_SYM : S9_IS_SYM;
        const sel = slideData.selected || [];
        const checked = !!slideData.checked;
        const rotated = !!slideData.rotated;
        const pill = q(`${prefix}-angle-pill`);
        if (pill) pill.textContent = rotated ? 'Góc quay: 180°' : 'Góc quay: 0°';

        for (let i = 0; i < keyArr.length; i++) {
          const card = q(`${prefix}-card-${i}`);
          const chk = q(`${prefix}-chk-${i}`);
          const badge = q(`${prefix}-badge-${i}`);
          const rotEl = q(`${prefix}-rot-${i}`);
          const ghostEl = q(`${prefix}-ghost-${i}`);
          const oEl = q(`${prefix}-o-${i}`);
          if (card) {
            card.classList.remove('selected-item', 'checked-sym', 'checked-nonsym');
            if (sel[i]) card.classList.add('selected-item');
            if (checked) card.classList.add(keyArr[i] ? 'checked-sym' : 'checked-nonsym');
          }
          if (chk) chk.textContent = sel[i] ? '✓' : '';
          if (rotEl) rotEl.style.transform = rotated ? 'rotate(180deg)' : 'rotate(0deg)';
          if (ghostEl) ghostEl.classList.toggle('visible', rotated);
          if (badge) {
            badge.className = 'hdcn-status-badge';
            if (checked) {
              badge.classList.add(keyArr[i] ? 'show-sym' : 'show-nonsym');
              badge.textContent = keyArr[i] ? '✓ Có tâm' : '✗ Không';
            } else {
              badge.textContent = '';
            }
          }
          if (oEl) oEl.classList.toggle('visible', checked && keyArr[i]);
        }
      }

      if (slideNum === 6) {
        const items = slideData.items || [];
        const checked = !!slideData.checked;
        const rotated = !!slideData.rotated;
        const indRot = slideData.indRotated || [];
        const pill = q('s6-angle-pill');
        if (pill) pill.textContent = rotated ? 'Góc quay: 180°' : 'Góc quay: 0°';
        for (let i = 0; i < 6; i++) {
          const st = items[i] || {};
          const card = q(`s6-card-${i}`);
          const rotEl = q(`s6-rot-${i}`);
          const ghostEl = q(`s6-ghost-${i}`);
          const userPt = q(`s6-user-pt-${i}`);
          const userRing = q(`s6-user-ring-${i}`);
          const userDot = q(`s6-user-dot-${i}`);
          const ansO = q(`s6-ans-o-${i}`);
          const ansLbl = q(`s6-ans-lbl-${i}`);
          const lines = q(`s6-lines-${i}`);
          const isRot = rotated || !!indRot[i];
          if (card) {
            card.classList.remove('selected-item', 'checked-sym', 'checked-nonsym');
            if (!checked && (st.selected || st.hasPoint)) card.classList.add('selected-item');
            if (checked) card.classList.add(S6_IS_SYM[i] ? 'checked-sym' : 'checked-nonsym');
          }
          if (rotEl) rotEl.style.transform = isRot ? 'rotate(180deg)' : 'rotate(0deg)';
          if (ghostEl) ghostEl.classList.toggle('visible', isRot);
          if (userPt) {
            userPt.style.display = (!checked && st.hasPoint) ? 'block' : 'none';
            if (userRing) { userRing.setAttribute('cx', st.x || 100); userRing.setAttribute('cy', st.y || 100); }
            if (userDot) { userDot.setAttribute('cx', st.x || 100); userDot.setAttribute('cy', st.y || 100); }
          }
          if (ansO) ansO.classList.toggle('shown', checked && S6_IS_SYM[i]);
          if (ansLbl) ansLbl.classList.toggle('shown', checked && S6_IS_SYM[i]);
          if (lines) lines.classList.toggle('shown', checked && S6_IS_SYM[i]);
        }
      }

      if (slideNum === 14) {
        const layer = q('btlt1-candidates-layer');
        if (layer) {
          let html = '';
          const edges = slideData.userEdges || [];
          const nodes = slideData.placedNodes || [];
          const active = slideData.activeNode;
          const color = slideData.completed ? '#16a34a' : '#0284c7';
          edges.forEach(e => {
            const x1 = 55 + e.a.c * 80, y1 = 30 + e.a.r * 80;
            const x2 = 55 + e.b.c * 80, y2 = 30 + e.b.r * 80;
            html += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="6" stroke-linecap="round" />`;
          });
          nodes.forEach(p => {
            const x = 55 + p.c * 80, y = 30 + p.r * 80;
            const isAct = active && active.c === p.c && active.r === p.r;
            html += `<circle cx="${x}" cy="${y}" r="${isAct ? 11 : 8.5}" fill="${isAct ? '#f59e0b' : color}" stroke="#ffffff" stroke-width="2.5" />`;
          });
          layer.innerHTML = html;
        }
        if (slideData.answerShown) {
          ['btlt1-ans-pt-1', 'btlt1-ans-pt-2', 'btlt1-ans-pt-3', 'btlt1-ans-pt-4'].forEach(id => q(id)?.classList.add('shown'));
          ['btlt1-seg-1', 'btlt1-seg-2', 'btlt1-seg-3'].forEach(id => q(id)?.classList.add('drawn'));
        }
      }

      if (slideNum === 15) {
        const cell = slideData.selectedCell;
        for (let r = 0; r < 4; r++) {
          for (let c = 0; c < 6; c++) {
            const rect = q(`btlt2-cell-${c}-${r}`);
            if (rect) rect.classList.toggle('selected-cell', !!(cell && cell.c === c && cell.r === r));
          }
        }
        if (slideData.solved) {
          q('btlt2-ans-tile')?.classList.add('shown');
          const ray = q('btlt2-center-ray');
          if (ray) { ray.style.opacity = '1'; ray.setAttribute('x2', '294'); ray.setAttribute('y2', '289'); }
          const ticks = q('btlt2-equal-ticks');
          if (ticks) ticks.style.opacity = '1';
        }
      }

      if (slideNum === 16) {
        const cand = slideData.candidate;
        const marker = q('btlt3-cand-marker');
        if (marker && cand) {
          const x = 40 + cand.c * 74, y = 30 + cand.r * 74;
          marker.style.display = 'block';
          q('btlt3-cand-pulse')?.setAttribute('cx', x);
          q('btlt3-cand-pulse')?.setAttribute('cy', y);
          q('btlt3-cand-dot')?.setAttribute('cx', x);
          q('btlt3-cand-dot')?.setAttribute('cy', y);
        }
        if (slideData.solved || slideData.answerShown) {
          if (slideData.answerShown) q('btlt3-ans-pp')?.classList.add('shown');
          const l1 = q('btlt3-line-po'), l2 = q('btlt3-line-op2');
          if (l1) { l1.style.opacity = '1'; l1.setAttribute('x2', '262'); l1.setAttribute('y2', '178'); }
          if (l2) { l2.style.opacity = '1'; l2.setAttribute('x2', '40'); l2.setAttribute('y2', '326'); }
          const ticks = q('btlt3-equal-ticks');
          if (ticks) ticks.style.opacity = '1';
        }
      }
    }

    const scaler = document.createElement('div');
    scaler.className = 'rt-preview-scaler';
    scaler.appendChild(clone);
    viewportEl.innerHTML = '';
    viewportEl.appendChild(scaler);

    const scaleNow = () => {
      const w = viewportEl.clientWidth || 420;
      const scale = w / 1360;
      scaler.style.transform = `scale(${scale})`;
    };
    scaleNow();
    requestAnimationFrame(scaleNow);
  }

