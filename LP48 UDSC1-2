        if (inBox) inBox.style.display = 'none';
      }
    },

    async signInTeacher() {
      const msg = document.getElementById('rt-auth-msg');
      if (!this.supabase) {
        if (msg) { msg.style.color = '#dc2626'; msg.textContent = 'Hãy cấu hình Supabase URL & Anon Key trước.'; }
        return;
      }
      const email = (document.getElementById('rt-teacher-email')?.value || '').trim();
      const password = (document.getElementById('rt-teacher-password')?.value || '').trim();
      const { data, error } = await this.supabase.auth.signInWithPassword({ email, password });
      if (error) {
        if (msg) { msg.style.color = '#dc2626'; msg.textContent = 'Lỗi đăng nhập: ' + error.message; }
        return;
      }
      if (msg) { msg.style.color = '#15803d'; msg.textContent = '✓ Đăng nhập thành công!'; }
      this.setTeacherUser(data.user);
      this.switchTeacherTab('rooms');
    },

    async signOutTeacher() {
      if (!this.supabase) return;
      await this.supabase.auth.signOut();
      this.clearTeacherRealtime();
      this.activeRooms = { GROUP_1: null, GROUP_2: null };
      this.studentsById = {};
      this.liveStatesByStudentId = {};
      this.submissionsByStudentId = {};
      this.setTeacherUser(null);
      this.renderActiveRooms();
      this.renderMonitorGrids();
      this.renderGradingTable();
    },

    async createRoom() {
      const msg = document.getElementById('rt-create-room-msg');
      if (!this.supabase || !this.teacherUser) {
        if (msg) { msg.style.color = '#dc2626'; msg.textContent = 'Vui lòng kết nối Supabase và đăng nhập tài khoản Giáo viên trước.'; }
        this.switchTeacherTab('config');
        return;
      }
      const groupCode = document.getElementById('rt-create-group-select')?.value || 'GROUP_1';
      const grp = GROUP_DEFINITIONS[groupCode];
      const className = (document.getElementById('rt-create-class-input')?.value || '').trim() || null;
      const roomCode = generateRoomCode(groupCode);

      if (this.activeRooms[groupCode] && this.activeRooms[groupCode].status === 'open') {
        await this.closeRoom(this.activeRooms[groupCode].id, groupCode, true);
      }

      const { data, error } = await this.supabase
        .from('rooms')
        .insert({
          room_code: roomCode,
          teacher_id: this.teacherUser.id,
          class_name: className,
          lesson_title: 'Bài 48: Tâm đối xứng (UDSC1-2)',
          group_code: grp.code,
          slide_start: grp.slideStart,
          slide_end: grp.slideEnd,
          max_students: grp.maxStudents,
          status: 'open'
        })
        .select()
        .single();

      if (error) {
        if (msg) { msg.style.color = '#dc2626'; msg.textContent = 'Lỗi tạo phòng: ' + error.message; }
        return;
      }

      if (msg) { msg.style.color = '#15803d'; msg.textContent = `✓ Đã tạo phòng ${data.room_code} cho ${grp.title}!`; }
      toast(`Đã tạo phòng ${data.room_code} (${grp.label})`, 'ok');
      await this.refreshTeacherData();
    },

    async closeRoom(roomId, groupCode, silent = false) {
      if (!this.supabase || !this.teacherUser) return;
      const room = this.activeRooms[groupCode];
      const { error } = await this.supabase
        .from('rooms')
        .update({ status: 'closed', closed_at: new Date().toISOString() })
        .eq('id', roomId)
        .eq('teacher_id', this.teacherUser.id);

      if (error) {
        if (!silent) toast('Lỗi khi đóng phòng: ' + error.message, 'err');
        return;
      }

      if (room && room.room_code) {
        this.broadcastToRoom(room.room_code, 'room_closed', { room_id: roomId });
      }
      if (!silent) {
        toast(`Đã đóng phòng ${room ? room.room_code : ''}. Học sinh mới không thể tham gia.`, 'warn');
        await this.refreshTeacherData();
      }
    },

    broadcastToRoom(roomCode, eventName, payload) {
      if (!this.supabase || !roomCode) return;
      const chName = `room-live-${roomCode.toUpperCase()}`;
      const ch = this.supabase.channel(chName);
      ch.subscribe((status) => {
        if (status === 'SUBSCRIBED') {
          ch.send({ type: 'broadcast', event: eventName, payload }).then(() => {
            setTimeout(() => this.supabase.removeChannel(ch), 600);
          });
        }
      });
    },

    async refreshTeacherData() {
      if (!this.supabase || !this.teacherUser) return;

      const { data: rooms, error: rErr } = await this.supabase
        .from('rooms')
        .select('*')
        .eq('teacher_id', this.teacherUser.id)
        .in('group_code', ['GROUP_1', 'GROUP_2'])
        .order('created_at', { ascending: false })
        .limit(20);

      if (rErr) {
        toast('Lỗi tải danh sách phòng: ' + rErr.message, 'err');
        return;
      }

      this.activeRooms = { GROUP_1: null, GROUP_2: null };
      (rooms || []).forEach(r => {
        if (!this.activeRooms[r.group_code]) {
          this.activeRooms[r.group_code] = r;
        }
      });

      const roomIds = Object.values(this.activeRooms).filter(Boolean).map(r => r.id);
      this.studentsById = {};
      this.liveStatesByStudentId = {};
      this.submissionsByStudentId = {};

      if (roomIds.length > 0) {
        const [stRes, lvRes, sbRes] = await Promise.all([
          this.supabase.from('students').select('*').in('room_id', roomIds).order('joined_at', { ascending: true }),
          this.supabase.from('student_live_states').select('*').in('room_id', roomIds),
          this.supabase.from('submissions').select('*').in('room_id', roomIds)
        ]);
        (stRes.data || []).forEach(s => { this.studentsById[s.id] = s; });
        (lvRes.data || []).forEach(l => { this.liveStatesByStudentId[l.student_id] = l; });
        (sbRes.data || []).forEach(b => { this.submissionsByStudentId[b.student_id] = b; });
      }

      this.renderActiveRooms();
      this.renderMonitorGrids();
      this.renderGradingTable();
      this.subscribeTeacherRealtime(roomIds);
    },

    clearTeacherRealtime() {
      if (!this.supabase) return;
      this.teacherChannels.forEach(ch => this.supabase.removeChannel(ch));
      this.teacherChannels = [];
    },

    subscribeTeacherRealtime(roomIds) {
      this.clearTeacherRealtime();
      if (!this.supabase || !roomIds || roomIds.length === 0) return;

      roomIds.forEach(roomId => {
        const ch = this.supabase
          .channel(`teacher-room-${roomId}`)
          .on('postgres_changes', { event: '*', schema: 'public', table: 'students', filter: `room_id=eq.${roomId}` }, (payload) => {
            if (payload.new && payload.new.id) {
              const isNew = !this.studentsById[payload.new.id];
              this.studentsById[payload.new.id] = payload.new;
              if (isNew) toast(`👋 Học sinh ${payload.new.student_name} vừa tham gia phòng!`, 'ok');
              this.renderActiveRooms();
              this.renderMonitorGrids();
              this.renderGradingTable();
            }
          })
          .on('postgres_changes', { event: '*', schema: 'public', table: 'student_live_states', filter: `room_id=eq.${roomId}` }, (payload) => {
            if (payload.new && payload.new.student_id) {
              this.liveStatesByStudentId[payload.new.student_id] = payload.new;
              this.renderMonitorGrids();
              this.renderGradingTable();
              if (this.currentDetailStudentId === payload.new.student_id) {
                this.renderDetailModalContent();
              }
            }
          })
          .on('postgres_changes', { event: '*', schema: 'public', table: 'submissions', filter: `room_id=eq.${roomId}` }, (payload) => {
            if (payload.new && payload.new.student_id) {
              const prev = this.submissionsByStudentId[payload.new.student_id];
              this.submissionsByStudentId[payload.new.student_id] = payload.new;
              const st = this.studentsById[payload.new.student_id];
              if (!prev && st) toast(`📥 Học sinh ${st.student_name} vừa nộp bài!`, 'ok');
              this.renderMonitorGrids();
              this.renderGradingTable();
              if (this.currentDetailStudentId === payload.new.student_id) {
                this.renderDetailModalContent();
              }
            }
          })
          .subscribe();
        this.teacherChannels.push(ch);
      });
    },

    renderActiveRooms() {
      const container = document.getElementById('rt-active-rooms-grid');
      if (!container) return;

      const renderRoomCard = (groupCode) => {
        const grp = GROUP_DEFINITIONS[groupCode];
        const room = this.activeRooms[groupCode];
        const icon = groupCode === 'GROUP_1' ? '📘' : '📙';

        if (!room) {
          return `
            <div class="rt-card">
              <h3><span>${icon} ${grp.title}</span><span class="rt-pill rt-pill-slate">Chưa tạo phòng</span></h3>
              <p style="font-size:13px; color:#475569;">Chưa có phòng nào cho nhóm này. Hãy chọn nhóm và bấm <b>Tạo phòng &amp; Sinh link</b> ở trên.</p>
            </div>`;
        }

        const studentsInRoom = Object.values(this.studentsById).filter(s => s.room_id === room.id);
        const shareUrl = buildShareUrl(room.room_code, room.group_code);
        const isOpen = room.status === 'open';
        const qrId = `rt-qr-${groupCode}`;

        return `
          <div class="rt-card">
            <h3>
              <span>${icon} ${grp.title}</span>
              <span class="rt-pill ${isOpen ? 'rt-pill-green' : 'rt-pill-red'}">${isOpen ? 'Đang mở' : 'Đã đóng'} • ${studentsInRoom.length}/${room.max_students || 10} HS</span>
            </h3>
            <div style="font-size:13px; color:#334155;">
              Mã phòng: <b style="font-size:15px; color:#ea580c;">${escapeHtml(room.room_code)}</b>
              ${room.class_name ? `• Lớp: <b>${escapeHtml(room.class_name)}</b>` : ''}
            </div>
            <div class="rt-link-box">${escapeHtml(shareUrl)}</div>
            <div class="rt-qr-wrap">
              <canvas id="${qrId}" width="110" height="110"></canvas>
              <div style="display:flex; flex-direction:column; gap:8px; flex:1;">
                <button class="rt-btn rt-btn-primary" onclick="PracticeHub.copyShareLink('${escapeHtml(shareUrl)}')">📋 Sao chép link tham gia</button>
                <button class="rt-btn rt-btn-orange" onclick="PracticeHub.switchTeacherTab('monitor')">🖥️ Mở màn hình giám sát</button>
                ${isOpen ? `<button class="rt-btn rt-btn-red" onclick="PracticeHub.closeRoom('${room.id}', '${groupCode}')">🔒 Đóng phòng</button>` : ''}
              </div>
            </div>
          </div>`;
      };

      container.innerHTML = renderRoomCard('GROUP_1') + renderRoomCard('GROUP_2');

      ['GROUP_1', 'GROUP_2'].forEach(groupCode => {
        const room = this.activeRooms[groupCode];
        if (!room || !window.QRCode) return;
        const canvas = document.getElementById(`rt-qr-${groupCode}`);
        if (canvas) {
          window.QRCode.toCanvas(canvas, buildShareUrl(room.room_code, room.group_code), { width: 110, margin: 1 }, () => {});
        }
      });
    },

    async copyShareLink(url) {
      try {
        await navigator.clipboard.writeText(url);
        toast('Đã sao chép link tham gia phòng!', 'ok');
      } catch (_) {
        window.prompt('Sao chép đường dẫn tham gia:', url);
      }
    },

    setMonitorFilter(filterKey) {
      this.monitorFilter = filterKey;
      document.querySelectorAll('.rt-filter-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-filter') === filterKey);
      });
      this.renderMonitorGrids();
    },

    getStudentComputedStatus(st) {
      const sub = this.submissionsByStudentId[st.id];
      const live = this.liveStatesByStudentId[st.id];
      const payload = (sub && sub.answers && sub.answers.payload) || (live && live.live_payload) || null;
      const evalRes = evaluatePayload(payload);
      const lastMs = st.last_active_at ? (Date.now() - new Date(st.last_active_at).getTime()) : 999999;
      const isOffline = lastMs > 65000;
      const isSubmitted = !!(sub || st.submitted_at);
      const isPendingGrade = !!(sub && sub.grading_status !== 'graded');
      const isGraded = !!(sub && sub.grading_status === 'graded');
      return { isOffline, isSubmitted, isPendingGrade, isGraded, sub, live, evalRes };
    },

    renderMonitorGrids() {
      let totalCount = 0;
      let pendingCount = 0;

      ['GROUP_1', 'GROUP_2'].forEach(groupCode => {
        const room = this.activeRooms[groupCode];
        const gridId = groupCode === 'GROUP_1' ? 'rt-monitor-grid-g1' : 'rt-monitor-grid-g2';
        const statsId = groupCode === 'GROUP_1' ? 'rt-g1-header-stats' : 'rt-g2-header-stats';
        const grid = document.getElementById(gridId);
        const statsEl = document.getElementById(statsId);
        if (!grid) return;

        if (!room) {
          if (statsEl) statsEl.textContent = '0 / 10 học sinh (Chưa mở phòng)';
          grid.innerHTML = '<div style="grid-column:1/-1; padding:18px; background:#fff; border:2px dashed #cbd5e1; border-radius:12px; text-align:center; color:#64748b;">Chưa có phòng cho nhóm này.</div>';
          return;
        }

        const allStudents = Object.values(this.studentsById)
          .filter(s => s.room_id === room.id)
          .slice(0, 10);

        totalCount += allStudents.length;
        allStudents.forEach(s => {
          const stInfo = this.getStudentComputedStatus(s);
          if (stInfo.isPendingGrade) pendingCount++;
        });

        if (statsEl) statsEl.textContent = `${allStudents.length} / ${room.max_students || 10} học sinh • Mã phòng: ${room.room_code}`;

        const filtered = allStudents.filter(st => {
          const info = this.getStudentComputedStatus(st);
          if (this.monitorFilter === 'all') return true;
          if (this.monitorFilter === 'in_progress') return !info.isSubmitted && !info.isOffline;
          if (this.monitorFilter === 'submitted') return info.isSubmitted;
          if (this.monitorFilter === 'offline') return info.isOffline;
          if (this.monitorFilter === 'pending_grading') return info.isPendingGrade;
          return true;
        });

        if (filtered.length === 0) {
          grid.innerHTML = '<div style="grid-column:1/-1; padding:18px; background:#fff; border:2px dashed #cbd5e1; border-radius:12px; text-align:center; color:#64748b;">Không có học sinh nào phù hợp bộ lọc hiện tại.</div>';
          return;
        }

        grid.innerHTML = filtered.map(st => {
          const info = this.getStudentComputedStatus(st);
          const live = info.live;
          const payload = (live && live.live_payload) || { group_code: groupCode, current_slide: st.current_slide || room.slide_start, slides: {} };
          const curSlide = payload.current_slide || st.current_slide || room.slide_start;
          const progress = live ? live.progress : (st.progress || 0);
          const curSlideDetail = info.evalRes.details.find(d => d.slide === curSlide);
          const displayScore = info.isGraded
            ? `${info.sub.score}/${info.sub.max_score || 10}`
            : `${info.evalRes.autoScore}/10`;

          const statusPill = info.isGraded
            ? `<span class="rt-pill rt-pill-green">✓ GV chấm: ${displayScore}</span>`
            : info.isSubmitted
              ? `<span class="rt-pill rt-pill-amber">📥 Đã nộp • Tự chấm: ${displayScore}</span>`
              : info.isOffline
                ? `<span class="rt-pill rt-pill-red">Mất kết nối • ${displayScore}</span>`
                : `<span class="rt-pill rt-pill-blue">Đang làm • ${displayScore}</span>`;

          return `
            <div class="rt-student-card" onclick="PracticeHub.openDetailModal('${st.id}')">
              <div class="rt-sc-head">
                <div class="rt-sc-name">
                  <span class="rt-dot ${info.isOffline ? 'rt-dot-offline' : 'rt-dot-online'}"></span>
                  <span>${escapeHtml(st.student_name)}</span>
                </div>
                <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                  <span class="rt-pill rt-pill-slate">Slide ${curSlide}</span>
                  ${statusPill}
                </div>
              </div>
              <div class="rt-sc-meta">
                <span>Bắt đầu: <b>${formatTime(st.joined_at)}</b></span>
                <span>Hoạt động: <b>${formatTime((live && live.updated_at) || st.last_active_at)}</b></span>
                <span>
                  <span class="rt-progress-track"><span class="rt-progress-fill" style="width:${progress}%;"></span></span>
                  <b>${progress}%</b>
                </span>
              </div>
              <div class="rt-preview-viewport" id="rt-preview-card-${st.id}"></div>
              <div class="rt-sc-summary">
                <span><b>Đang thao tác:</b> ${escapeHtml(curSlideDetail ? curSlideDetail.studentText : 'Đã vào bài tập')}</span>
                <span style="color:#0284c7; font-weight:bold; white-space:nowrap;">🔍 Phóng to</span>
              </div>
            </div>`;
        }).join('');

        filtered.forEach(st => {
          const live = this.liveStatesByStudentId[st.id];
          const payload = (live && live.live_payload) || { group_code: groupCode, current_slide: st.current_slide || room.slide_start, slides: {} };
          const vp = document.getElementById(`rt-preview-card-${st.id}`);
          renderLiveSlidePreview(vp, payload, payload.current_slide || st.current_slide || room.slide_start);
        });
      });

      const totalEl = document.getElementById('rt-monitor-total-count');
      if (totalEl) totalEl.textContent = String(totalCount);
      const pendEl = document.getElementById('rt-grading-pending-count');
      if (pendEl) pendEl.textContent = String(pendingCount);
    },

    rescaleAllPreviews() {
      document.querySelectorAll('.rt-preview-viewport').forEach(vp => {
        const scaler = vp.querySelector('.rt-preview-scaler');
        if (scaler && vp.clientWidth > 0) {
          scaler.style.transform = `scale(${vp.clientWidth / 1360})`;
        }
      });
    },

    renderGradingTable() {
      const tbody = document.getElementById('rt-grading-tbody');
      if (!tbody) return;
      const students = Object.values(this.studentsById);
      if (students.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:#64748b; padding:24px;">Chưa có học sinh nào tham gia phòng luyện tập.</td></tr>';
        return;
      }

      tbody.innerHTML = students.map(st => {
        const grp = GROUP_DEFINITIONS[st.group_code] || GROUP_DEFINITIONS.GROUP_1;
        const info = this.getStudentComputedStatus(st);
        const statusHtml = info.isGraded
          ? '<span class="rt-pill rt-pill-green">Đã chấm</span>'
          : info.isSubmitted
            ? '<span class="rt-pill rt-pill-amber">Chờ GV xác nhận</span>'
            : '<span class="rt-pill rt-pill-blue">Đang làm</span>';
        const scoreHtml = info.isGraded
          ? `<b>${info.sub.score}/${info.sub.max_score || 10}</b>`
          : `<span style="color:#0369a1; font-weight:bold;">${info.evalRes.autoScore}/10 (Tự chấm)</span>`;
        const actionLabel = info.isGraded ? 'Xem / Sửa điểm' : 'Chấm điểm';

        return `
          <tr>
            <td><b>${escapeHtml(st.student_name)}</b></td>
            <td>${escapeHtml(grp.label)}</td>
            <td>Slide ${grp.slideStart}–${grp.slideEnd}</td>
            <td>${statusHtml}</td>
            <td>${scoreHtml}</td>
            <td>
              <button class="rt-btn ${info.isGraded ? 'rt-btn-primary' : 'rt-btn-orange'}" style="padding:6px 12px; font-size:12.5px;" onclick="PracticeHub.openDetailModal('${st.id}')">
                ${actionLabel}
              </button>
            </td>
          </tr>`;
      }).join('');
    },

    openDetailModal(studentId) {
      const st = this.studentsById[studentId];
      if (!st) return;
      this.currentDetailStudentId = studentId;
      const live = this.liveStatesByStudentId[studentId];
      const grp = GROUP_DEFINITIONS[st.group_code] || GROUP_DEFINITIONS.GROUP_1;
      this.currentDetailSlide = (live && live.current_slide) || st.current_slide || grp.slideStart;

      document.getElementById('rt-detail-modal')?.classList.add('open');
      this.renderDetailModalContent();
      setTimeout(() => this.rescaleAllPreviews(), 50);
    },

    closeDetailModal() {
      this.currentDetailStudentId = null;
      document.getElementById('rt-detail-modal')?.classList.remove('open');
    },

    switchDetailSlide(slideNum) {
      this.currentDetailSlide = slideNum;
      this.renderDetailModalContent();
    },

    renderDetailModalContent() {
      const st = this.studentsById[this.currentDetailStudentId];
      if (!st) return;
      const grp = GROUP_DEFINITIONS[st.group_code] || GROUP_DEFINITIONS.GROUP_1;
      const live = this.liveStatesByStudentId[st.id];
      const sub = this.submissionsByStudentId[st.id];
      const payload = (sub && sub.answers && sub.answers.payload) || (live && live.live_payload) || { group_code: grp.code, current_slide: grp.slideStart, slides: {} };
      const evalRes = evaluatePayload(payload);

      document.getElementById('rt-detail-title').textContent = `Học sinh: ${st.student_name}`;
      document.getElementById('rt-detail-subtitle').textContent = `${grp.title} • Tiến độ: ${(live && live.progress) || st.progress || 0}%`;

      const tabsEl = document.getElementById('rt-detail-slide-tabs');
      tabsEl.innerHTML = grp.indices.map((idx, i) => {
        const sNum = idx + 1;
        const active = sNum === this.currentDetailSlide;
        return `<button class="rt-filter-btn ${active ? 'active' : ''}" onclick="PracticeHub.switchDetailSlide(${sNum})">Câu ${i + 1} (Slide ${sNum})</button>`;
      }).join('');

      const vp = document.getElementById('rt-detail-preview-viewport');
      renderLiveSlidePreview(vp, payload, this.currentDetailSlide);

      const breakdown = document.getElementById('rt-detail-answer-breakdown');
      breakdown.innerHTML = `<b>Chi tiết câu trả lời (Tổng 10 điểm):</b><br/>` + evalRes.details.map(d =>
        `• <b>${escapeHtml(d.label)}:</b> ${escapeHtml(d.studentText)} <span style="color:${d.isExact ? '#15803d' : '#0369a1'}; font-weight:bold;">(${d.score}/${d.max}đ)</span>`
      ).join('<br/>');

      const autoHint = document.getElementById('rt-grade-auto-hint');
      if (autoHint) {
        autoHint.innerHTML = `💡 <b>Điểm hệ thống tự chấm:</b> <b>${evalRes.autoScore}/10</b>` +
          (sub ? `<br/>⏱ Đã nộp lúc: <b>${formatTime(sub.submitted_at)}</b>` : '<br/>⏳ Học sinh đang làm bài.');
      }

      const scoreInput = document.getElementById('rt-grade-score-input');
      const fbInput = document.getElementById('rt-grade-feedback-input');
      if (scoreInput && document.activeElement !== scoreInput) {
        if (sub && sub.grading_status === 'graded' && sub.score != null) scoreInput.value = sub.score;
        else scoreInput.value = evalRes.autoScore;
      }
      if (fbInput && document.activeElement !== fbInput) {
        fbInput.value = (sub && sub.teacher_feedback) || '';
      }
    },

    async saveGradeForCurrentStudent() {
      const st = this.studentsById[this.currentDetailStudentId];
      const msg = document.getElementById('rt-grade-save-msg');
      if (!st || !this.supabase) return;

      const scoreVal = parseFloat(document.getElementById('rt-grade-score-input')?.value);
      const feedback = (document.getElementById('rt-grade-feedback-input')?.value || '').trim();
      if (isNaN(scoreVal) || scoreVal < 0 || scoreVal > 10) {
        if (msg) { msg.style.color = '#dc2626'; msg.textContent = 'Vui lòng nhập điểm hợp lệ từ 0 đến 10.'; }
        return;
      }

      const btn = document.getElementById('rt-grade-save-btn');
      if (btn) btn.disabled = true;
      if (msg) { msg.style.color = '#0284c7'; msg.textContent = 'Đang lưu điểm lên Supabase...'; }

      let sub = this.submissionsByStudentId[st.id];
      const nowIso = new Date().toISOString();
      let savedSub = null;
      let err = null;

      if (sub && sub.id) {
        const res = await this.supabase
          .from('submissions')
          .update({
            score: scoreVal,
            max_score: 10,
            grading_status: 'graded',
            teacher_feedback: feedback,
            graded_at: nowIso,
            updated_at: nowIso
          })
          .eq('id', sub.id)
          .select()
          .single();
        savedSub = res.data;
        err = res.error;
      } else {
        const live = this.liveStatesByStudentId[st.id];
        const res = await this.supabase
          .from('submissions')
          .insert({
            room_id: st.room_id,
            student_id: st.id,
            student_name: st.student_name,
            answers: { payload: (live && live.live_payload) || {} },
            score: scoreVal,
            max_score: 10,
            grading_status: 'graded',
            teacher_feedback: feedback,
            submitted_at: nowIso,
            graded_at: nowIso,
            updated_at: nowIso
          })
          .select()
          .single();
        savedSub = res.data;
        err = res.error;
      }

      if (btn) btn.disabled = false;
      if (err || !savedSub) {
        if (msg) { msg.style.color = '#dc2626'; msg.textContent = 'Lỗi lưu điểm: ' + (err ? err.message : 'Không xác định'); }
        return;
      }

      this.submissionsByStudentId[st.id] = savedSub;
      if (msg) { msg.style.color = '#15803d'; msg.textContent = `✓ Đã lưu ${scoreVal}/10 điểm và gửi thông báo Realtime đến học sinh!`; }

      const room = Object.values(this.activeRooms).find(r => r && r.id === st.room_id);
      if (room && room.room_code) {
        this.broadcastToRoom(room.room_code, 'grade_updated', {
          student_id: st.id,
          room_code: room.room_code,
          graded_at: nowIso
        });
      }

      this.renderMonitorGrids();
      this.renderGradingTable();
      toast(`Đã chấm ${scoreVal}/10 cho ${st.student_name}!`, 'ok');
    }
  };

  window.PracticeHub = PracticeHub;
  window.addEventListener('load', () => {
    PracticeHub.init();
  });
})();
</script>

</body>
</html>
