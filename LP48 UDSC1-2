    .s4-banner-p1 { background: linear-gradient(90deg, #0f766e, #0d9488); }
    .s4-banner-p2 { background: linear-gradient(90deg, #d97706, #ea580c); }
    .s4-banner-p3 { background: linear-gradient(90deg, #0284c7, #2563eb); }
    .s4-banner-p4 { background: linear-gradient(90deg, #6d28d9, #7c3aed); }

    /* BƯỚC 1: Lưới 5 hình (kèm ghi chú Hình vuông) */
    #s4-panel-1 {
      position: relative;
    }

    .s4-shapes-5grid {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
      align-items: stretch;
      min-height: 0;
      position: relative;
    }

    .s4-shape-item-card {
      background: transparent;
      border: 3px solid transparent;
      border-radius: 16px;
      padding: 10px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      text-align: center;
      opacity: 0;
      visibility: hidden;
      box-shadow: none;
      pointer-events: none;
      transition: background 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease, opacity 0.25s ease;
    }

    .s4-shape-item-card.shown-card {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      background: #ffffff;
      border-color: #0d9488;
      box-shadow: 0 6px 16px rgba(13, 148, 136, 0.12);
    }

    .s4-shape-item-card.current-focus {
      border-color: var(--orange-btn);
      box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.2);
    }

    .s4-shape-card-name {
      font-size: 15.5px;
      font-weight: bold;
      color: #0f2942;
      opacity: 0;
      transform: translateY(-6px);
      transition: opacity 0.32s ease, transform 0.32s ease;
