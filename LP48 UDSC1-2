  function checkS5Answer() {
    const anyPicked = s5Selected.some(Boolean);
    const fb = document.getElementById('s5-feedback');
    if (!anyPicked) {
      if (fb) {
        fb.className = 'hdcn-feedback-box fb-warn';
        fb.innerHTML = '⚠️ Em hãy nhấp chọn ít nhất một hình mà em dự đoán có tâm đối xứng trước khi bấm <b>KIỂM TRA</b> nhé!';
      }
      return;
    }
    s5Checked = true;
    slideSteps[4] = Math.max(slideSteps[4], 2);
    renderSlide5();

    let allMatch = true;
    for (let i = 0; i < 7; i++) {
      if (s5Selected[i] !== S5_IS_SYM[i]) {
        allMatch = false;
        break;
      }
    }

    if (fb) {
      if (allMatch) {
        fb.className = 'hdcn-feedback-box fb-success';
        fb.innerHTML = '🎉 <b>Chính xác! Kết luận:</b> Hình có tâm đối xứng là <b>a) Hình tròn, c) Chong chóng 4 cánh, Hình 1 (4 cánh), Hình 3 (6 cánh), Hình 4 (8 cánh)</b> vì khi quay nửa vòng (180°) quanh tâm O, hình thu được trùng khít với hình ban đầu.';
      } else {
        fb.className = 'hdcn-feedback-box fb-warn';
        fb.innerHTML = '💡 <b>Kết quả kiểm tra:</b> Các hình có tâm đối xứng được đánh dấu <b>✓ (kèm tâm O)</b>, hình không có tâm đối xứng đánh dấu <b>✗</b>. Hãy bấm <b>QUAY 180°</b> để quan sát vì sao chong chóng 3 cánh và hoa 5 cánh không trùng khít!';
      }
    }
  }

  function showS5Answer() {
    s5Selected = [...S5_IS_SYM];
    s5Checked = true;
    s5Rotated = true;
    slideSteps[4] = 3;
    renderSlide5();
    const fb = document.getElementById('s5-feedback');
    if (fb) {
      fb.className = 'hdcn-feedback-box fb-success';
      fb.innerHTML = '📌 <b>ĐÁP ÁN & KẾT LUẬN:</b> <b>a) Hình tròn, c) Chong chóng 4 cánh, Hoa 4 cánh, Hoa 6 cánh, Hoa 8 cánh</b> có tâm đối xứng O (quay 180° trùng khít). <b>b) Chong chóng 3 cánh</b> và <b>Hoa 5 cánh</b> không có tâm đối xứng.';
    }
