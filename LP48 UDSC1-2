  /* ==========================================================================
     PHẦN BÀI TẬP LUYỆN TẬP – DỰNG HÌNH ĐỐI XỨNG QUA TÂM O (4 CÂU: SLIDE 14 -> 17)
     ========================================================================== */

  // Hàm tiện ích vẽ đường thẳng nét đứt từ (x1,y1) xuyên qua O đến (x2,y2) bằng requestAnimationFrame
  function animateSvgLine(lineId, x1, y1, x2, y2, duration, onComplete) {
    const line = document.getElementById(lineId);
    if (!line) return null;
    line.style.opacity = '1';
    line.setAttribute('x1', x1);
    line.setAttribute('y1', y1);
    line.setAttribute('x2', x1);
    line.setAttribute('y2', y1);

    const startTime = performance.now();
    let rafId = null;

    function step(now) {
      const t = Math.min(1, (now - startTime) / duration);
      const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      const curX = x1 + (x2 - x1) * ease;
      const curY = y1 + (y2 - y1) * ease;
      line.setAttribute('x2', curX.toFixed(1));
      line.setAttribute('y2', curY.toFixed(1));
      if (t < 1) {
        rafId = requestAnimationFrame(step);
      } else if (typeof onComplete === 'function') {
        onComplete();
      }
    }
    rafId = requestAnimationFrame(step);
    return rafId;
  }

  /* --------------------------------------------------------------------------
     CÂU 1 (SLIDE 14 / 17): HOÀN THIỆN CHỮ N ĐỐI XỨNG QUA TÂM O
     Hệ tọa độ SVG thực tế:
       x = 55 + 80c; y = 30 + 80r; O = (215,190) tương ứng (c,r)=(2,2).
     4 điểm đã cho: (1,0), (1,1), (3,0), (3,1).
     4 ảnh đối xứng chính xác: (3,4), (3,3), (1,4), (1,3).
     3 đoạn mới: (3,3)-(3,4), (3,4)-(1,3), (1,3)-(1,4).
     -------------------------------------------------------------------------- */
  const BTLT1_REQUIRED_TARGETS = [
    { c: 3, r: 4, id: 'btlt1-ans-pt-1', rayId: 'btlt1-ray-1', x1: 135, y1: 30,  x2: 295, y2: 350 },
    { c: 3, r: 3, id: 'btlt1-ans-pt-2', rayId: 'btlt1-ray-2', x1: 135, y1: 110, x2: 295, y2: 270 },
    { c: 1, r: 4, id: 'btlt1-ans-pt-3', rayId: 'btlt1-ray-3', x1: 295, y1: 30,  x2: 135, y2: 350 },
    { c: 1, r: 3, id: 'btlt1-ans-pt-4', rayId: 'btlt1-ray-4', x1: 295, y1: 110, x2: 135, y2: 270 }
  ];

  const BTLT1_REQUIRED_EDGES = [
    [[3, 3], [3, 4]],
    [[3, 4], [1, 3]],
    [[1, 3], [1, 4]]
  ];

  let btlt1PlacedNodes = [];
  let btlt1UserEdges = [];
  let btlt1ActiveNode = null;
  let btlt1Completed = false;
  let btlt1AnswerShown = false;
  let btlt1Timers = [];

  function clearBtlt1Timers() {
    btlt1Timers.forEach(t => clearTimeout(t));
    btlt1Timers = [];
  }

  function btlt1NodeKey(p) {
    return `${p.c},${p.r}`;
  }

  function btlt1EdgeKey(a, b) {
    const ka = btlt1NodeKey(a);
    const kb = btlt1NodeKey(b);
    return [ka, kb].sort().join('|');
  }

  function btlt1AddNodeIfMissing(c, r) {
    if (!btlt1PlacedNodes.some(p => p.c === c && p.r === r)) {
      btlt1PlacedNodes.push({ c, r });
    }
  }

  function btlt1IsGivenOrCenter(c, r) {
    return (c === 2 && r === 2) ||
      (c === 1 && r === 0) || (c === 1 && r === 1) ||
      (c === 3 && r === 0) || (c === 3 && r === 1);
  }

  function renderBtlt1Candidates() {
    const layer = document.getElementById('btlt1-candidates-layer');
    if (!layer) return;
    layer.innerHTML = '';

    const ns = 'http://www.w3.org/2000/svg';

    // Vẽ các đoạn học sinh tự nối trước để các điểm nằm nổi phía trên.
    btlt1UserEdges.forEach(edge => {
      const line = document.createElementNS(ns, 'line');
      line.setAttribute('x1', 55 + edge.a.c * 80);
      line.setAttribute('y1', 30 + edge.a.r * 80);
      line.setAttribute('x2', 55 + edge.b.c * 80);
      line.setAttribute('y2', 30 + edge.b.r * 80);
      line.setAttribute('stroke', btlt1Completed ? '#16a34a' : '#38bdf8');
      line.setAttribute('stroke-width', '6');
      line.setAttribute('stroke-linecap', 'round');
      line.setAttribute('class', btlt1Completed ? 'btlt1-user-edge correct' : 'btlt1-user-edge');
      layer.appendChild(line);
    });

    btlt1PlacedNodes.forEach(pt => {
      const x = 55 + pt.c * 80;
      const y = 30 + pt.r * 80;
      const isActive = btlt1ActiveNode && btlt1ActiveNode.c === pt.c && btlt1ActiveNode.r === pt.r;

      if (isActive) {
        const halo = document.createElementNS(ns, 'circle');
        halo.setAttribute('cx', x);
        halo.setAttribute('cy', y);
        halo.setAttribute('r', '16');
        halo.setAttribute('fill', 'rgba(37,99,235,0.20)');
        layer.appendChild(halo);
      }

      const dot = document.createElementNS(ns, 'circle');
      dot.setAttribute('cx', x);
      dot.setAttribute('cy', y);
      dot.setAttribute('r', isActive ? '10' : '8');
      dot.setAttribute('fill', '#2563eb');
      dot.setAttribute('stroke', '#ffffff');
      dot.setAttribute('stroke-width', isActive ? '3' : '2.2');
      if (btlt1Completed) dot.setAttribute('class', 'nv2-pair-highlight');
      layer.appendChild(dot);
    });
  }

  function btlt1SetFeedback(message, type = 'hint') {
    const fb = document.getElementById('btlt1-feedback');
    if (!fb) return;
    fb.className = `btlt-feedback-box shown fb-${type}`;
    fb.textContent = message;
  }

  function handleBtlt1NodeClick(c, r) {
    if (btlt1Completed || btlt1AnswerShown) return;
    if (c < 0 || c > 5 || r < 0 || r > 4 || btlt1IsGivenOrCenter(c, r)) return;

    const clicked = { c, r };

    // Nhấn lại điểm thứ nhất: hủy lựa chọn; xóa chấm cô lập nếu chưa nối với đoạn nào.
    if (btlt1ActiveNode && btlt1ActiveNode.c === c && btlt1ActiveNode.r === r) {
      const wasUsed = btlt1UserEdges.some(e =>
        btlt1NodeKey(e.a) === btlt1NodeKey(clicked) || btlt1NodeKey(e.b) === btlt1NodeKey(clicked)
      );
      if (!wasUsed) {
        btlt1PlacedNodes = btlt1PlacedNodes.filter(p => btlt1NodeKey(p) !== btlt1NodeKey(clicked));
      }
      btlt1ActiveNode = null;
      renderBtlt1Candidates();
      btlt1SetFeedback('Đã hủy lựa chọn điểm thứ nhất.', 'hint');
      return;
    }

    // Chưa có điểm thứ nhất: chọn và đánh dấu điểm.
    if (!btlt1ActiveNode) {
      btlt1AddNodeIfMissing(c, r);
      btlt1ActiveNode = clicked;
      renderBtlt1Candidates();
      btlt1SetFeedback('Đã chọn điểm thứ nhất. Hãy nhấp vào điểm thứ hai để tạo đoạn thẳng.', 'hint');
      return;
    }

    // Có điểm thứ nhất: nhấp điểm thứ hai để tạo đoạn thẳng.
    const first = btlt1ActiveNode;
    if (btlt1NodeKey(first) === btlt1NodeKey(clicked)) return;

    const key = btlt1EdgeKey(first, clicked);
    const alreadyExists = btlt1UserEdges.some(e => btlt1EdgeKey(e.a, e.b) === key);
    if (alreadyExists) {
      btlt1ActiveNode = null;
      renderBtlt1Candidates();
      btlt1SetFeedback('Hai điểm này đã được nối. Hãy chọn một cặp điểm khác.', 'hint');
      return;
    }

    btlt1AddNodeIfMissing(c, r);
    btlt1UserEdges.push({ a: { ...first }, b: clicked });
    btlt1ActiveNode = null;
    renderBtlt1Candidates();
    btlt1SetFeedback(`Đã tạo đoạn thẳng (${first.c},${first.r}) – (${c},${r}). Em có thể tiếp tục nối các cặp điểm khác.`, 'hint');
  }

  function btlt1SameNodeSet(actual, required) {
    const a = actual.map(btlt1NodeKey).sort();
    const b = required.map(btlt1NodeKey).sort();
    return a.length === b.length && a.every((v, i) => v === b[i]);
  }

  function btlt1RequiredNodeList() {
    return BTLT1_REQUIRED_TARGETS.map(t => ({ c: t.c, r: t.r }));
  }

  function btlt1RequiredEdgeKeys() {
    return BTLT1_REQUIRED_EDGES.map(pair => btlt1EdgeKey(
      { c: pair[0][0], r: pair[0][1] },
      { c: pair[1][0], r: pair[1][1] }
    )).sort();
  }

  function checkBtlt1() {
    if (btlt1Completed || btlt1AnswerShown) return;

    if (btlt1ActiveNode) {
      btlt1SetFeedback('Em đang chọn một điểm. Hãy chọn điểm thứ hai để tạo đoạn thẳng trước khi kiểm tra.', 'hint');
      return;
    }

    const pointsCorrect = btlt1SameNodeSet(btlt1PlacedNodes, btlt1RequiredNodeList());
    const actualEdges = btlt1UserEdges.map(e => btlt1EdgeKey(e.a, e.b)).sort();
    const expectedEdges = btlt1RequiredEdgeKeys();
    const edgesCorrect = actualEdges.length === expectedEdges.length &&
      actualEdges.every((v, i) => v === expectedEdges[i]);

    if (pointsCorrect && edgesCorrect) {
      btlt1Completed = true;
      renderBtlt1Candidates();
      const pill = document.getElementById('btlt1-status-pill');
      if (pill) pill.textContent = 'Chính xác – đã hoàn thiện chữ N';
      btlt1SetFeedback('Chính xác! Em đã hoàn thiện hình có tâm đối xứng O.', 'ok');
    } else {
      btlt1SetFeedback('Chưa chính xác, em hãy kiểm tra lại vị trí các điểm và các đoạn thẳng. Những thao tác đã thực hiện vẫn được giữ nguyên.', 'err');
    }
  }

  function showAnswerBtlt1() {
    if (btlt1AnswerShown) return;
    clearBtlt1Timers();
    btlt1AnswerShown = true;
    btlt1ActiveNode = null;

    // Hiện bốn ảnh điểm đúng và bốn đường nét đứt nối từng cặp qua O.
    BTLT1_REQUIRED_TARGETS.forEach((t, idx) => {
