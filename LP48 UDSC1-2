  /* --------------------------------------------------------------------------
     CÂU 3 (SLIDE 16 / 17): TÌM ĐIỂM ĐỐI XỨNG CỦA ĐIỂM P
     - Hệ lưới 6x4: c = 0..6, r = 0..4
     - Tâm O: (3,2) = (262, 178)
     - Điểm chóp P: (6,0) = (484, 30) (cách O 3 ô sang phải, 2 ô lên trên)
     - Điểm đối xứng P': (0,4) = (40, 326) (cách O 3 ô sang trái, 2 ô xuống dưới)
     -------------------------------------------------------------------------- */
  let btlt3Candidate = null;
  let btlt3Solved = false;
  let btlt3Timer = null;
  let btlt3AnswerShown = false;
  let btlt3AnimationToken = 0;

  // Lưới SVG: x = 40 + 74c; y = 30 + 74r.
  // P=(6,0)=(484,30), O=(3,2)=(262,178), P'=(0,4)=(40,326).
  function handleBtlt3NodeClick(c, r) {
    if (btlt3Solved || btlt3AnswerShown) return;
    if ((c === 3 && r === 2) || (c === 6 && r === 0)) return;

    btlt3Candidate = { c, r };
    const x = 40 + c * 74;
    const y = 30 + r * 74;
    const marker = document.getElementById('btlt3-cand-marker');
    if (marker) {
      marker.style.display = 'block';
      document.getElementById('btlt3-cand-pulse')?.setAttribute('cx', x);
      document.getElementById('btlt3-cand-pulse')?.setAttribute('cy', y);
      document.getElementById('btlt3-cand-dot')?.setAttribute('cx', x);
      document.getElementById('btlt3-cand-dot')?.setAttribute('cy', y);
    }
    // Việc chọn điểm chỉ đổi dấu chấm dự đoán, không tạo đường hay đáp án.
    const fb = document.getElementById('btlt3-feedback');
    if (fb) { fb.className = 'btlt-feedback-box'; fb.textContent = ''; }
  }

  function btlt3DrawProofLines() {
    const token = ++btlt3AnimationToken;
    const first = document.getElementById('btlt3-line-po');
    const second = document.getElementById('btlt3-line-op2');
    [first, second].forEach(line => {
      if (line) { line.style.opacity = '0'; line.setAttribute('x2', line.getAttribute('x1')); line.setAttribute('y2', line.getAttribute('y1')); }
    });
    document.getElementById('btlt3-equal-ticks')?.style.setProperty('opacity', '0');
    // P -> O, sau đó O -> P'.
    animateSvgLine('btlt3-line-po', 484, 30, 262, 178, 650, () => {
      if (token !== btlt3AnimationToken) return;
      animateSvgLine('btlt3-line-op2', 262, 178, 40, 326, 650, () => {
        if (token !== btlt3AnimationToken) return;
        document.getElementById('btlt3-equal-ticks')?.style.setProperty('opacity', '1');
        document.getElementById('btlt3-equality-note')?.classList.add('shown');
        document.getElementById('btlt3-point-o')?.classList.add('btlt3-o-emphasis');
      });
    });
  }

  function checkBtlt3() {
    const fb = document.getElementById('btlt3-feedback');
    if (btlt3Solved || btlt3AnswerShown) return;
    if (!btlt3Candidate) {
      if (fb) {
        fb.className = 'btlt-feedback-box shown fb-hint';
        fb.textContent = 'Em hãy chọn một giao điểm trên lưới trước khi nhấn KIỂM TRA.';
      }
      return;
    }
    if (btlt3Candidate.c === 0 && btlt3Candidate.r === 4) {
      btlt3Solved = true;
      if (fb) {
        fb.className = 'btlt-feedback-box shown fb-ok';
        fb.textContent = "Chính xác! Em đã tìm được điểm P' đối xứng với P qua tâm O.";
      }
      // Giữ nguyên dấu chấm xanh đúng tại vị trí học sinh đã chọn.
      btlt3DrawProofLines();
    } else {
      if (fb) {
        fb.className = 'btlt-feedback-box shown fb-err';
        fb.textContent = 'Chưa chính xác! Em hãy kiểm tra lại hướng và khoảng cách từ O đến P.';
      }
      // Giữ nguyên dự đoán sai; không hé lộ P' hoặc các đoạn đáp án.
    }
  }

  function showAnswerBtlt3() {
    clearTimeout(btlt3Timer);
    btlt3AnswerShown = true;
    btlt3Solved = true;
    const marker = document.getElementById('btlt3-cand-marker');
    if (marker) marker.style.display = 'none';
    document.getElementById('btlt3-ans-pp')?.classList.add('shown');
    btlt3DrawProofLines();
    document.getElementById('btlt3-conclusion')?.classList.add('shown');
    const fb = document.getElementById('btlt3-feedback');
    if (fb) {
      fb.className = 'btlt-feedback-box shown fb-ok';
      fb.innerHTML = "<b>Đáp án:</b> P' nằm tại giao điểm cột 0, hàng 4 (góc dưới bên trái).";
    }
  }

