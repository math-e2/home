  function resetCurrentSlide3Activity() {
    s3ActStep[s3CurrentAct] = 0;
    s3UserGuessPos[s3CurrentAct] = null;
    const rotEl = document.getElementById(`s3-rot-${s3CurrentAct}`);
    if (rotEl) {
      rotEl.style.transition = 'none';
      rotEl.style.transform = 'rotate(0deg)';
      if (s3CurrentAct === 2) {
        document.querySelectorAll('#s3-svg-2 .s3-rhom-upright-label').forEach(lbl => {
          lbl.style.transition = 'none';
          lbl.style.transform = 'rotate(0deg)';
        });
      }
      setTimeout(() => {
        rotEl.style.transition = 'transform 1.45s cubic-bezier(0.34, 1.08, 0.64, 1)';
        if (s3CurrentAct === 2) {
          document.querySelectorAll('#s3-svg-2 .s3-rhom-upright-label').forEach(lbl => {
            lbl.style.transition = 'transform 1.45s cubic-bezier(0.34, 1.08, 0.64, 1)';
          });
        }
      }, 40);
    }
    renderSlide3Explore();
  }

  function resetAllSlide3Activities() {
    clearSlide3SummaryTimers();
    s3SummaryMode = false;
    const slideEl = document.getElementById('slide-2');
    slideEl.classList.remove('s3-fading-out', 's3-summary-active');
    s3CurrentAct = 0;
    s3ActStep = [0, 0, 0, 0];
    s3ActCompleted = [false, false, false, false];
    s3UserGuessPos = [null, null, null, null];
    for (let i = 0; i < 4; i++) {
      const rotEl = document.getElementById(`s3-rot-${i}`);
