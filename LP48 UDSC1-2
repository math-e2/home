  function resetS5Slide() {
    s5Selected = [false, false, false, false, false, false, false];
    s5Checked = false;
    s5Rotated = false;
    slideSteps[4] = 0;
    for (let i = 0; i < 7; i++) {
      const rotEl = document.getElementById(`s5-rot-${i}`);
      if (rotEl) {
        rotEl.style.transition = 'none';
        rotEl.style.transform = 'rotate(0deg)';
        setTimeout(() => {
          rotEl.style.transition = 'transform 1.25s cubic-bezier(0.34, 1.08, 0.64, 1)';
        }, 40);
      }
    }
    renderSlide5();
    const fb = document.getElementById('s5-feedback');
    if (fb) {
      fb.className = 'hdcn-feedback-box';
      fb.innerHTML = 'Quan sát 7 hình trên, dự đoán và nhấp chọn những hình có tâm đối xứng (viền xanh), sau đó nhấn <b>KIỂM TRA</b> hoặc <b>QUAY 180°</b>.';
    }
  }

  function renderSlide5() {
    const pill = document.getElementById('s5-angle-pill');
    if (pill) pill.textContent = s5Rotated ? 'Góc quay: 180°' : 'Góc quay: 0°';

    for (let i = 0; i < 7; i++) {
      const card = document.getElementById(`s5-card-${i}`);
      const chk = document.getElementById(`s5-chk-${i}`);
      const badge = document.getElementById(`s5-badge-${i}`);
      const rotEl = document.getElementById(`s5-rot-${i}`);
      const ghostEl = document.getElementById(`s5-ghost-${i}`);
      const oEl = document.getElementById(`s5-o-${i}`);

      if (!card) continue;
      card.classList.remove('selected-item', 'checked-sym', 'checked-nonsym');
      if (s5Selected[i]) card.classList.add('selected-item');
      if (chk) chk.textContent = s5Selected[i] ? '✓' : '';

      if (rotEl) rotEl.style.transform = s5Rotated ? 'rotate(180deg)' : 'rotate(0deg)';
      if (ghostEl) ghostEl.classList.toggle('visible', s5Rotated);

      if (s5Checked) {
        if (S5_IS_SYM[i]) {
          card.classList.add('checked-sym');
          if (badge) {
            badge.className = 'hdcn-status-badge show-sym';
            badge.textContent = '✓ Có tâm O';
          }
          if (oEl) oEl.classList.add('visible');
        } else {
          card.classList.add('checked-nonsym');
          if (badge) {
            badge.className = 'hdcn-status-badge show-nonsym';
            badge.textContent = '✗ Không có';
          }
          if (oEl) oEl.classList.remove('visible');
        }
      } else {
        if (badge) {
          badge.className = 'hdcn-status-badge';
          badge.textContent = '';
        }
        if (oEl) oEl.classList.remove('visible');
      }
    }
  }

  // -------------------- SLIDE 6 (CÂU 2: 6 HÌNH GHÉP & ĐA GIÁC) --------------------
  const S6_IS_SYM = [true, true, true, true, false, true];
  const S6_TITLES = [
    'a) Hai đường tròn',
    'b) Chong chóng',
    'c) Hình 6 ô vuông',
    'd) Lục giác đều',
    'e) Hình thang cân',
    'f) Ngôi sao 4 cánh'
  ];
  const S6_O_DESC = [
    'a) Hai đường tròn (O là trung điểm đoạn nối hai tâm)',
    'b) Chong chóng (O là đỉnh chung chính giữa)',
    'c) Hình 6 ô vuông (O là tâm cấu trúc hình ghép)',
    'd) Lục giác đều (O là giao điểm các đường chéo chính)',
    'e) Hình thang cân — Hình không có tâm đối xứng',
    'f) Ngôi sao 4 cánh (O là tâm của hình)'
  ];

  // Trạng thái tương tác của học sinh trên từng hình trước khi kiểm tra
  let s6State = [
    { selected: false, hasPoint: false, x: 100, y: 100 },
    { selected: false, hasPoint: false, x: 100, y: 100 },
    { selected: false, hasPoint: false, x: 100, y: 100 },
    { selected: false, hasPoint: false, x: 100, y: 100 },
    { selected: false, hasPoint: false, x: 100, y: 100 },
    { selected: false, hasPoint: false, x: 100, y: 100 }
  ];
  let s6Checked = false;
  let s6Rotated = false;
  let s6IndRotated = [false, false, false, false, false, false];
  let s6RevealTimers = [];
  // Trạng thái hiển thị từng phần tử trong chuỗi animation khi nhấn KIỂM TRA
  let s6RevealedPoint = [false, false, false, false, false, false];
  let s6RevealedLabel = [false, false, false, false, false, false];
  let s6RevealedLines = [false, false, false, false, false, false];
  let s6RevealedNoSym = false;

  function clearS6Timers() {
    s6RevealTimers.forEach(t => clearTimeout(t));
    s6RevealTimers = [];
  }

  function handleS6CardClick(evt, idx) {
    // Nếu đã hiện đáp án và người dùng nhấp vào thẻ hình có tâm đối xứng -> cho phép quay kiểm chứng 180° quanh O
    if (s6Checked) {
      if (S6_IS_SYM[idx]) {
        s6IndRotated[idx] = !s6IndRotated[idx];
        renderSlide6();
      } else {
        const banner = document.getElementById('s6-banner-text');
        if (banner) {
          banner.innerHTML = '💡 <b>Giải thích (Hình e – Hình thang cân):</b> Đáy nhỏ ở trên và đáy lớn ở dưới không bằng nhau nên không có điểm O nào làm tâm quay 180° để hình trùng khít với chính nó.';
        }
      }
      return;
    }
    s6State[idx].selected = !s6State[idx].selected;
    renderSlide6();
  }

  function handleS6SvgClick(evt, idx) {
    evt.stopPropagation();
    // Sau khi đã hiện đáp án: nhấp vào hình có tâm O sẽ quay 180° hình đó quanh tâm O; hình thang cân không quay mà hiện giải thích
    if (s6Checked) {
      if (S6_IS_SYM[idx]) {
        s6IndRotated[idx] = !s6IndRotated[idx];
        renderSlide6();
      } else {
        const banner = document.getElementById('s6-banner-text');
        if (banner) {
          banner.innerHTML = '💡 <b>Giải thích (Hình e – Hình thang cân):</b> Đáy nhỏ và đáy lớn không bằng nhau nên hình thang cân không có tâm đối xứng O (không thực hiện phép quay kiểm chứng).';
        }
      }
      return;
    }

    // Trước khi nhấn KIỂM TRA: cho phép học sinh nhấp chọn thẻ / đánh dấu vị trí dự đoán mà không tiết lộ đúng/sai hay chữ O
    const svgEl = document.getElementById(`s6-svg-${idx}`);
    if (!svgEl) return;
    const rect = svgEl.getBoundingClientRect();
    const x = Math.round(((evt.clientX - rect.left) / rect.width) * 200);
    const y = Math.round(((evt.clientY - rect.top) / rect.height) * 200);

    if (s6State[idx].selected && s6State[idx].hasPoint && Math.hypot(x - s6State[idx].x, y - s6State[idx].y) < 16) {
      // Nhấp lại vào điểm vừa đặt để bỏ chọn
      s6State[idx].selected = false;
      s6State[idx].hasPoint = false;
    } else {
      s6State[idx].selected = true;
      s6State[idx].hasPoint = true;
      s6State[idx].x = Math.max(20, Math.min(180, x));
      s6State[idx].y = Math.max(20, Math.min(180, y));
    }
    renderSlide6();
  }

  function rotateS6Shapes() {
    s6Rotated = !s6Rotated;
    // Đồng bộ góc quay 180° cho các hình có tâm đối xứng; Hình e (Hình thang cân) không có tâm O nên không quay quanh tâm đối xứng
    for (let i = 0; i < 6; i++) {
      s6IndRotated[i] = S6_IS_SYM[i] ? s6Rotated : false;
    }
    slideSteps[5] = Math.max(slideSteps[5], 1);
    renderSlide6();

    const banner = document.getElementById('s6-banner-text');
    if (banner) {
      if (s6Rotated) {
        banner.innerHTML = '↻ <b>Kiểm chứng quay 180° quanh tâm O:</b> Các hình <b>a, b, c, d, f</b> trùng khít hoàn toàn với hình ban đầu. Riêng <b>e) Hình thang cân</b> không có tâm đối xứng O nên không có phép quay tâm O làm hình trùng khít!';
      } else {
        banner.innerHTML = 'Quan sát các hình gồm đường tròn giao nhau, chong chóng, các hình ghép và đa giác. Hãy chỉ ra tâm đối xứng nếu có, rồi kiểm tra bằng phép quay nửa vòng.';
      }
    }
  }

  /* Khi nhấn nút KIỂM TRA:
     1. Các điểm O màu đỏ/cam lần lượt xuất hiện tại đúng tâm hình học với hiệu ứng phóng to nhẹ.
     2. Chữ O hiện ngay cạnh từng điểm, kèm các đường nối đối xứng qua O.
     3. Hình e (Hình thang cân) không hiện điểm O và xuất hiện thông báo riêng: "Hình không có tâm đối xứng".
  */
  function checkS6Answer() {
    clearS6Timers();
    s6Checked = true;
    s6RevealedPoint = [false, false, false, false, false, false];
    s6RevealedLabel = [false, false, false, false, false, false];
    s6RevealedLines = [false, false, false, false, false, false];
    s6RevealedNoSym = false;
    slideSteps[5] = Math.max(slideSteps[5], 2);
    renderSlide6();

    const symIndices = [0, 1, 2, 3, 5];
    symIndices.forEach((shapeIdx, order) => {
      const baseDelay = order * 260;
      // 1. Điểm O xuất hiện với hiệu ứng phóng to nhẹ + đường nối đối xứng qua O
      s6RevealTimers.push(setTimeout(() => {
        s6RevealedPoint[shapeIdx] = true;
        s6RevealedLines[shapeIdx] = true;
        renderSlide6();
      }, baseDelay + 60));

      // 2. Chữ O hiện ngay cạnh điểm đánh dấu
      s6RevealTimers.push(setTimeout(() => {
        s6RevealedLabel[shapeIdx] = true;
        renderSlide6();
      }, baseDelay + 210));
    });

    // 3. Hình không có tâm đối xứng (Hình e) xuất hiện thông báo riêng: "Hình không có tâm đối xứng"
    const noSymDelay = symIndices.length * 260 + 120;
    s6RevealTimers.push(setTimeout(() => {
      s6RevealedNoSym = true;
      renderSlide6();
      const banner = document.getElementById('s6-banner-text');
      if (banner) {
        banner.innerHTML = '✓ <b>Kết quả kiểm tra:</b> Các hình <b>a, b, c, d, f</b> có tâm đối xứng <b>O</b>. Hình <b>e) Hình thang cân</b> không có tâm đối xứng. Em có thể nhấn vào từng hình hoặc bấm <b>QUAY 180°</b> để kiểm chứng!';
      }
    }, noSymDelay));
  }

  /* Nút HIỆN ĐÁP ÁN: Hiện đầy đủ vị trí O và kết luận của cả 6 hình */
  function showS6Answer() {
    clearS6Timers();
    s6Checked = true;
    s6Rotated = true;
    for (let i = 0; i < 6; i++) {
      s6RevealedPoint[i] = S6_IS_SYM[i];
      s6RevealedLabel[i] = S6_IS_SYM[i];
      s6RevealedLines[i] = S6_IS_SYM[i];
