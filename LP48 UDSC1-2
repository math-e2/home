    initSupabaseClient() {
      const cfg = getEffectiveConfig();
      const pill = document.getElementById('rt-sb-status-pill');
      const urlInput = document.getElementById('rt-cfg-url');
      const keyInput = document.getElementById('rt-cfg-key');
      if (urlInput && !urlInput.value && cfg.url) urlInput.value = cfg.url;
      if (keyInput && !keyInput.value && cfg.anonKey) keyInput.value = cfg.anonKey;

      if (!window.supabase || !cfg.url || !cfg.anonKey) {
        this.supabase = null;
        if (pill) {
          pill.className = 'rt-pill rt-pill-red';
          pill.textContent = 'Supabase: Chưa cấu hình URL/Anon Key';
        }
        return false;
      }

      try {
        this.supabase = window.supabase.createClient(cfg.url, cfg.anonKey, {
          auth: { persistSession: true, autoRefreshToken: true }
        });
        if (pill) {
          pill.className = 'rt-pill rt-pill-green';
          pill.textContent = 'Supabase: Đã kết nối';
        }
        return true;
      } catch (err) {
        this.supabase = null;
        if (pill) {
          pill.className = 'rt-pill rt-pill-red';
          pill.textContent = 'Supabase: Lỗi cấu hình';
        }
        return false;
      }
    },

    saveSupabaseConfigFromUI() {
      const url = (document.getElementById('rt-cfg-url')?.value || '').trim();
      const anonKey = (document.getElementById('rt-cfg-key')?.value || '').trim();
      const msg = document.getElementById('rt-cfg-msg');
      if (!url || !anonKey) {
        if (msg) { msg.style.color = '#dc2626'; msg.textContent = 'Vui lòng nhập đầy đủ Project URL và Anon Key.'; }
        return;
      }
      localStorage.setItem(STORAGE_CFG_KEY, JSON.stringify({ url, anonKey }));
      const ok = this.initSupabaseClient();
      if (msg) {
        msg.style.color = ok ? '#15803d' : '#dc2626';
        msg.textContent = ok ? '✓ Đã lưu và kết nối Supabase thành công!' : '✗ Không thể khởi tạo Supabase Client.';
      }
      if (ok) this.restoreTeacherAuth();
    },

    getMaxAllowedSlideNumForStudent() {
      if (!this.studentSession) return 5;
      const grp = GROUP_DEFINITIONS[this.studentSession.room.group_code];
      const slides = grp.indices.map(i => i + 1);
      // Mở khóa tuần tự: Câu 1 luôn mở; Câu k chỉ mở khi Câu 1..(k-1) đều đã nộp đúng
      let maxAllowed = slides[0];
      for (let i = 0; i < slides.length - 1; i++) {
        if (this.studentPassedSlides[slides[i]]) {
          maxAllowed = slides[i + 1];
        } else {
          break;
        }
      }
      return maxAllowed;
    },

    installNonDestructiveHooks() {
      const self = this;

      const origGoToSlide = window.goToSlide;
      if (typeof origGoToSlide === 'function') {
        window.goToSlide = function (index) {
          if (self.mode === 'student' && self.studentSession) {
            const grp = GROUP_DEFINITIONS[self.studentSession.room.group_code];
            const minIdx = grp.slideStart - 1;
            const maxUnlockedIdx = self.getMaxAllowedSlideNumForStudent() - 1;
            if (index < minIdx) index = minIdx;
            if (index > maxUnlockedIdx) {
              toast('🔒 Em cần nộp đúng câu hiện tại trước khi chuyển sang câu tiếp theo!', 'warn');
              index = maxUnlockedIdx;
            }
          }
          origGoToSlide.call(this, index);
          if (self.mode === 'student' && self.studentSession) {
            self.updateStudentSlideNavUI();
            self.scheduleLiveSync('slide_change');
          }
        };
      }

      const hookFnNames = [
        'toggleS5Item', 'rotateS5Shapes', 'checkS5Answer', 'showS5Answer', 'resetS5Slide',
        'handleS6CardClick', 'handleS6SvgClick', 'rotateS6Shapes', 'checkS6Answer', 'showS6Answer', 'resetS6Slide',
        'toggleS7Item', 'rotateS7Shapes', 'checkS7Answer', 'showS7Answer', 'resetS7Slide',
        'toggleS8Item', 'rotateS8Shapes', 'checkS8Answer', 'showS8Answer', 'resetS8Slide',
        'toggleS9Item', 'rotateS9Shapes', 'checkS9Answer', 'showS9Answer', 'resetS9Slide',
        'handleBtlt1NodeClick', 'checkBtlt1', 'showAnswerBtlt1', 'resetBtlt1',
        'handleBtlt2CellClick', 'checkBtlt2', 'showAnswerBtlt2', 'resetBtlt2',
        'handleBtlt3NodeClick', 'checkBtlt3', 'showAnswerBtlt3', 'resetBtlt3'
      ];

      hookFnNames.forEach(fnName => {
        const orig = window[fnName];
        if (typeof orig === 'function') {
          window[fnName] = function () {
            const res = orig.apply(this, arguments);
            if (self.mode === 'student' && self.studentSession) {
              self.scheduleLiveSync(fnName);
            }
            return res;
          };
        }
      });
    },

    // ========================================================================
    // LUỒNG HỌC SINH: NỘP TỪNG CÂU -> CHẤM ĐIỂM -> ÂM THANH -> MỞ KHÓA CÂU TIẾP
    // ========================================================================
    async submitCurrentQuestion(slideNum) {
      if (!this.studentSession) return;
      const groupCode = this.studentSession.room.group_code;
      const grp = GROUP_DEFINITIONS[groupCode];
      const qIndex = grp.indices.indexOf(slideNum - 1) + 1;
      const payload = captureGroupPayload(groupCode, this.studentPassedSlides);
      const qEval = evaluateSingleSlide(payload, slideNum);
      const fbEl = document.getElementById(`rt-q-fb-${slideNum}`);
      const nextBtn = document.getElementById(`rt-q-next-btn-${slideNum}`);

      if (!qEval.hasSelection) {
        playWrongSound();
        if (fbEl) {
          fbEl.className = 'rt-st-q-feedback shown err';
          fbEl.innerHTML = `⚠️ Em chưa chọn/thao tác đáp án cho <b>Câu ${qIndex}</b>. Hãy hoàn thành bài trước khi nộp!`;
        }
        toast(`Chưa có đáp án cho Câu ${qIndex}!`, 'warn');
        return;
      }

      if (!qEval.isExact) {
        // SAI: Phát âm thanh cảnh báo, giữ khóa Câu tiếp theo, cho phép học sinh sửa và nộp lại
        playWrongSound();
        if (fbEl) {
          fbEl.className = 'rt-st-q-feedback shown err';
          fbEl.innerHTML = `❌ <b>Chưa đúng hết đáp án Câu ${qIndex}!</b> (Điểm tạm tính câu này: ${qEval.score}/${qEval.max}đ). Em hãy kiểm tra và chỉnh sửa lại nhé!`;
        }
        if (nextBtn) nextBtn.classList.remove('rt-unlocked');
        await this.syncLiveStateNow(`submit_q${qIndex}_wrong`);
        return;
      }

      // ĐÚNG 100%: Phát âm thanh đúng, mở khóa nút "CÂU TIẾP THEO ▶", cập nhật điểm Realtime
      playCorrectSound();
      this.studentPassedSlides[slideNum] = true;

      if (fbEl) {
        fbEl.className = 'rt-st-q-feedback shown ok';
        fbEl.innerHTML = `🎉 <b>Chính xác!</b> Em đạt trọn vẹn <b>${qEval.max}/${qEval.max} điểm</b> cho Câu ${qIndex}. Hãy bấm <b>CÂU TIẾP THEO ▶</b>!`;
      }
      if (nextBtn) {
        nextBtn.classList.add('rt-unlocked');
      }

      this.updateStudentSlideNavUI();

      // Tính tổng điểm hiện tại trên thang 10 và đồng bộ ngay về giáo viên
      const updatedPayload = captureGroupPayload(groupCode, this.studentPassedSlides);
      const fullEval = evaluatePayload(updatedPayload);
      this.updateStudentScorePill(fullEval.autoScore);

      await this.syncLiveStateNow(`submit_q${qIndex}_passed`);

      // Nếu đã hoàn thành đúng tất cả các câu trong nhóm -> tự động lưu bài nộp chính thức lên Supabase
      if (fullEval.allPassed) {
        await this.submitStudentWork(false);
      }
    },

    updateStudentScorePill(scoreVal) {
      const badge = document.getElementById('rt-st-grade-badge');
      if (!badge) return;
      const sub = this.studentSession && this.studentSession.submission;
      if (sub && sub.grading_status === 'graded' && sub.graded_at) {
        badge.className = 'rt-pill rt-pill-green';
        badge.textContent = `✓ Đã được chấm điểm: ${sub.score}/${sub.max_score || 10}`;
      } else {
        badge.className = 'rt-pill rt-pill-amber';
        badge.textContent = `Điểm tự chấm: ${scoreVal} / 10`;
      }
    },

    async startStudentFlow(roomCode) {
      const teacherBtn = document.getElementById('btn-open-teacher-hub');
      if (teacherBtn) teacherBtn.style.display = 'none';

      const overlay = document.getElementById('rt-student-join-overlay');
      const infoBox = document.getElementById('rt-join-room-info');
      const formArea = document.getElementById('rt-join-form-area');
      const blockedArea = document.getElementById('rt-join-blocked-area');
      if (overlay) overlay.classList.add('open');

      if (!this.supabase) {
        if (infoBox) infoBox.innerHTML = '⚠️ <b>Chưa cấu hình Supabase</b> trong file bài giảng.';
        if (blockedArea) {
          blockedArea.style.display = 'block';
          blockedArea.textContent = 'Giáo viên cần điền SUPABASE_URL và SUPABASE_ANON_KEY vào file HTML trước khi chia sẻ link cho học sinh.';
        }
        return;
      }

      const { data, error } = await this.supabase.rpc('get_room_public_info', { p_room_code: roomCode });
      if (error || !data || !data.found) {
        if (infoBox) infoBox.innerHTML = `Mã phòng: <b>${escapeHtml(roomCode)}</b>`;
        if (blockedArea) {
          blockedArea.style.display = 'block';
          blockedArea.textContent = (data && data.error) || 'Không tìm thấy phòng luyện tập hoặc link không hợp lệ.';
        }
        return;
      }

      const grp = GROUP_DEFINITIONS[data.group_code] || GROUP_DEFINITIONS.GROUP_1;
      this._pendingRoomInfo = data;

      if (infoBox) {
        infoBox.innerHTML = `
          <div><b>Phòng:</b> ${escapeHtml(data.room_code)} ${data.class_name ? `• <b>Lớp:</b> ${escapeHtml(data.class_name)}` : ''}</div>
          <div><b>Nhóm bài tập:</b> ${escapeHtml(grp.title)}</div>
          <div><b>Sĩ số hiện tại:</b> ${data.current_count} / ${data.max_students} học sinh • <b>Trạng thái:</b> ${data.status === 'open' ? '<span style="color:#15803d;">Đang mở</span>' : '<span style="color:#dc2626;">Đã đóng</span>'}</div>
        `;
      }

      const savedKey = `udsc_student_${data.room_code.toUpperCase()}`;
      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(savedKey) || 'null'); } catch (_) {}

      if (saved && saved.student_name && saved.student_token) {
        await this.completeStudentJoin(data.room_code, saved.student_name, saved.student_token);
        return;
      }

      if (data.status !== 'open') {
        if (blockedArea) {
          blockedArea.style.display = 'block';
          blockedArea.textContent = 'Phòng luyện tập này đã được giáo viên đóng. Không thể tham gia mới.';
        }
        return;
      }

      if (data.current_count >= data.max_students) {
        if (blockedArea) {
          blockedArea.style.display = 'block';
          blockedArea.textContent = `Nhóm này đã đủ tối đa ${data.max_students} học sinh. Vui lòng liên hệ giáo viên.`;
        }
        return;
      }

      if (formArea) formArea.style.display = 'flex';
      const input = document.getElementById('rt-student-name-input');
      if (input) {
        input.focus();
        input.onkeydown = (ev) => { if (ev.key === 'Enter') this.joinRoomAsStudent(); };
      }
    },

    async joinRoomAsStudent() {
      getAudioCtx(); // Kích hoạt AudioContext khi người dùng nhấn nút
      const nameInput = document.getElementById('rt-student-name-input');
      const errBox = document.getElementById('rt-join-error');
      const btn = document.getElementById('rt-join-submit-btn');
      const studentName = (nameInput?.value || '').trim();
      if (!studentName) {
        if (errBox) { errBox.style.display = 'block'; errBox.textContent = 'Vui lòng nhập họ và tên của em.'; }
        return;
      }
      if (errBox) errBox.style.display = 'none';
      if (btn) btn.disabled = true;

      const roomCode = this._pendingRoomInfo.room_code;
      await this.completeStudentJoin(roomCode, studentName, null);
      if (btn) btn.disabled = false;
    },

    async completeStudentJoin(roomCode, studentName, existingToken) {
      const errBox = document.getElementById('rt-join-error');
      const blockedArea = document.getElementById('rt-join-blocked-area');
      const { data, error } = await this.supabase.rpc('join_practice_room', {
        p_room_code: roomCode,
        p_student_name: studentName,
        p_student_token: existingToken
      });

      if (error || !data || !data.ok) {
        const msg = (data && data.error) || (error && error.message) || 'Không thể tham gia phòng.';
        if (errBox) { errBox.style.display = 'block'; errBox.textContent = msg; }
        else if (blockedArea) { blockedArea.style.display = 'block'; blockedArea.textContent = msg; }
        return;
      }

      this.studentSession = {
        room: data.room,
        student: data.student,
        token: data.student.student_token,
        submission: data.submission || null
      };

      const savedKey = `udsc_student_${data.room.room_code.toUpperCase()}`;
      localStorage.setItem(savedKey, JSON.stringify({
        student_id: data.student.id,
        student_name: data.student.student_name,
        student_token: data.student.student_token
      }));

      document.getElementById('rt-student-join-overlay')?.classList.remove('open');

      // Khôi phục tiến độ và các câu đã vượt qua trước đó nếu tải lại trang
      this.studentPassedSlides = {};
      if (data.live_state && data.live_state.live_payload) {
        const lp = data.live_state.live_payload;
        if (lp.passed_slides && typeof lp.passed_slides === 'object') {
          this.studentPassedSlides = { ...lp.passed_slides };
        }
        restoreGroupPayloadToStudentUI(lp);
        // Mở lại nút Câu tiếp theo cho những câu đã passed
        Object.keys(this.studentPassedSlides).forEach(sn => {
          if (this.studentPassedSlides[sn]) {
            document.getElementById(`rt-q-next-btn-${sn}`)?.classList.add('rt-unlocked');
          }
        });
      }

      this.setupStudentTopBar();
      const maxAllowed = this.getMaxAllowedSlideNumForStudent();
      const savedSlide = data.student.current_slide || data.room.slide_start;
      const targetSlide = Math.max(data.room.slide_start, Math.min(maxAllowed, savedSlide));
      window.goToSlide(targetSlide - 1);

      const curPayload = captureGroupPayload(data.room.group_code, this.studentPassedSlides);
      const curEval = evaluatePayload(curPayload);
      this.updateStudentScorePill(curEval.autoScore);

      if (data.submission) {
        this.applyStudentSubmissionUI(data.submission, false);
      }

      this.subscribeStudentRealtime();
      this.syncLiveStateNow('joined_and_started');

      if (this.studentHeartbeatTimer) clearInterval(this.studentHeartbeatTimer);
      this.studentHeartbeatTimer = setInterval(() => {
        if (navigator.onLine && this.studentSession) {
          this.syncLiveStateNow('heartbeat');
        }
      }, 20000);
    },

    setupStudentTopBar() {
      const bar = document.getElementById('rt-student-topbar');
      if (!bar || !this.studentSession) return;
      const grp = GROUP_DEFINITIONS[this.studentSession.room.group_code];
      bar.classList.add('active');
      document.getElementById('rt-st-name-label').textContent = this.studentSession.student.student_name;
      document.getElementById('rt-st-group-label').textContent = `${grp.label} (Slide ${grp.slideStart}–${grp.slideEnd})`;

      const nav = document.getElementById('rt-st-slide-nav');
      nav.innerHTML = grp.indices.map((idx, i) => {
        const sNum = idx + 1;
        const pts = grp.weights[sNum];
        return `<button class="rt-st-slide-btn" data-slide-idx="${idx}" data-slide-num="${sNum}" onclick="goToSlide(${idx})">Câu ${i + 1} (${pts}đ)</button>`;
      }).join('');
      this.updateStudentSlideNavUI();
    },

    updateStudentSlideNavUI() {
      const maxAllowed = this.getMaxAllowedSlideNumForStudent();
      document.querySelectorAll('#rt-st-slide-nav .rt-st-slide-btn').forEach(btn => {
        const idx = Number(btn.getAttribute('data-slide-idx'));
        const sNum = Number(btn.getAttribute('data-slide-num'));
        const isPassed = !!this.studentPassedSlides[sNum];
        const isLocked = sNum > maxAllowed;
        btn.classList.toggle('active', idx === currentSlide);
        btn.classList.toggle('passed', isPassed);
        btn.classList.toggle('locked', isLocked);
      });
    },

    setStudentConnDot(state) {
      const dot = document.getElementById('rt-st-conn-dot');
      if (!dot) return;
      dot.className = 'rt-dot ' + (state === 'online' ? 'rt-dot-online' : state === 'offline' ? 'rt-dot-offline' : 'rt-dot-warn');
    },

    subscribeStudentRealtime() {
      if (!this.supabase || !this.studentSession) return;
      if (this.studentChannel) {
        this.supabase.removeChannel(this.studentChannel);
        this.studentChannel = null;
      }
      const roomCode = this.studentSession.room.room_code.toUpperCase();
      const myStudentId = this.studentSession.student.id;

      this.studentChannel = this.supabase
        .channel(`room-live-${roomCode}`, { config: { broadcast: { self: false } } })
        .on('broadcast', { event: 'grade_updated' }, ({ payload }) => {
          if (payload && payload.student_id === myStudentId) {
            this.fetchMySubmissionResult(true);
          }
        })
        .on('broadcast', { event: 'room_closed' }, () => {
          toast('Giáo viên đã đóng phòng luyện tập.', 'warn');
          this.fetchMySubmissionResult(false);
        })
        .subscribe((status) => {
          if (status === 'SUBSCRIBED') this.setStudentConnDot('online');
          else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') this.setStudentConnDot('offline');
        });
    },

    scheduleLiveSync(reason) {
      if (!this.studentSession) return;
      clearTimeout(this.studentSyncTimer);
      this.studentSyncTimer = setTimeout(() => {
        this.syncLiveStateNow(reason);
      }, 220);
    },

    async syncLiveStateNow(reason) {
      if (!this.supabase || !this.studentSession) return;
      const groupCode = this.studentSession.room.group_code;
      const payload = captureGroupPayload(groupCode, this.studentPassedSlides);
      const evalRes = evaluatePayload(payload);
      const isSubmitted = !!(this.studentSession.submission && this.studentSession.submission.submitted_at);
      const actState = isSubmitted ? 'submitted' : (evalRes.allPassed ? 'completed' : 'in_progress');

      const { data, error } = await this.supabase.rpc('upsert_student_live_state', {
        p_student_id: this.studentSession.student.id,
        p_student_token: this.studentSession.token,
        p_current_slide: payload.current_slide,
        p_activity_state: actState,
        p_answer_state: { details: evalRes.details, auto_score: evalRes.autoScore, reason },
        p_progress: payload.progress,
        p_live_payload: payload
      });

      if (!error && data && data.ok) {
        this.setStudentConnDot('online');
      }
    },

    async submitStudentWork(showToast = true) {
      if (!this.supabase || !this.studentSession) return;
      const btn = document.getElementById('rt-st-submit-btn');
      if (btn) btn.disabled = true;

      const groupCode = this.studentSession.room.group_code;
      const payload = captureGroupPayload(groupCode, this.studentPassedSlides);
      const evalRes = evaluatePayload(payload);

      await this.syncLiveStateNow('before_submit');

      const { data, error } = await this.supabase.rpc('submit_student_work', {
        p_student_id: this.studentSession.student.id,
        p_student_token: this.studentSession.token,
        p_answers: { payload, details: evalRes.details, auto_score: evalRes.autoScore },
        p_auto_score: evalRes.autoScore,
        p_max_score: evalRes.maxScore
      });

      if (error || !data || !data.ok) {
        if (showToast) toast((data && data.error) || (error && error.message) || 'Lỗi khi nộp bài!', 'err');
        if (btn) btn.disabled = false;
        return;
      }

      this.studentSession.submission = data.submission;
      this.applyStudentSubmissionUI(data.submission, false);
      if (showToast) {
        toast(`🎉 Đã nộp bài thành công! Điểm hệ thống tự chấm: ${evalRes.autoScore}/10.`, 'ok');
      }
      if (btn) btn.disabled = false;
    },

    async fetchMySubmissionResult(showModalOnGraded) {
      if (!this.supabase || !this.studentSession) return;
      const { data, error } = await this.supabase.rpc('get_my_submission_result', {
        p_student_id: this.studentSession.student.id,
        p_student_token: this.studentSession.token
      });
      if (!error && data && data.ok && data.submission) {
        this.studentSession.submission = data.submission;
        this.applyStudentSubmissionUI(data.submission, showModalOnGraded);
      }
    },

    applyStudentSubmissionUI(sub, showModal) {
      const badge = document.getElementById('rt-st-grade-badge');
      const btn = document.getElementById('rt-st-submit-btn');
      if (!sub) return;

      if (sub.grading_status === 'graded' && sub.graded_at) {
        if (badge) {
          badge.className = 'rt-pill rt-pill-green';
          badge.textContent = `✓ Đã được chấm điểm: ${sub.score}/${sub.max_score || 10}`;
        }
        if (btn) {
          btn.textContent = '✓ Đã chấm điểm';
          btn.disabled = true;
        }
        if (showModal) {
          const content = document.getElementById('rt-st-result-content');
          if (content) {
            content.innerHTML = `
              <div><b>Trạng thái:</b> <span style="color:#15803d;">Đã được chấm điểm</span></div>
              <div style="font-size:22px; margin:8px 0;"><b>Điểm số:</b> <span style="color:#ea580c;">${escapeHtml(sub.score)} / ${escapeHtml(sub.max_score || 10)}</span></div>
              <div><b>Nhận xét của giáo viên:</b><br/>${escapeHtml(sub.teacher_feedback || 'Không có nhận xét thêm.')}</div>
            `;
          }
          document.getElementById('rt-student-result-modal')?.classList.add('open');
          toast(`Giáo viên đã chấm bài: ${sub.score}/${sub.max_score || 10} điểm!`, 'ok');
        }
      } else {
        const sc = sub.score != null ? `${sub.score}/10` : 'Chờ chấm';
        if (badge) {
          badge.className = 'rt-pill rt-pill-amber';
          badge.textContent = `📤 Đã nộp • Điểm tự chấm: ${sc}`;
        }
        if (btn) btn.textContent = '📤 Nộp lại bài';
      }
    },

    // ========================================================================
    // LUỒNG GIÁO VIÊN (AUTH, TẠO PHÒNG, GIÁM SÁT REALTIME, CHẤM ĐIỂM)
    // ========================================================================
    openTeacherOverlay() {
      document.getElementById('rt-teacher-overlay')?.classList.add('open');
      if (this.supabase && this.teacherUser) {
        this.refreshTeacherData();
      } else if (!this.supabase) {
        this.switchTeacherTab('config');
      }
      setTimeout(() => this.rescaleAllPreviews(), 60);
    },

    closeTeacherOverlay() {
      document.getElementById('rt-teacher-overlay')?.classList.remove('open');
    },

    switchTeacherTab(tabName) {
      ['rooms', 'monitor', 'grading', 'config'].forEach(t => {
        document.getElementById(`rt-tab-${t}`)?.classList.toggle('active', t === tabName);
        document.getElementById(`rt-tab-btn-${t}`)?.classList.toggle('active', t === tabName);
      });
      if (tabName === 'monitor') {
        this.renderMonitorGrids();
        setTimeout(() => this.rescaleAllPreviews(), 50);
      } else if (tabName === 'grading') {
        this.renderGradingTable();
      }
    },

    async restoreTeacherAuth() {
      if (!this.supabase) return;
      const { data } = await this.supabase.auth.getUser();
      this.setTeacherUser(data && data.user ? data.user : null);
    },

    setTeacherUser(user) {
      this.teacherUser = user;
      const pill = document.getElementById('rt-teacher-auth-pill');
      const outBox = document.getElementById('rt-auth-logged-out');
      const inBox = document.getElementById('rt-auth-logged-in');
      const info = document.getElementById('rt-teacher-user-info');

      if (user) {
        if (pill) { pill.className = 'rt-pill rt-pill-green'; pill.textContent = `GV: ${user.email}`; }
        if (outBox) outBox.style.display = 'none';
        if (inBox) inBox.style.display = 'flex';
        if (info) info.innerHTML = `<b>Đã đăng nhập:</b> ${escapeHtml(user.email)}<br/><small>User ID: ${escapeHtml(user.id)}</small>`;
        this.refreshTeacherData();
      } else {
        if (pill) { pill.className = 'rt-pill rt-pill-amber'; pill.textContent = 'Chưa đăng nhập GV'; }
