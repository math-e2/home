    }
  }

  /* Nút ĐẶT LẠI: Xóa tất cả điểm O, chữ O, đường nối và thông báo kết quả, đưa slide về trạng thái ban đầu */
  function resetS6Slide() {
    clearS6Timers();
    for (let i = 0; i < 6; i++) {
      s6State[i] = { selected: false, hasPoint: false, x: 100, y: 100 };
      s6IndRotated[i] = false;
      s6RevealedPoint[i] = false;
      s6RevealedLabel[i] = false;
      s6RevealedLines[i] = false;
      const rotEl = document.getElementById(`s6-rot-${i}`);
      if (rotEl) {
        rotEl.style.transition = 'none';
        rotEl.style.transform = 'rotate(0deg)';
        setTimeout(() => {
          rotEl.style.transition = 'transform 1.25s cubic-bezier(0.34, 1.08, 0.64, 1)';
        }, 40);
      }
    }
    s6RevealedNoSym = false;
    s6Checked = false;
    s6Rotated = false;
    slideSteps[5] = 0;
    renderSlide6();

    const banner = document.getElementById('s6-banner-text');
    if (banner) {
      banner.textContent = 'Quan sát các hình gồm đường tròn giao nhau, chong chóng, các hình ghép và đa giác. Hãy chỉ ra tâm đối xứng nếu có, rồi kiểm tra bằng phép quay nửa vòng.';
    }
  }

  function renderSlide6() {
    const anyRotated = s6IndRotated.some(Boolean);
    const pill = document.getElementById('s6-angle-pill');
    if (pill) pill.textContent = anyRotated ? 'Góc quay: 180°' : 'Góc quay: 0°';

    for (let i = 0; i < 6; i++) {
      const st = s6State[i];
      const card = document.getElementById(`s6-card-${i}`);
      const badge = document.getElementById(`s6-badge-${i}`);
      const rotEl = document.getElementById(`s6-rot-${i}`);
      const ghostEl = document.getElementById(`s6-ghost-${i}`);
      const userPt = document.getElementById(`s6-user-pt-${i}`);
      const userRing = document.getElementById(`s6-user-ring-${i}`);
      const userDot = document.getElementById(`s6-user-dot-${i}`);
      const ansOGroup = document.getElementById(`s6-ans-o-${i}`);
      const ansOLbl = document.getElementById(`s6-ans-lbl-${i}`);
      const symLines = document.getElementById(`s6-lines-${i}`);
      const noSymNotice = document.getElementById(`s6-nonsym-notice-${i}`);
      const statusTxt = document.getElementById(`s6-status-txt-${i}`);

      if (!card) continue;

      // Chỉ quay 180° quanh tâm O đối với những hình có tâm đối xứng; Hình thang cân (i === 4) không quay kiểm chứng quanh tâm đối xứng
      const isRot = S6_IS_SYM[i] ? Boolean(s6IndRotated[i]) : false;
      if (rotEl) rotEl.style.transform = isRot ? 'rotate(180deg)' : 'rotate(0deg)';
      if (ghostEl) ghostEl.classList.toggle('visible', isRot);

      card.classList.remove('selected-item', 'checked-sym', 'checked-nonsym');

      if (!s6Checked) {
        // Trạng thái ban đầu / đang tự quan sát và chọn thử: tuyệt đối không tiết lộ chữ O, tâm O hay đúng/sai
        if (st.selected) card.classList.add('selected-item');
        if (userPt) {
          userPt.style.display = st.hasPoint ? 'block' : 'none';
          if (st.hasPoint && userRing && userDot) {
            userRing.setAttribute('cx', st.x);
            userRing.setAttribute('cy', st.y);
            userDot.setAttribute('cx', st.x);
            userDot.setAttribute('cy', st.y);
          }
        }
        if (ansOGroup) ansOGroup.classList.remove('shown');
        if (ansOLbl) ansOLbl.classList.remove('shown');
        if (symLines) symLines.classList.remove('shown');
        if (noSymNotice) noSymNotice.classList.remove('shown');
        if (badge) {
          badge.className = 'hdcn-status-badge';
          badge.textContent = '';
        }
        if (statusTxt) {
          statusTxt.style.color = '#0f2942';
          statusTxt.textContent = S6_TITLES[i];
        }
      } else {
        // Trạng thái sau khi nhấn KIỂM TRA hoặc HIỆN ĐÁP ÁN: ẩn điểm nháp, lần lượt hiện điểm O màu đỏ/cam, chữ O và thông báo
        if (userPt) userPt.style.display = 'none';

        if (S6_IS_SYM[i]) {
          if (s6RevealedPoint[i]) {
            card.classList.add('checked-sym');
          }
          if (ansOGroup) ansOGroup.classList.toggle('shown', Boolean(s6RevealedPoint[i]));
          if (ansOLbl) ansOLbl.classList.toggle('shown', Boolean(s6RevealedLabel[i]));
          if (symLines) symLines.classList.toggle('shown', Boolean(s6RevealedLines[i]));
          if (badge) {
            if (s6RevealedLabel[i]) {
              badge.className = 'hdcn-status-badge show-sym';
              badge.textContent = '✓ Có tâm O';
            } else {
              badge.className = 'hdcn-status-badge';
              badge.textContent = '';
            }
          }
          if (statusTxt) {
            statusTxt.style.color = s6RevealedLabel[i] ? '#c2410c' : '#0f2942';
            statusTxt.textContent = s6RevealedLabel[i] ? S6_O_DESC[i] : S6_TITLES[i];
          }
        } else {
          // Hình e: Hình thang cân -> Không hiện điểm O, chỉ hiện thông báo "Hình không có tâm đối xứng"
          if (s6RevealedNoSym) {
            card.classList.add('checked-nonsym');
          }
          if (noSymNotice) noSymNotice.classList.toggle('shown', Boolean(s6RevealedNoSym));
          if (badge) {
            if (s6RevealedNoSym) {
              badge.className = 'hdcn-status-badge show-nonsym';
              badge.textContent = '✗ Không có tâm O';
            } else {
              badge.className = 'hdcn-status-badge';
              badge.textContent = '';
            }
          }
          if (statusTxt) {
            statusTxt.style.color = s6RevealedNoSym ? '#dc2626' : '#0f2942';
            statusTxt.textContent = s6RevealedNoSym ? 'e) Hình thang cân — Hình không có tâm đối xứng' : S6_TITLES[i];
          }
        }
      }
    }
