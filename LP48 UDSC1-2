  // Cập nhật số bước tối đa cho 4 hoạt động (3 tứ giác: 8 bước; lục giác đều: 10 bước)
  S3_ACT_MAX_STEP.splice(0, 4, 8, 8, 8, 10);

  // Tọa độ chấm xanh dự đoán của học sinh trên từng hình: { x, y } hoặc null
  let s3UserGuessPos = [null, null, null, null];
  let s3IsDraggingGuess = false;

  function initSlide3GuessInteractions() {
    for (let i = 0; i < 4; i++) {
      const svgEl = document.getElementById(`s3-svg-${i}`);
      if (!svgEl) continue;

      const getSvgCoords = (evt) => {
        const rect = svgEl.getBoundingClientRect();
        const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
        const clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
        const x = ((clientX - rect.left) / rect.width) * 440;
        const y = ((clientY - rect.top) / rect.height) * 330;
        return {
          x: Math.max(45, Math.min(395, x)),
          y: Math.max(45, Math.min(290, y))
        };
      };

      const placeGuessPoint = (evt) => {
        if (currentSlide !== 2 || s3SummaryMode || s3CurrentAct !== i) return;
        // Cho phép nhấp đặt chấm dự đoán khi đang ở Bước 1 hoặc Bước 2
        if (s3ActStep[i] !== 1 && s3ActStep[i] !== 2) return;
        evt.preventDefault();
        s3UserGuessPos[i] = getSvgCoords(evt);
        if (s3ActStep[i] === 1) {
          s3ActStep[i] = 2;
        }
        s3IsDraggingGuess = true;
        renderSlide3Explore();
      };

      const moveGuessPoint = (evt) => {
        if (!s3IsDraggingGuess || currentSlide !== 2 || s3CurrentAct !== i) return;
        if (s3ActStep[i] !== 2) return;
        evt.preventDefault();
        s3UserGuessPos[i] = getSvgCoords(evt);
        const guessGroup = document.getElementById(`s3-guess-${i}`);
        if (guessGroup && s3UserGuessPos[i]) {
          guessGroup.setAttribute('transform', `translate(${s3UserGuessPos[i].x}, ${s3UserGuessPos[i].y})`);
        }
      };

      const endDragGuessPoint = () => {
        if (s3IsDraggingGuess) {
          s3IsDraggingGuess = false;
        }
      };

      svgEl.addEventListener('mousedown', placeGuessPoint);
      svgEl.addEventListener('mousemove', moveGuessPoint);
      window.addEventListener('mouseup', endDragGuessPoint);

      svgEl.addEventListener('touchstart', placeGuessPoint, { passive: false });
      svgEl.addEventListener('touchmove', moveGuessPoint, { passive: false });
      window.addEventListener('touchend', endDragGuessPoint);
    }
  }
  window.addEventListener('load', initSlide3GuessInteractions);

  function clearSlide3SummaryTimers() {
    s3SummaryTimers.forEach(t => clearTimeout(t));
    s3SummaryTimers = [];
  }

  function selectSlide3Activity(actIdx) {
    if (actIdx < 0 || actIdx > 3) return;
    clearSlide3SummaryTimers();
    s3SummaryMode = false;
    const slideEl = document.getElementById('slide-2');
    if (slideEl) slideEl.classList.remove('s3-fading-out', 's3-summary-active');
    s3CurrentAct = actIdx;
    renderSlide3Explore();
  }

  function showCurrentSlide3Conclusion() {
