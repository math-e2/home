    .s3-general-conclusion-banner.row-visible {
      opacity: 1;
      transform: scale(1);
    }

    /* ==========================================================================
       SLIDE 4 MỚI: EM ĐÃ HỌC ĐƯỢC GÌ? – TÂM ĐỐI XỨNG (SLIDE TỔNG KẾT CUỐI BÀI)
       ========================================================================== */
    #slide-3 {
      gap: 12px;
    }

    .s4-top-header {
      background: var(--white);
      border-left: 10px solid var(--orange-btn);
      border-radius: 15px;
      padding: 11px 22px;
      display: flex;
      align-items: center;
