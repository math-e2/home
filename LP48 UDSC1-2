  const PracticeHub = {
    supabase: null,
    mode: 'teacher',
    teacherUser: null,
    activeRooms: { GROUP_1: null, GROUP_2: null },
    studentsById: {},
    liveStatesByStudentId: {},
    submissionsByStudentId: {},
    teacherChannels: [],
    monitorFilter: 'all',
    currentDetailStudentId: null,
    currentDetailSlide: null,

    // Student state
    studentSession: null,
    studentPassedSlides: {}, // { [slideNum]: true }
    studentChannel: null,
    studentSyncTimer: null,
    studentHeartbeatTimer: null,

    init() {
      this.initSupabaseClient();
      this.installNonDestructiveHooks();

      const params = new URLSearchParams(window.location.search);
      const roomCode = params.get('room');
      if (roomCode && roomCode.trim()) {
        this.mode = 'student';
        document.body.classList.add('rt-student-mode');
