  function advanceSlide3Step() {
    if (s3SummaryMode) {
      replaySlide3SummaryTable();
      return;
    }
    const act = s3CurrentAct;
    const curStep = s3ActStep[act];
    const maxS = S3_ACT_MAX_STEP[act];

    // Ở Bước 2: Nếu học sinh chưa nhấp lên hình mà nhấn nút luôn, đặt một chấm xanh dự đoán mặc định để học sinh kéo hoặc kiểm tra
    if (curStep === 2 && !s3UserGuessPos[act]) {
      s3UserGuessPos[act] = { x: 185, y: 140 };
      renderSlide3Explore();
      return;
    }

    if (curStep < maxS) {
      s3ActStep[act]++;
      if (s3ActStep[act] === maxS) {
        s3ActCompleted[act] = true;
      }
      renderSlide3Explore();
    }
  }

  function stepBackSlide3() {
    if (s3SummaryMode) {
      closeSlide3SummaryTable();
      return;
    }
    if (s3ActStep[s3CurrentAct] > 0) {
      s3ActStep[s3CurrentAct]--;
      renderSlide3Explore();
    } else if (s3CurrentAct > 0) {
      selectSlide3Activity(s3CurrentAct - 1);
    }
  }

  function openSlide3SummaryTable() {
    clearSlide3SummaryTimers();
    const slideEl = document.getElementById('slide-2');
    s3SummaryMode = true;

    for (let i = 0; i < 4; i++) {
      const row = document.getElementById(`s3-sum-row-${i}`);
      if (row) row.classList.remove('row-visible');
    }
    const genBanner = document.getElementById('s3-sum-general-banner');
    if (genBanner) genBanner.classList.remove('row-visible');

    slideEl.classList.add('s3-fading-out');
    s3SummaryTimers.push(setTimeout(() => {
      slideEl.classList.remove('s3-fading-out');
      slideEl.classList.add('s3-summary-active');
      runSlide3SummarySequence();
    }, 360));
  }

  function runSlide3SummarySequence() {
    for (let i = 0; i < 4; i++) {
      const row = document.getElementById(`s3-sum-row-${i}`);
      if (row) row.classList.remove('row-visible');
      s3SummaryTimers.push(setTimeout(() => {
        if (row) row.classList.add('row-visible');
      }, 220 + i * 380));
    }
    const genBanner = document.getElementById('s3-sum-general-banner');
    if (genBanner) genBanner.classList.remove('row-visible');
    s3SummaryTimers.push(setTimeout(() => {
      if (genBanner) genBanner.classList.add('row-visible');
    }, 220 + 4 * 380));
  }

  function replaySlide3SummaryTable() {
    clearSlide3SummaryTimers();
    runSlide3SummarySequence();
  }

  function closeSlide3SummaryTable() {
    clearSlide3SummaryTimers();
    s3SummaryMode = false;
    const slideEl = document.getElementById('slide-2');
    slideEl.classList.remove('s3-fading-out', 's3-summary-active');
    renderSlide3Explore();
  }

  function renderSlide3Explore() {
    if (s3SummaryMode) return;

    const act = s3CurrentAct;
    const step = s3ActStep[act];
    const maxS = S3_ACT_MAX_STEP[act];
    const isHex = (act === 3);
    const isConclusionState = (step === maxS);
    const cfg = S3_ACTIVITIES_CONFIG[act];

    // 1. Cập nhật các tab hoạt động trên thanh tiêu đề
    for (let i = 0; i < 4; i++) {
      const tab = document.getElementById(`s3-tab-${i}`);
      if (!tab) continue;
      tab.classList.toggle('active-tab', i === act);
      tab.classList.toggle('done-tab', s3ActCompleted[i]);
    }

    // 2. Hiển thị đúng SVG của hoạt động đang chọn ở cột bên trái
    for (let i = 0; i < 4; i++) {
      const svgEl = document.getElementById(`s3-svg-${i}`);
      if (!svgEl) continue;
      svgEl.classList.toggle('active-svg', i === act);
      svgEl.classList.toggle('s3-Interactive-svg', i === act && (step === 1 || step === 2));
    }

    // 3. Chuyển đổi giữa TRẠNG THÁI KHÁM PHÁ và TRẠNG THÁI KẾT LUẬN (Bước 5)
    const workspaceEl = document.getElementById('s3-main-workspace');
    const rightCardEl = document.getElementById('s3-right-panel-card');
    workspaceEl.classList.toggle('conclusion-view-active', isConclusionState);
    rightCardEl.classList.toggle('conclusion-mode', isConclusionState);

    document.getElementById('s3-shape-title').textContent = cfg.title;

    // 4. Cập nhật nội dung Kết luận ở Bước 5
    const concFinalEl = document.getElementById('s3-dedicated-conc-final');
    if (concFinalEl) concFinalEl.innerHTML = cfg.conclusionTextHTML;
    const nextOrSumBtn = document.getElementById('s3-next-or-summary-btn');
    if (nextOrSumBtn) {
      nextOrSumBtn.textContent = (act < 3) ? 'Hình tiếp theo ▶' : '📋 Hiện bảng tổng kết';
    }

    // 5. Xác định mốc bước cho Tứ giác (act 0,1,2) và Lục giác đều (act 3)
    const stepDiag1 = 3;
    const stepDiag2 = 4;
    const stepDiag3 = isHex ? 5 : 99;
    const stepIntersectDot = isHex ? 6 : 5;
    const stepLabelO = isHex ? 7 : 6;
    const stepHexPairs = isHex ? 8 : 99;
    const stepRotate180 = isHex ? 9 : 7;
    const stepFinalBadge = isHex ? 10 : 8;

    // 6. Cập nhật Chấm xanh dự đoán của học sinh trên SVG
    const guessEl = document.getElementById(`s3-guess-${act}`);
    if (guessEl) {
      const hasGuess = Boolean(s3UserGuessPos[act]);
      // Hiển thị chấm dự đoán từ Bước 2 đến trước khi quay 180° để học sinh đối chiếu với giao điểm O
      const showGuess = hasGuess && (step >= 2 && step < stepRotate180);
      guessEl.classList.toggle('visible', showGuess);
      if (hasGuess) {
        guessEl.setAttribute('transform', `translate(${s3UserGuessPos[act].x}, ${s3UserGuessPos[act].y})`);
      }
    }

    // 7. Cập nhật Đường chéo, Giao điểm O, Phép quay 180° và Nhãn "O – TÂM ĐỐI XỨNG" trên SVG
    const d1 = document.getElementById(`s3-act${act}-d1`);
    const d2 = document.getElementById(`s3-act${act}-d2`);
    const d3 = isHex ? document.getElementById('s3-act3-d3') : null;
    if (d1) d1.classList.toggle('drawn', step >= stepDiag1);
    if (d2) d2.classList.toggle('drawn', step >= stepDiag2);
    if (d3) d3.classList.toggle('drawn', step >= stepDiag3);

    const oGroup = document.getElementById(`s3-o-${act}`);
    const oDot = document.getElementById(`s3-odot-${act}`);
    const oLabel = document.getElementById(`s3-olabel-${act}`);
    const oHalo = document.getElementById(`s3-halo-${act}`);
    const oBadge = document.getElementById(`s3-obadge-${act}`);

    if (oGroup) {
      oGroup.classList.toggle('shown', step >= stepIntersectDot);
      oGroup.classList.toggle('zoom-pulse-o', step === stepIntersectDot || step === stepRotate180);
    }
    if (oDot) {
      oDot.setAttribute('fill', step >= stepFinalBadge ? '#ea580c' : '#0f2942');
    }
    if (oLabel) {
      // Ở Bước 5 (stepFinalBadge), ẩn chữ O đơn lẻ để nhường chỗ cho nhãn "O – TÂM ĐỐI XỨNG"
      oLabel.style.opacity = (step >= stepLabelO && step < stepFinalBadge) ? '1' : '0';
    }
    if (oHalo) {
      oHalo.classList.toggle('visible', step >= stepFinalBadge);
    }
    if (oBadge) {
      oBadge.classList.toggle('visible', step >= stepFinalBadge);
    }

    // Khung bóng nét đứt vị trí ban đầu chỉ xuất hiện khi bắt đầu quay 180°
    const ghostEl = document.getElementById(`s3-ghost-${act}`);
    if (ghostEl) {
      ghostEl.classList.toggle('visible', step >= stepRotate180);
    }

    // Thực hiện phép quay 180° quanh tâm O
    const isRotated180 = (step >= stepRotate180);
    const rotEl = document.getElementById(`s3-rot-${act}`);
    if (rotEl) {
      rotEl.style.transform = isRotated180 ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    if (act === 2) {
      const targetDeg2 = isRotated180 ? 180 : 0;
      document.querySelectorAll('#s3-svg-2 .s3-rhom-upright-label').forEach(lbl => {
        lbl.style.transform = `rotate(${-targetDeg2}deg)`;
      });
    }

    const angleBadge = document.getElementById('s3-angle-indicator');
    if (angleBadge) {
      angleBadge.textContent = isRotated180 ? 'Góc quay: 180° (Trùng khít)' : 'Góc quay: 0°';
    }

    // 8. Cập nhật nội dung Câu hỏi, Lời dẫn từng bước và Nút hành động chính ở cột phải
    const guideBox = document.getElementById('s3-step-guide-box');
    const guideText = document.getElementById('s3-step-guide-text');
    const hexPairsPills = document.getElementById('s3-hex-pairs-pills');
    const mainBtn = document.getElementById('s3-main-step-btn');
    const subControlsRow = document.getElementById('s3-sub-controls-row');

    mainBtn.classList.remove('blue-mode', 'green-mode');
    hexPairsPills.classList.remove('visible');
    subControlsRow.style.display = (step > 0 && !isConclusionState) ? 'flex' : 'none';

    if (step === 0) {
      // Trạng thái ban đầu: Chỉ hiển thị Câu hỏi khám phá + 1 nút duy nhất
      guideBox.style.display = 'none';
      mainBtn.textContent = 'EM HÃY THỬ TÌM TÂM ĐỐI XỨNG!';
    }
    else if (step === 1) {
      // Bước 1: Quan sát và suy nghĩ
      guideBox.style.display = 'block';
      guideText.textContent = 'Em hãy quan sát hình và dự đoán vị trí tâm đối xứng.';
      mainBtn.classList.add('blue-mode');
      mainBtn.textContent = 'CHỌN ĐIỂM DỰ ĐOÁN TRÊN HÌNH ▶';
    }
    else if (step === 2) {
      // Bước 2: Học sinh lựa chọn dự đoán trên hình
      guideBox.style.display = 'block';
      if (!s3UserGuessPos[act]) {
        guideText.textContent = '👉 Em hãy nhấp chuột vào vị trí bất kỳ trên hình bên trái để đánh dấu điểm mà em dự đoán là tâm đối xứng!';
        mainBtn.classList.add('blue-mode');
        mainBtn.textContent = 'ĐẶT CHẤM DỰ ĐOÁN & KIỂM TRA';
      } else {
        guideText.textContent = '✓ Đã đánh dấu điểm dự đoán màu xanh (em có thể kéo chấm xanh để đổi vị trí). Nhấn nút bên dưới để kiểm tra!';
        mainBtn.textContent = 'KIỂM TRA DỰ ĐOÁN';
      }
    }
    else if (step === 3) {
      // Bước 3.1: Vẽ đường chéo thứ nhất
      guideBox.style.display = 'block';
      guideText.textContent = isHex
        ? 'Bước 3 (1/5): Vẽ đường chéo chính thứ nhất AD nối hai đỉnh đối diện A và D.'
        : 'Bước 3 (1/4): Vẽ đường chéo thứ nhất AC nối hai đỉnh đối diện A và C.';
      mainBtn.classList.add('blue-mode');
      mainBtn.textContent = isHex ? 'BƯỚC TIẾP: VẼ ĐƯỜNG CHÉO BE ▶' : 'BƯỚC TIẾP: VẼ ĐƯỜNG CHÉO BD ▶';
    }
    else if (step === 4) {
      // Bước 3.2: Vẽ đường chéo thứ hai
      guideBox.style.display = 'block';
      guideText.textContent = isHex
        ? 'Bước 3 (2/5): Vẽ tiếp đường chéo chính thứ hai BE nối hai đỉnh đối diện B và E.'
        : 'Bước 3 (2/4): Vẽ tiếp đường chéo thứ hai BD nối hai đỉnh đối diện B và D.';
      mainBtn.classList.add('blue-mode');
      mainBtn.textContent = isHex ? 'BƯỚC TIẾP: VẼ ĐƯỜNG CHÉO CF ▶' : 'BƯỚC TIẾP: XÁC ĐỊNH GIAO ĐIỂM ▶';
    }
    else if (isHex && step === 5) {
      // Bước 3.3 (Lục giác): Vẽ đường chéo chính thứ ba CF
      guideBox.style.display = 'block';
      guideText.textContent = 'Bước 3 (3/5): Vẽ đường chéo chính thứ ba CF nối hai đỉnh đối diện C và F.';
      mainBtn.classList.add('blue-mode');
      mainBtn.textContent = 'BƯỚC TIẾP: XÁC ĐỊNH GIAO ĐIỂM ▶';
    }
    else if (step === stepIntersectDot) {
      // Bước xuất hiện điểm giao
      guideBox.style.display = 'block';
      guideText.textContent = isHex
        ? 'Ba đường chéo chính AD, BE, CF cùng giao nhau tại một điểm chính giữa hình!'
        : 'Hai đường chéo AC và BD giao nhau tại một điểm ở bên trong hình!';
      mainBtn.classList.add('blue-mode');
      mainBtn.textContent = 'BƯỚC TIẾP: ĐẶT TÊN GIAO ĐIỂM O ▶';
    }
    else if (step === stepLabelO) {
      // Bước hiện ký hiệu O tại giao điểm
      guideBox.style.display = 'block';
      guideText.textContent = cfg.diagIntroText;
      if (isHex) {
        mainBtn.classList.add('blue-mode');
        mainBtn.textContent = 'BƯỚC TIẾP: XEM CÁC CẶP ĐỈNH ĐỐI DIỆN ▶';
      } else {
        mainBtn.textContent = 'QUAY 180° KIỂM CHỨNG';
      }
    }
    else if (isHex && step === stepHexPairs) {
      // Bước đánh dấu 3 cặp đỉnh đối diện của Lục giác đều trước khi quay
      guideBox.style.display = 'block';
      guideText.textContent = 'Ba đường chéo chính nối 3 cặp đỉnh đối diện qua điểm O:';
      hexPairsPills.classList.add('visible');
      mainBtn.textContent = 'QUAY 180° KIỂM CHỨNG';
    }
    else if (step === stepRotate180) {
      // Bước 4: Đã quay 180° quanh O để kiểm chứng
      guideBox.style.display = 'block';
      guideText.textContent = isHex
        ? 'Khi quay 180° quanh O: A đổi chỗ với D, B đổi chỗ với E, C đổi chỗ với F. Hình trùng khít với vị trí ban đầu!'
        : `Khi quay ${cfg.shapeNameLower} 180° quanh O: A đổi chỗ với C, B đổi chỗ với D. Hình thu được trùng khít với hình ban đầu!`;
      mainBtn.classList.add('green-mode');
      mainBtn.textContent = 'BƯỚC TIẾP: HIỆN KẾT LUẬN ▶';
    }
  }

  /* --------------------------------------------------------------------------
     6B. LOGIC SLIDE 4 (SLIDE CUỐI CÙNG): EM ĐÃ HỌC ĐƯỢC GÌ? – TÂM ĐỐI XỨNG
     -------------------------------------------------------------------------- */
  /*
    Kịch bản chi tiết theo từng lần nhấp "Bước tiếp" (slideSteps[3] từ 0 -> 19):
    - BƯỚC 1/4 (Những hình có tâm đối xứng đã học):
      + Step 0: Hiện tiêu đề Phần 1 (chưa hiện hình nào).
      + Step 1..5: Lần lượt hiện Hình 1 (Tròn), Hình 2 (Bình hành), Hình 3 (Chữ nhật), Hình 4 (Thoi), Hình 5 (Lục giác đều) kèm vẽ đường kính/đường chéo và xuất hiện điểm O.
      + Step 6: Hiện thanh lưu ý bổ sung về Hình vuông.
    - BƯỚC 2/4 (Tâm đối xứng là gì?):
      + Step 7: Hiện tiêu đề Phần 2 & hình tròn chỉ có điểm O và mũi tên quay.
      + Step 8: Nhấp lần 1 -> Hiện hình ban đầu và đánh dấu điểm A.
      + Step 9: Nhấp lần 2 -> Hình quay 180° quanh O, điểm A di chuyển đến A'.
      + Step 10: Nhấp lần 3 -> Hình trùng khít với hình ban đầu, A và A' đối diện qua O.
      + Step 11: Hiện khung Định nghĩa lớn với 3 cụm từ nhấn mạnh màu cam.
    - BƯỚC 3/4 (Nhận biết tâm đối xứng trực quan trên hình bình hành ABCD - 4 bước):
      + Step 12 (Bước 1 – Quan sát): Hiện hình bình hành ABCD, hai đường chéo AC, BD và giao điểm O. Chưa hiện kết luận.
      + Step 13 (Bước 2 – Thực hiện phép quay): Toàn bộ hình bình hành quay 180° quanh O (A ↔ C, B ↔ D, O cố định).
      + Step 14 (Bước 3 – Kiểm chứng): Hình sau khi quay chồng khít hoàn toàn với hình ban đầu, hiện dấu xác nhận "✓ HÌNH TRÙNG KHÍT".
      + Step 15 (Bước 4 – Rút ra kết luận): Ẩn toàn bộ thông tin phụ, giữ hình bình hành hoàn chỉnh bên trái, bên phải chỉ hiện một khung kết luận lớn (xuất hiện tuần tự: Tiêu đề → Định nghĩa → 3 cụm từ khóa).
    - BƯỚC 4/4 (Điều gì đúng với hai điểm đối xứng qua tâm O?):
      + Step 16: Hiện tiêu đề Phần 4, hình A – O – A' và ý 1: A, O, A' thẳng hàng.
      + Step 17: Hiện ý 2: O là trung điểm của đoạn thẳng AA'.
      + Step 18: Hiện ý 3: OA = OA', công thức đóng khung [OA = OA'] và sơ đồ A —— O —— A'.
    - HIỆU ỨNG KẾT THÚC – GHI NHỚ:
      + Step 19: Hiện khung lớn chính giữa màn hình "ĐIỀU QUAN TRỌNG NHẤT CẦN NHỚ", điểm O phát sáng, hình minh họa quay 180° trùng khít.
  */
  let s4ShapeTimers = [];
  let s4P1IsAnimating = false;
  let s4P1AnimatingIdx = 0; // Chỉ số hình (1..5) đang bay từ giữa về ô đích

  function clearSlide4Timers() {
    s4ShapeTimers.forEach(t => clearTimeout(t));
    s4ShapeTimers = [];
  }

  function cancelSlide4P1Animation() {
    s4P1IsAnimating = false;
    s4P1AnimatingIdx = 0;
    const cloneBox = document.getElementById('s4-p1-fly-clone');
    if (cloneBox) {
      cloneBox.style.transition = 'none';
      cloneBox.style.display = 'none';
      cloneBox.innerHTML = '';
    }
  }

  /* Chạy hoạt ảnh giới thiệu từng hình (idx = 1..5):
     1. Xuất hiện ở chính giữa vùng nội dung và phóng to (0.48s, ease-in-out).
     2. Giữ ở chính giữa màn hình 0.5s (vẽ các đường kính/đường chéo và tâm O trên bản sao).
     3. Thu nhỏ mượt mà và di chuyển về đúng vị trí ô đích idx (0.68s, ease-in-out).
     4. Khi đã về đúng ô đích: đặt hình vào ô, sau đó hiện tên và thông tin tâm đối xứng, mở khóa nút Bước tiếp.
  */
  function runSlide4P1FlyAnimation(idx) {
    const gridEl = document.querySelector('#s4-panel-1 .s4-shapes-5grid');
    const cardEl = document.getElementById(`s4-p1-card-${idx}`);
    const cloneBox = document.getElementById('s4-p1-fly-clone');
    if (!gridEl || !cardEl || !cloneBox) {
      s4P1IsAnimating = false;
      s4P1AnimatingIdx = 0;
      renderSlide4Summary();
      return;
    }

    const origSvg = cardEl.querySelector('svg');
    if (!origSvg) {
      s4P1IsAnimating = false;
      s4P1AnimatingIdx = 0;
      renderSlide4Summary();
      return;
    }

    s4P1IsAnimating = true;
    s4P1AnimatingIdx = idx;
    renderSlide4Summary(); // Khóa nút Bước tiếp và ẩn ô đích idx trong lúc đang bay

    // Tính toán tọa độ trong hệ quy chiếu nội bộ (chưa nhân scale của #stage-16-9)
    const stageEl = document.getElementById('stage-16-9');
    const stageRect = stageEl.getBoundingClientRect();
    const scaleFactor = stageRect.width / 1440 || 1;

    const gridRect = gridEl.getBoundingClientRect();
    const svgRect = origSvg.getBoundingClientRect();

    const gridW = gridRect.width / scaleFactor;
    const gridH = gridRect.height / scaleFactor;

    const targetW = svgRect.width / scaleFactor || 160;
    const targetH = svgRect.height / scaleFactor || 145;
    const targetCenterX = ((svgRect.left - gridRect.left) / scaleFactor) + targetW / 2;
    const targetCenterY = ((svgRect.top - gridRect.top) / scaleFactor) + targetH / 2;

    const startCenterX = gridW / 2;
    const startCenterY = gridH / 2;

    // Tạo bản sao SVG độc lập để chạy animation
    cloneBox.innerHTML = '';
    const clonedSvg = origSvg.cloneNode(true);
    clonedSvg.removeAttribute('id');
    clonedSvg.querySelectorAll('[id]').forEach(el => el.removeAttribute('id'));
    // Ban đầu chưa vẽ đường chéo trên bản sao để vẽ trực quan khi dừng ở giữa
    clonedSvg.querySelectorAll('.s4-draw-line').forEach(l => l.classList.remove('drawn'));
    clonedSvg.querySelectorAll('.center-o-group').forEach(g => g.classList.remove('shown'));
    cloneBox.appendChild(clonedSvg);

    const boxW = targetW + 24;
    const boxH = targetH + 20;
    cloneBox.style.width = `${boxW}px`;
    cloneBox.style.height = `${boxH}px`;
    cloneBox.style.display = 'flex';
    cloneBox.style.transition = 'none';
    cloneBox.style.opacity = '0';
    cloneBox.style.borderColor = '#ea580c';
    cloneBox.style.background = 'rgba(255, 255, 255, 0.98)';
    cloneBox.style.boxShadow = '0 18px 42px rgba(15, 41, 66, 0.25)';

    const startLeft = startCenterX - boxW / 2;
    const startTop = startCenterY - boxH / 2;
    const endLeft = targetCenterX - boxW / 2;
    const endTop = targetCenterY - boxH / 2;

    // Đặt ở chính giữa vùng nội dung với kích thước nhỏ ban đầu (scale 0.25)
    cloneBox.style.transform = `translate(${startLeft}px, ${startTop}px) scale(0.25)`;
    void cloneBox.offsetWidth;

    // Giai đoạn 1 (0.48s): Phóng to từ nhỏ đến kích thước lớn (scale 1.72) ở chính giữa màn hình
    cloneBox.style.transition = 'transform 0.48s ease-in-out, opacity 0.35s ease-in-out';
    cloneBox.style.opacity = '1';
    cloneBox.style.transform = `translate(${startLeft}px, ${startTop}px) scale(1.72)`;

    // Khi vừa phóng to ở giữa: vẽ các đường chéo/đường kính và hiện tâm O để học sinh quan sát trong 0.5s giữ ở giữa
    s4ShapeTimers.push(setTimeout(() => {
      clonedSvg.querySelectorAll('.s4-draw-line').forEach(l => l.classList.add('drawn'));
    }, 240));
    s4ShapeTimers.push(setTimeout(() => {
      clonedSvg.querySelectorAll('.center-o-group').forEach(g => g.classList.add('shown'));
    }, 520));

    // Giai đoạn 2: Sau 0.48s phóng to + 0.50s giữ ở giữa (= 980ms), thu nhỏ và di chuyển về ô đích (0.68s ease-in-out)
    s4ShapeTimers.push(setTimeout(() => {
      cloneBox.style.transition = 'transform 0.68s ease-in-out, box-shadow 0.68s ease-in-out, border-color 0.68s ease-in-out';
      cloneBox.style.transform = `translate(${endLeft}px, ${endTop}px) scale(1)`;
      cloneBox.style.borderColor = '#0d9488';
      cloneBox.style.boxShadow = '0 4px 12px rgba(13, 148, 136, 0.12)';
    }, 980));

    // Giai đoạn 3: Khi hình đã về đúng vị trí ô đích (980 + 680 = 1660ms) -> đặt hình cố định vào ô, hiện tên & thông tin
    s4ShapeTimers.push(setTimeout(() => {
      cloneBox.style.display = 'none';
      cloneBox.innerHTML = '';
      s4P1AnimatingIdx = 0;

      // Hiển thị thẻ tại ô đích với hình SVG đã vẽ sẵn đường chéo & điểm O (tên và thông tin chuẩn bị fade-in)
      cardEl.classList.add('shown-card', 'current-focus');
      cardEl.classList.remove('info-visible');
      document.getElementById(`s4-p1-d${idx}a`)?.classList.add('drawn');
      document.getElementById(`s4-p1-d${idx}b`)?.classList.add('drawn');
      document.getElementById(`s4-p1-d${idx}c`)?.classList.add('drawn');
      document.getElementById(`s4-p1-o${idx}`)?.classList.add('shown');

      // Ngay sau khi hình yên vị trong ô, hiện tên hình và phần thông tin tâm đối xứng
      s4ShapeTimers.push(setTimeout(() => {
        cardEl.classList.add('info-visible');
        s4P1IsAnimating = false;
        const btnNext = document.getElementById('s4-btn-next');
        if (btnNext) btnNext.disabled = (slideSteps[3] >= MAX_STEPS_PER_SLIDE[3]);
      }, 60));
    }, 1660));
  }

  function changeSlide4Step(delta) {
    // Không cho phép nhấn Bước tiếp liên tục khi animation đang chạy
    if (delta > 0 && s4P1IsAnimating) return;

    // Nếu người dùng nhấn Bước trước trong lúc đang chạy animation, hủy animation ngay và lùi bước
    if (delta < 0 && s4P1IsAnimating) {
      clearSlide4Timers();
      cancelSlide4P1Animation();
    }

    const maxS = MAX_STEPS_PER_SLIDE[3];
    const prevS = slideSteps[3];
    // Ở Phần 1: Sau khi đã hiện đủ 5/5 hình (prevS === 5), nhấn Bước tiếp sẽ chuyển sang Phần 2 (step 7)
    let nextS = prevS + delta;
    if (delta > 0 && prevS === 5) {
      nextS = 7;
    } else if (delta < 0 && prevS === 7) {
      nextS = 5;
    }

    if (nextS < 0 || nextS > maxS) return;
    slideSteps[3] = nextS;

    // Nếu tiến lên trong Phần 1 (từ 0 -> 1, 1 -> 2, ..., 4 -> 5): chạy hoạt ảnh phóng to ở giữa rồi bay về ô
    if (delta > 0 && nextS >= 1 && nextS <= 5) {
      clearSlide4Timers();
      runSlide4P1FlyAnimation(nextS);
      return;
    }

    renderSlide4Summary();
    if (nextS === 19 && delta > 0) {
      triggerSlide4FinalRotation();
    }
  }

  function jumpToSlide4Part(partNum) {
    clearSlide4Timers();
    cancelSlide4P1Animation();
    const startStepByPart = { 1: 0, 2: 7, 3: 12, 4: 16 };
    slideSteps[3] = startStepByPart[partNum] ?? 0;
    renderSlide4Summary();
  }

  function resetSlide4Summary() {
    clearSlide4Timers();
    cancelSlide4P1Animation();
    slideSteps[3] = 0;
    const p2Rot = document.getElementById('s4-p2-rot-group');
    if (p2Rot) {
      p2Rot.style.transition = 'none';
      p2Rot.style.transform = 'rotate(0deg)';
      setTimeout(() => {
        p2Rot.style.transition = 'transform 1.2s cubic-bezier(0.34, 1.15, 0.64, 1), opacity 0.35s ease';
      }, 40);
    }
    const p3Rot = document.getElementById('s4-p3-rot-all');
    if (p3Rot) {
      p3Rot.style.transition = 'none';
      p3Rot.style.transform = 'rotate(0deg)';
      document.querySelectorAll('#s4-panel-3 .s4-p3-upright-lbl').forEach(lbl => {
        lbl.style.transition = 'none';
        lbl.style.transform = 'rotate(0deg)';
      });
      setTimeout(() => {
        p3Rot.style.transition = 'transform 1.35s cubic-bezier(0.34, 1.08, 0.64, 1)';
        document.querySelectorAll('#s4-panel-3 .s4-p3-upright-lbl').forEach(lbl => {
          lbl.style.transition = 'transform 1.35s cubic-bezier(0.34, 1.08, 0.64, 1)';
        });
      }, 40);
    }
    renderSlide4Summary();
  }

  function triggerSlide4FinalRotation() {
    const rotShape = document.getElementById('s4-final-rot-shape');
    if (!rotShape) return;
    rotShape.style.transition = 'none';
    rotShape.style.transform = 'rotate(0deg)';
    setTimeout(() => {
      rotShape.style.transition = 'transform 1.25s cubic-bezier(0.34, 1.15, 0.64, 1)';
      rotShape.style.transform = 'rotate(180deg)';
    }, 80);
  }

  function renderSlide4Summary() {
    clearSlide4Timers();
    const s = slideSteps[3];
    const maxS = MAX_STEPS_PER_SLIDE[3];

    // Xác định đang ở Phần mấy (1, 2, 3, 4 hay 5 - Khung kết thúc)
    let activePart = 1;
    if (s >= 7 && s <= 11) activePart = 2;
    else if (s >= 12 && s <= 15) activePart = 3;
    else if (s >= 16 && s <= 18) activePart = 4;
    else if (s >= 19) activePart = 5;

    // Cập nhật chỉ báo tiến trình Bước 1/4, 2/4, 3/4, 4/4
    const majorPill = document.getElementById('s4-major-step-pill');
    if (majorPill) {
      majorPill.textContent = activePart <= 4 ? `Bước ${activePart} / 4` : 'Tổng kết cuối bài';
    }

    const partDoneThresholds = [5, 11, 15, 18];
    for (let i = 1; i <= 4; i++) {
      const tab = document.getElementById(`s4-part-tab-${i}`);
      if (!tab) continue;
      tab.classList.toggle('active-part', activePart === i);
      tab.classList.toggle('done-part', s >= partDoneThresholds[i - 1] && activePart !== i);
    }

    // Hiển thị đúng Panel của phần hiện tại
    for (let i = 1; i <= 5; i++) {
      const panel = document.getElementById(`s4-panel-${i}`);
      if (panel) panel.classList.toggle('active-panel', activePart === i);
    }

    // Nút điều khiển dưới chân Slide 4 (Tạm khóa nút Bước tiếp khi animation Phần 1 đang chạy)
    const btnPrev = document.getElementById('s4-btn-prev');
    const btnNext = document.getElementById('s4-btn-next');
    const guideText = document.getElementById('s4-footer-guide-text');
    if (btnPrev) btnPrev.disabled = (s === 0);
    if (btnNext) {
      btnNext.disabled = (s === maxS) || s4P1IsAnimating;
      btnNext.textContent = (s === 18) ? '⭐ Xem ghi nhớ cuối bài ⏭' : (s === maxS ? '✓ Đã hoàn thành bài học' : 'Bước tiếp ⏭');
    }

    // -------------------- RENDER CHI TIẾT BƯỚC 1 (s = 0..5) --------------------
    for (let idx = 1; idx <= 5; idx++) {
      const card = document.getElementById(`s4-p1-card-${idx}`);
      // Nếu hình idx đang trong quá trình phóng to ở giữa và bay về ô, tạm ẩn ô đích cho tới khi bay xong
      const isShown = (s >= idx) && (s4P1AnimatingIdx !== idx);
      if (card) {
        card.classList.toggle('shown-card', isShown);
        card.classList.toggle('info-visible', isShown);
        card.classList.toggle('current-focus', s === idx && isShown);
      }
      const dA = document.getElementById(`s4-p1-d${idx}a`);
      const dB = document.getElementById(`s4-p1-d${idx}b`);
      const dC = document.getElementById(`s4-p1-d${idx}c`);
      const oGrp = document.getElementById(`s4-p1-o${idx}`);

      if (!isShown) {
        if (dA) dA.classList.remove('drawn');
        if (dB) dB.classList.remove('drawn');
        if (dC) dC.classList.remove('drawn');
        if (oGrp) oGrp.classList.remove('shown');
      } else {
        if (dA) dA.classList.add('drawn');
        if (dB) dB.classList.add('drawn');
        if (dC) dC.classList.add('drawn');
        if (oGrp) oGrp.classList.add('shown');
      }
    }
    const sqNote = document.getElementById('s4-p1-square-note');
    if (sqNote) sqNote.classList.remove('shown');

    // -------------------- RENDER CHI TIẾT BƯỚC 2 (s = 7..11) --------------------
    const p2Base = document.getElementById('s4-p2-base-shape');
    const p2Rot = document.getElementById('s4-p2-rot-group');
    const p2LblA = document.getElementById('s4-p2-label-a');
    const p2LblAp = document.getElementById('s4-p2-label-ap');
    const p2LeftBadge = document.getElementById('s4-p2-left-badge');
    const p2LeftText = document.getElementById('s4-p2-left-text');
    const p2RightBadge = document.getElementById('s4-p2-right-badge');
    const p2RightText = document.getElementById('s4-p2-right-text');
    const p2PointO = document.getElementById('s4-p2-point-o');
    const p2AngleTag = document.getElementById('s4-p2-angle-tag');

    if (p2Base) p2Base.style.opacity = (s >= 9) ? '1' : '0';
    if (p2Rot) {
      p2Rot.style.opacity = (s >= 8) ? '1' : '0';
      p2Rot.style.transform = (s >= 9) ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    if (p2LblA) p2LblA.style.opacity = (s >= 8) ? '1' : '0';
    if (p2LblAp) p2LblAp.style.opacity = (s >= 8) ? '1' : '0';

    // Khi quay 180° (s >= 9): Điểm A đã chuyển sang vị trí A' bên phải, và điểm A' chuyển sang vị trí A bên trái
    if (p2LeftBadge && p2LeftText && p2RightBadge && p2RightText) {
      if (s >= 9) {
        p2LeftBadge.setAttribute('fill', '#0284c7');
        p2LeftText.textContent = "A'";
        p2RightBadge.setAttribute('fill', '#dc2626');
        p2RightText.textContent = 'A';
      } else {
        p2LeftBadge.setAttribute('fill', '#dc2626');
        p2LeftText.textContent = 'A';
        p2RightBadge.setAttribute('fill', '#0284c7');
        p2RightText.textContent = "A'";
      }
    }

    if (p2PointO) p2PointO.classList.toggle('zoom-pulse-o', s === 7 || s === 11);
    if (p2AngleTag) {
      if (s === 7) p2AngleTag.textContent = 'Trạng thái: Quan sát tâm O và chiều quay';
      else if (s === 8) p2AngleTag.textContent = 'Nhấp 1: Hiện đoạn thẳng AA\' đi qua tâm O';
      else if (s === 9) p2AngleTag.textContent = 'Nhấp 2: Quay 180° quanh O (A ↔ A\')';
      else p2AngleTag.textContent = 'Nhấp 3: Hai điểm đổi chỗ & hình trùng khít vị trí ban đầu';
    }

    document.getElementById('s4-p2-b1')?.classList.toggle('shown', s >= 8);
    document.getElementById('s4-p2-b2')?.classList.toggle('shown', s >= 9);
    document.getElementById('s4-p2-b3')?.classList.toggle('shown', s >= 10);
    document.getElementById('s4-p2-def-frame')?.classList.toggle('shown', s >= 11);

    // -------------------- RENDER CHI TIẾT BƯỚC 3 (s = 12..15) --------------------
    const p3Panel = document.getElementById('s4-panel-3');
    const p3SubStatus = document.getElementById('s4-p3-substatus');
    const p3Ghost = document.getElementById('s4-p3-ghost-poly');
    const p3RotAll = document.getElementById('s4-p3-rot-all');
    const p3FixedO = document.getElementById('s4-p3-fixed-o');
    const p3CoincideBadge = document.getElementById('s4-p3-coincide-badge');
    const p3StepPrompt = document.getElementById('s4-p3-step-prompt');
    const p3Seq1 = document.getElementById('s4-p3-seq-1');
    const p3Seq2 = document.getElementById('s4-p3-seq-2');
    const p3Seq3 = document.getElementById('s4-p3-seq-3');

    if (p3Panel) {
      p3Panel.classList.toggle('p3-minimal-conclusion-mode', s === 15);
    }

    const isP3Rotated = (s >= 13);
    if (p3Ghost) {
      p3Ghost.style.opacity = isP3Rotated ? '0.45' : '0';
    }
    if (p3RotAll) {
      p3RotAll.style.transform = isP3Rotated ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    document.querySelectorAll('#s4-panel-3 .s4-p3-upright-lbl').forEach(lbl => {
      lbl.style.transform = isP3Rotated ? 'rotate(-180deg)' : 'rotate(0deg)';
    });
    if (p3FixedO) {
      p3FixedO.classList.toggle('zoom-pulse-o', s === 13 || s === 15);
    }
    if (p3CoincideBadge) {
      p3CoincideBadge.classList.toggle('visible', s === 14);
    }

    if (p3Seq1) p3Seq1.classList.remove('shown');
    if (p3Seq2) p3Seq2.classList.remove('shown');
    if (p3Seq3) p3Seq3.classList.remove('shown');

    if (s === 12) {
      if (p3SubStatus) p3SubStatus.textContent = 'Bước 1: Quan sát hình bình hành ABCD và giao điểm O';
      if (p3StepPrompt) {
        p3StepPrompt.innerHTML = 'Quan sát hình bình hành <b>ABCD</b> có hai đường chéo <b>AC</b> và <b>BD</b> cắt nhau tại <b>O</b>.<br/><br/><span style="color:#ea580c;">Dự đoán:</span> Khi quay hình bình hành <b>180° quanh điểm O</b>, điều gì sẽ xảy ra?';
      }
    } else if (s === 13) {
      if (p3SubStatus) p3SubStatus.textContent = 'Bước 2: Quay 180° quanh điểm O';
      if (p3StepPrompt) {
        p3StepPrompt.innerHTML = 'Toàn bộ hình bình hành quay <b>180° quanh điểm cố định O</b>:<br/>• Đỉnh <b>A</b> đổi chỗ với đỉnh <b>C</b>.<br/>• Đỉnh <b>B</b> đổi chỗ với đỉnh <b>D</b>.<br/>• Điểm <b>O</b> giữ nguyên vị trí.';
      }
    } else if (s === 14) {
      if (p3SubStatus) p3SubStatus.textContent = 'Bước 3: Kiểm chứng sự trùng khít';
      if (p3StepPrompt) {
        p3StepPrompt.innerHTML = 'Sau khi quay <b>180° quanh O</b>, hình thu được <b>chồng khít hoàn toàn</b> với hình ban đầu!';
      }
    } else if (s === 15) {
      // Bước 4: Rút ra kết luận (Xuất hiện tuần tự: Tiêu đề -> Định nghĩa -> 3 cụm từ khóa)
      s4ShapeTimers.push(setTimeout(() => { if (p3Seq1) p3Seq1.classList.add('shown'); }, 60));
      s4ShapeTimers.push(setTimeout(() => { if (p3Seq2) p3Seq2.classList.add('shown'); }, 360));
      s4ShapeTimers.push(setTimeout(() => { if (p3Seq3) p3Seq3.classList.add('shown'); }, 680));
    }

    // -------------------- RENDER CHI TIẾT BƯỚC 4 (s = 16..18) --------------------
    const p4PointO = document.getElementById('s4-p4-point-o');
    if (p4PointO) p4PointO.classList.toggle('zoom-pulse-o', s === 17);
    const p4Ticks = document.getElementById('s4-p4-ticks');
    if (p4Ticks) p4Ticks.style.opacity = (s >= 18) ? '1' : '0';
    const p4DiagText = document.getElementById('s4-p4-diagram-text');
    if (p4DiagText) p4DiagText.style.opacity = (s >= 18) ? '1' : '0';

    document.getElementById('s4-p4-b1')?.classList.toggle('shown', s >= 16);
    document.getElementById('s4-p4-b2')?.classList.toggle('shown', s >= 17);
    document.getElementById('s4-p4-b3')?.classList.toggle('shown', s >= 18);
    const p4Formula = document.getElementById('s4-p4-formula-wrap');
    if (p4Formula) {
      p4Formula.style.opacity = (s >= 18) ? '1' : '0';
      p4Formula.style.transform = (s >= 18) ? 'scale(1)' : 'scale(0.9)';
    }

    // -------------------- RENDER KHUNG KẾT THÚC (s = 19) --------------------
    const finalInner = document.getElementById('s4-final-card-inner');
    if (finalInner) {
      finalInner.classList.toggle('zoom-shown', s >= 19);
    }

    const p1SubStatus = document.getElementById('s4-p1-substatus');
    const shownCount = Math.min(5, s);
    if (p1SubStatus && activePart === 1) {
      p1SubStatus.textContent = (shownCount === 0)
        ? 'Phần 1/4: Đã hiện 0/5 hình có tâm đối xứng'
        : `Đã hiện ${shownCount}/5 hình có tâm đối xứng`;
    }

    if (guideText) {
      if (activePart === 1) {
        guideText.textContent = (shownCount === 0)
          ? 'Phần 1/4: Đã hiện 0/5 hình có tâm đối xứng'
          : `Đã hiện ${shownCount}/5 hình có tâm đối xứng`;
      }
      else if (activePart === 2) guideText.textContent = 'Phần 2/4: Quan sát phép quay 180° và rút ra định nghĩa';
      else if (activePart === 3) guideText.textContent = (s === 15) ? 'Phần 3/4: Kết luận về tâm đối xứng O' : 'Phần 3/4: Quan sát hình bình hành quay 180° quanh điểm O';
      else if (activePart === 4) guideText.textContent = 'Phần 4/4: Tính chất của hai điểm A và A\' đối xứng qua O';
      else guideText.textContent = 'Hoàn thành tổng kết kiến thức bài học Tâm đối xứng!';
    }
  }

  /* --------------------------------------------------------------------------
     7. CÁC CHỨC NĂNG ĐẶC BIỆT TRÊN THANH CÔNG CỤ & BÀN PHÍM
