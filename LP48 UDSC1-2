      fb.innerHTML = '👁 <b>Lời giải:</b> Cánh quạt đối xứng kết thúc tại điểm cách tâm O <b>5 ô ngang sang trái và 2 ô dọc xuống dưới</b> (góc dưới cùng bên trái của lưới).';
    }
    triggerBtlt4SuccessAnimation();
  }

  function resetBtlt4() {
    clearTimeout(btlt4Timer);
    btlt4Candidate = null;
    btlt4Solved = false;
    const marker = document.getElementById('btlt4-cand-marker');
    if (marker) marker.style.display = 'none';
    document.getElementById('btlt4-ans-pt')?.classList.remove('shown');

    const line = document.getElementById('btlt4-line-aa');
    if (line) {
      line.style.opacity = '0';
      line.setAttribute('x2', '648');
      line.setAttribute('y2', '36');
    }

    const outline = document.getElementById('btlt4-ans-outline');
    if (outline) {
      outline.style.transition = 'none';
      outline.style.strokeDashoffset = '820';
      void outline.getBoundingClientRect();
      outline.style.transition = 'stroke-dashoffset 0.9s ease-out';
    }
    const fillPoly = document.getElementById('btlt4-ans-fill');
    if (fillPoly) fillPoly.style.opacity = '0';

    const rotBlade = document.getElementById('btlt4-rot-blade');
    if (rotBlade) {
      rotBlade.style.transition = 'none';
      rotBlade.style.opacity = '0';
      rotBlade.style.transform = 'rotate(0deg)';
    }

    document.getElementById('btlt4-conclusion')?.classList.remove('shown');
    const fb = document.getElementById('btlt4-feedback');
    if (fb) {
      fb.className = 'btlt-feedback-box';
      fb.textContent = '';
    }
    const pill = document.getElementById('btlt4-status-pill');
    if (pill) pill.textContent = 'Dựng cánh quạt đối xứng qua tâm O';
    const topHint = document.getElementById('btlt4-top-hint');
    if (topHint) topHint.textContent = '👉 Nhấp vào giao điểm lưới để chọn vị trí đầu mút của cánh quạt đối xứng, rồi nhấn KIỂM TRA';
