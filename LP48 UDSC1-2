        } else if (this.mode === 'teacher' && this.teacherUser) {
          this.refreshTeacherData();
        }
      });
      window.addEventListener('offline', () => {
        if (this.mode === 'student') this.setStudentConnDot('offline');
        toast('Mất kết nối mạng! Dữ liệu sẽ tự đồng bộ khi có mạng lại.', 'warn');
      });

      window.addEventListener('resize', () => {
        this.rescaleAllPreviews();
      });
