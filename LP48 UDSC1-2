    .s4-shape-item-card.info-visible .s4-shape-card-name {
      opacity: 1;
      transform: translateY(0);
    }

    .s4-shape-card-desc {
      font-size: 13px;
      font-weight: bold;
      color: #0f766e;
      background: #f0fdfa;
      border: 1.5px solid #99f6e4;
      border-radius: 10px;
      padding: 6px 8px;
      width: 100%;
      line-height: 1.35;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.32s ease, transform 0.32s ease;
    }

    .s4-shape-item-card.info-visible .s4-shape-card-desc {
      opacity: 1;
      transform: translateY(0);
    }

    /* Lớp animation độc lập (SVG clone) phóng to ở chính giữa rồi thu nhỏ và bay về ô đích */
    .s4-fly-overlay-layer {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 40;
      overflow: visible;
    }

    .s4-fly-clone-box {
      position: absolute;
      left: 0;
      top: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.96);
      border: 3px solid #ea580c;
      border-radius: 20px;
      box-shadow: 0 18px 42px rgba(15, 41, 66, 0.24);
      transform-origin: center center;
      will-change: transform, opacity;
      pointer-events: none;
    }

    .s4-draw-line {
      stroke-dasharray: 220;
      stroke-dashoffset: 220;
      transition: stroke-dashoffset 0.55s ease-out;
    }

    .s4-draw-line.drawn {
      stroke-dashoffset: 0;
    }

    .s4-square-note-bar {
      background: #fffbeb;
      border: 2px solid #f59e0b;
      border-radius: 12px;
      padding: 8px 18px;
      font-size: 15px;
      font-weight: bold;
      color: #92400e;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      opacity: 0;
      transform: translateY(6px);
      transition: all 0.35s ease;
    }

    .s4-square-note-bar.shown {
      opacity: 1;
      transform: translateY(0);
    }

    /* BƯỚC 2, 3, 4: Bố cục 2 cột Trái (SVG trực quan) - Phải (Kiến thức từng bước) */
    .s4-two-col-body {
      flex: 1;
      display: grid;
      grid-template-columns: 0.95fr 1.25fr;
      gap: 20px;
      min-height: 0;
      align-items: stretch;
    }

    .s4-svg-box {
      background: #ffffff;
      border: 2.5px solid #cbd5e1;
      border-radius: 18px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    }

    .s4-right-info-col {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 12px;
    }

    .s4-step-bullet-card {
      background: #ffffff;
      border: 2.5px solid #cbd5e1;
