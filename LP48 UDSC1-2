                <circle cx="70" cy="70" r="56" fill="#fff3b0" stroke="#d97706" stroke-width="3.5" />
                <line x1="70" y1="22" x2="70" y2="118" stroke="#dc2626" stroke-width="7" stroke-linecap="round" />
